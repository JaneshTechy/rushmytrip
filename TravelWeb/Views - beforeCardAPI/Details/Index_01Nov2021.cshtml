                        <script>


                            function BaggagePrice(Pcs, BagPrice, GrandTotal, weight) {
                                $('#spBagname1').text('Check In Luggage');
                                $('#spBagname1x').text('Check In Luggage');
                                // alert(BagPrice +" PCS="+ Pcs);
                                // No checked baggage (Not Included)
                                // 23 kg Checked bag but price 0 THEN (23 kg INCLUED)
                                //  23 kg Checked bag but price geater tHEN  0 (23 kg Inclued)
                                //  23 X 23 kg Checked bag (46 kg Inclued)

                                if (BagPrice === "0") {
                                    // $("#spBaggagePrice").html("FREE");

                                    $("#hdnBaggagePrice").val(BagPrice);
                                    $("#hdnBaggagePcs").val(Pcs);
                                }
                                else {

                                    $("#hdnBaggagePrice").val(BagPrice);
                                    $("#hdnBaggagePcs").val(Pcs);
                                }

                                if ((parseInt(BagPrice) == 0) && parseInt(Pcs) == 0) {
                                    $("#spBaggagePrice1").html("Not Included");
                                    $("#spBaggagePrice1x").html("Not Included");
                                }

                                if ((parseInt(BagPrice) >= 0) && parseInt(Pcs) == 1) {
                                    $("#spBaggagePrice1").html(weight + " kg Included");
                                    $("#spBaggagePrice1x").html(weight + " kg Included");
                                }

                                if ((parseInt(BagPrice) >= 0) && parseInt(Pcs) == 2) {
                                    $("#spBaggagePrice1").html((parseInt(weight) * 2) + " kg Included");
                                    $("#spBaggagePrice1x").html((parseInt(weight) * 2) + " kg Included");
                                }
                                if ($("#spBaggagePrice1x").text().trim() == '') {

                                    $("#spBaggagePrice1x").html("No Baggage Available");
                                }
                                $('#sptotBagPricex').text(BagPrice);
                                getTotalCost();
                            }
                            $(document).ready(function () {

                                $(".baggage").click(function () {
                                    $(".baggage").removeClass("baggage-select");
                                    $(this).addClass("baggage-select");
                                });
                                if ($("#spBaggagePrice1").text().trim() == '') {

                                    $("#spBaggagePrice1").html("No Baggage Available");
                                    $("#spBaggagePrice1x").html("No Baggage Available");
                                }
                                getTotalCost();
                            });

                            $(document).ready(function () {

                                $('#spBaggagePrice').text($('#hdnhand_weight').val() + 'kg Per Person');
                                $('#spBagname').text('Cabin Bag');

                                $('#spBaggagePricex').text($('#hdnhand_weight').val() + 'kg Per Person');
                                $('#spBagnamex').text('Cabin Bag');

                                if ($('#baggage_0').prop("checked") == true) {
                                    $('#spBagname1').text('Check In Luggage');
                                    $("#spBaggagePrice1").html("Not Included");
                                    $('#sptotBagPrice').text('0');


                                    $('#spBagname1x').text('Check In Luggage');
                                    $("#spBaggagePrice1x").html("Not Included");
                                    $('#sptotBagPricex').text('0');
                                }
                                if ($('#baggage_1').prop("checked") == true) {
                                    $('#spBagname1').text('Check In Luggage');
                                    $("#spBaggagePrice1").html($('#hdnhold_weight').val() + " kg Included");

                                    $('#spBagname1x').text('Check In Luggage');
                                    $("#spBaggagePrice1x").html($('#hdnhold_weight').val() + " kg Included");

                                }
                                else {
                                    if ($("#spBaggagePrice1").text().trim() == '') {

                                        $("#spBaggagePrice1").html("No Baggage Available");
                                        $("#spBaggagePrice1x").html("No Baggage Available");
                                    }

                                }
                                if ($("#spBaggagePrice1").text().trim() == '') {

                                    $("#spBaggagePrice1").html("No Baggage Available");
                                    $("#spBaggagePrice1x").html("No Baggage Available");
                                }
                                getTotalCost();

                            });

                            function getTotalCost() {

                                // alert($('#spTotalCostAmount').text().trim());
                                var MainTotalCost = parseInt($('#hdnspTotalCostAmount').val().trim());
                                MainTotalCost = MainTotalCost + parseInt($('#sptotBagPrice').text()) + parseInt($('#spsuppurtPlanAmt').text());

                                $('.spMainTotalCost').text(MainTotalCost);
                            }
                        </script>
