            $('#txtphone').css({ "border": "" }); lbool = true;
        }
        if ($('#txtEmail').val().trim() == '') {
            $('#txtEmail').css({ "border": "1px solid red" }); lbool = false;
        } else {
            if (!isEmail($("#txtEmail").val())) {
                $("#txtEmail").css({ "border": "1px solid red" }); lbool = false;
