@using TravelWeb.Utilities;

@model Flights;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

 <link href="~/css/detailStyle.css?v=1.00000001" rel="stylesheet" />

<style>
    main_li_summry {
        margin: 0px;
        padding: 0px;
    }

    .main_li_summry li {
        list-style: none;
        float: left;
    }

    .top_smy_des {
        float: left;
        margin-right: 5px;
    }

    .navbar-theme-transparent {
        background: #333;
    }
</style>
<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>
<style>


    .position_absolute {
        position: absolute
    }
</style>
<style>

    .baggage-row {
        border: 3px solid #e6e7e8;
        padding: 12px;
        width: 100%;
        float: left;
        cursor: pointer;
        margin-top: 6px;
        border-radius: 3px;
        -moz-border-radius: 3px;
        -webkit-border-radius: 3px;
    }

        .baggage-row:hover {
            border: rgb(29, 142, 189) 3px solid;
        }

    .baggage-select {
        margin-bottom: 15px;
        border: rgb(29, 142, 189) 3px solid;
        border-radius: 3px;
        -moz-border-radius: 3px;
        -webkit-border-radius: 3px;
        padding: 12px;
    }

    .baggage-row input {
        float: left;
    }

    .baggage-row label {
        float: left;
        width: 94%;
        line-height: 26px;
        margin-bottom: 0px;
    }

    .baggage-name {
        float: left;
        color: #333;
        width: 45%;
        cursor: pointer;
    }

    .baggage-size {
        float: left;
        color: #333;
        font-weight: normal;
        cursor: pointer;
    }

    .baggage-price {
        float: right;
        color: #000;
        text-align: right;
        cursor: pointer;
    }

    .chargeOn {
        float: right;
        line-height: 24px !important;
        color: #000 !important;
        font-weight: bold !important;
        margin: 20px 0 6px 0;
    }

    .freeChanges {
        width: 100%;
        float: left;
    }

        .freeChanges p {
            clear: both;
            margin: 0px;
            font-size: 14px;
        }

    .tolalPrice {
        font-weight: bold;
        font-size: 16px;
    }
</style>

<div class="theme-page-section theme-page-section-lg detailPage detail-mob-space">
