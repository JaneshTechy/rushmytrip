                                                                    TimeSpan t = TimeSpan.FromMinutes(Convert.ToInt32(onb.TotalTime));
                                                                    dephrscalc = string.Format("{0:D2}h {1:D2}m", t.Hours, t.Minutes);
                                                                    depstop++;
                                                                }
