         var outDepVal1 = outDepVal;
        if (outDepVal.split(':')[0] == outDepVal.split(':')[1]) {
            outDepVal = outDepVal.split(':')[0] + ":" + parseInt(outDepVal.split(':')[0]) + 1;
        }
            var outdep = outDepVal.split(':');
        noUiSlider.create(outboundDepature_slider_range, {
