    function SetPriceRange() {
        var slider_range = document.getElementById('slider-range');
        noUiSlider.create(slider_range, {
            start: [parseInt($("#hdnMinPrice").val()), parseInt($("#hdnMaxPrice").val())],
            connect: true,
            range: {
                'min': parseInt($("#hdnMinPrice").val()),
                'max': parseInt($("#hdnMaxPrice").val())
            }

        });
        slider_range.noUiSlider.on('change', function (values, handle) {
            jQuery('#amount').val("$" + parseInt(values[0]) + " - $" + parseInt(values[1]));
            $("#hdnMinPrice").val(parseInt(values[0]));
            $("#hdnMaxPrice").val(parseInt(values[1]));
            filterResult();
        });
    }
    function SetOutBoundDep() {
        var outboundDepature_slider_range = document.getElementById('outboundDepature-slider-range');
