                    <style>
                        .ViewSummury table {
                            border-collapse: collapse;
                        }

                        .ViewSummury table, td, th {
                            border: 1px solid black;
                        }
                    </style>
                    @{

                        string str = TempData.Peek("summurycount").ToString();
                    }
                    @*<sapn style="cursor:pointer;color:#fff" onclick="ViewSummury(@(str));"> view</sapn>*@
                    @{TempData.Keep("summurycount");}
                    <div class="ViewSummury" id="dvView@(str)" style="display:none;">
                        <table width="300px" style="text-align:center;">
                            <tr>
                                <th colspan="2"><b> Outbound : </b> @items.Outbound[0].FareClasses</th>
                                <th colspan="3">
                                    <b> Inbound : </b>
                                    @if (@items.Inbound.Count > 0)
                                    {
                                        @items.Inbound[0].FareClasses
                                    }

                                </th>

                            </tr>
                            <tr>
                                <th>Pax</th>
                                <th style="text-align:center;"> Fare</th>
                                <th style="text-align:center;">Tax</th>
                                <th style="text-align:center;">Markup</th>
                                <th style="text-align:center;">Total</th>

                            </tr>
                            @{ int sum = 0;}
                            @if (items.FlightFare.Adult > 0)
                            {
                                sum = sum + Convert.ToInt32(items.FlightFare.Adult * ((items.FlightFare.AdultFare) + (items.FlightFare.AdultTax) + (items.FlightFare.AdultMarkup)));
                                <tr>
                                    <td style="text-align:left;">@items.FlightFare.Adult  Adult </td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.AdultFare))</td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.AdultTax))</td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.AdultMarkup))</td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.Adult*((items.FlightFare.AdultFare)+ (items.FlightFare.AdultTax)+ (items.FlightFare.AdultMarkup)))) </td>
                                </tr>
                            }


                            @if (items.FlightFare.Child > 0)
                            {
                                sum = sum + Convert.ToInt32(items.FlightFare.Child * ((items.FlightFare.ChildFare) + (items.FlightFare.ChildTax) + (items.FlightFare.ChildMarkup)));
                                <tr>
                                    <td style="text-align:left;">   @Convert.ToInt32(items.FlightFare.Child) Child </td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.ChildFare))</td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.ChildTax))</td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.ChildMarkup))</td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.Child * ((items.FlightFare.ChildFare) + (items.FlightFare.ChildTax) + (items.FlightFare.ChildMarkup)))) </td>
                                </tr>
                            }

                            @if (items.FlightFare.Infant > 0)
                            {
                                sum = sum + Convert.ToInt32(items.FlightFare.Infant * ((items.FlightFare.InfantFare) + (items.FlightFare.InfantTax) + (items.FlightFare.InfantMarkup)));

                                <tr>
                                    <td style="text-align:left;">   @Convert.ToInt32(items.FlightFare.Infant)  Infant </td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.InfantFare))</td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.InfantTax))</td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.InfantMarkup))</td>
                                    <td style="text-align:center;">@(Convert.ToInt32(items.FlightFare.Infant * ((items.FlightFare.InfantFare) + (items.FlightFare.InfantTax) + (items.FlightFare.InfantMarkup)))) </td>
                                </tr>
                            }

                            <tr>
                                <td colspan="4" style="text-align:right;">Total : </td>
                                <td style="text-align:center;">@(sum) </td>
                            </tr>

                        </table>

                    </div>

                </div>
        </form>
    }
