<style>
    .best-price-div {
        background: #fba406;
        float: left;
        margin-bottom: 50px;
        width: 100%;
        margin-top: -218px;
        position: absolute;
        z-index: 100;
    }

    @@media (min-width: 1200px) {
        .container {
            width: 1210px;
        }
    }

    .best_price {
        font-size: 20px;
        padding-top: 0;
        font-weight: 600;
        margin-bottom: 2px;
        margin-top: 15px;
    }

    .sub_con {
        position: relative;
        font-size: 90%;
        line-height: 0;
        vertical-align: baseline;
        z-index: 99;
        cursor: pointer;
    }

    .infomation_con {
        display: none;
        position: absolute;
        left: -227px;
        top: 32px;
        width: 450px;
        background: #f8f8f8;
        font-family: Montserrat;
        line-height: 16px;
        color: #333;
        padding: 8px 15px 8px 15px;
        font-size: 13px;
        line-height: 16px;
        border-radius: 4px;
        border: 2px solid #a31c20;
        z-index: 988;
       /* box-shadow: 1px 3px 4px rgba(0 0 0 / 40%);*/
    }

    .best-price-div img {
        float: left;
        margin-top: -23px;
        width: 120px;
        margin-bottom: -41px;
        margin-right: 30px;
    }

    .trustbutton-main-div {
        width: 100%;
        margin-top: 0;
        background-color: #e6f6fe;
        box-shadow: 5px 5px 9px #dcddde;
        padding: 0;
        float: left;
    }

    .trustbutton-div {
        width: 72%;
        margin: 0 auto;
    }

    .best-price-img, .easy-booking-img, .customer-care-img, .fb-like-img {
        width: auto;
        height: 50px;
    }

    .best-price-txt-div {
        width: 100%;
        margin-top: 10px;
    }

    .border {
        background: url(../img/dividers_vertical.png) 0 0 no-repeat;
        padding-top: 20px;
        padding-bottom: 20px;
        background-size: 3px;
    }

    .main-block, .social-icon {
        transition: transform .6s;
    }

    .easy-booking-div {
        width: 100%;
        margin-top: 10px;
        margin-left: 0%;
    }

    .homePage #hero-search-form {
        background: none !important;
        padding: 0px !important;
        border-radius: 8px;
        /* -webkit-border-radius: 8px; */
        -moz-border-radius: 8px;
        border: 0px !important;
    }

    .homePage .theme-search-area-submit {
        position: absolute;
        top: 0;
        height: 55px;
        right: 1px;
    }

    .theme-search-area-stacked .theme-search-area-submit-curved {
        border-radius: 0 0px 0px 0;
    }

    .featureSection {
        padding: 0em !important;
        margin-bottom: 0;
        position: initial !important;
        width: 100%;
        z-index: 9;
        margin-top: 0px !important;
    }

    @@media (max-width: 767px) {
        .todayDealHome h1 {
            font-size: 30px !important;
        }

        .todayDealHome p {
            font-size: 11px !important;
        }
    }
</style>


