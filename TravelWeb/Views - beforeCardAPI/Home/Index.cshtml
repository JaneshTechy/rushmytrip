    <script>
    $(function () {
        CityTab('JFK');
        $('ul.cityTab li').each(function () {

            $(this).removeClass("active");
        });
        $('#tab_NYC').addClass("active");

    });
    function CityTab(cityname) {
        $('ul.cityTab li').each(function () {

            $(this).removeClass("active");
        });
        $('#tab_' + cityname).addClass("active");

         $.ajax({
            type: "get",
            url: "@(TravelWeb.Utilities.Common.WebSitePath)popular/city",
            data: { "dest": "" + cityname + "" },
            contentType: "application/html; charset=utf-8",
            accepts: "application/html; charset=utf-8",
            //dataType: "json",
            success: function (response) {
            $('#dvpopularCity').html(response);

            }

            });

    }
    </script>
