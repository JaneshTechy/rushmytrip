                        @model PageModel
@{
    var seo = ViewBag.Seo as SeoEntities;
}
@section Metatags {
    <title>@Html.Raw(seo?.MetaTitle ?? "RushMyFlight")</title>
    <meta name="description" content="@seo?.MetaDescription" />
    <meta name="keywords" content="@seo?.MetaKeywords" />
    <meta name="robots" content="@seo?.Robots" />
}
<!-- ✅ Load Tailwind only for this page -->
<script src="https://cdn.tailwindcss.com?plugins=forms,typography" defer></script>
<script src="https://cdn.tailwindcss.com?plugins=typography"></script>
<script>
    tailwind.config = {
        important: "#aboutus-page", // Tailwind applies only inside this div
        darkMode: "class",
        theme: {
            extend: {
                colors: {
                    primary: "#007BFF",
                    "background-light": "#F8F9FA",
                    "background-dark": "#1A202C",
                    "text-light": "#212529",
                    "text-dark": "#E2E8F0",
                    "card-light": "#FFFFFF",
                    "card-dark": "#2D3748",
                },
                fontFamily: {
                    display: ["Roboto", "sans-serif"],
                },
                borderRadius: {
                    DEFAULT: "0.5rem",
                },
            },
        },
    };
</script>

<script>
    $(document).ready(function () {
        setTimeout(function () {
            $("#bkgOverlay").fadeIn();
            $("#delayedPopup").fadeIn();
        }, 20000);
    });
</script>

<style>
    .material-icons {
        font-size: inherit;
        vertical-align: middle;
    }

    body {
        min-height: max(884px, 100dvh);
    }

    /* ✨ Optional subtle fade overlay effect for background */
    #aboutus-bg::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(3px);
        z-index: 0;
    }

    #aboutus-page .shadow-all {
        --tw-shadow: 0 0 25px 5px rgb(0 0 0 / 0.1);
        box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);
    }

    .prose-lg {
        font-size: 1.3rem !important;
        line-height: 1.7777778 !important;
    }
</style>

