<script>

    $(function () {
        getResultPage();

    });
    function setPriceLowToHigh() {

        $("#dvSort li span").removeClass("active");
        $("#dvSort li span:first-child").addClass("active");
    }
    $("#dvSort li span").click(function () {
        $("#dvSort li span").removeClass("active");
        $(this).addClass("active");
    })
    //Edit result btn
    $('#editBtnResult').click(function () {
        $('#hero-search-form').toggle();
    });
    //Filters result
    $('#mobileFilters').click(function () {
        $('#divLeftPanel .sticky-col.customHideClass').toggle();
    });



    $("#drpSorting").change(function () {
        if ($('option:selected', this).text() == "Price (Low to High)") {
            SortByPrice(0, 1);

        }
        else if ($('option:selected', this).text() == "Price (High to Low)") {
            SortByPrice(1, 1);
        }
        else if ($('option:selected', this).text() == "Duration (Low to High)") {
            SortByDuration(0, 1);

        }
        else if ($('option:selected', this).text() == "Duration (High to Low)") {
            SortByDuration(1, 1);
        }
        else if ($('option:selected', this).text() == "Airline (A-Z)") {
            SortByAirlineName(0, 1);
        }
        else if ($('option:selected', this).text() == "Airline (Z-A)") {
            SortByAirlineName(1, 1);
        }
    });

</script>

<script>
    function getResultPage() {
        $('#loadmore').hide();
        $('#hdnPageIndex').val("0");
         $.ajax({
             type: "get",
             beforeSend: function () {
                 $("#myModal").modal({
                     backdrop: 'static',
                     keyboard: false
                 });
             },
            url: "@(TravelWeb.Utilities.Common.WebSitePath)Result/search",
             data: {"qs": "@(ViewBag.QS)"},
            contentType: "application/html; charset=utf-8",
            accepts: "application/html; charset=utf-8",
              //dataType: "json",
            success: function (response) {
                $('#divLeftPanel').html(response);

                FirstloadResult();
                $('#myModal').modal('hide');
                //  $('#dialog').dialog('open');
            },
            failure: function (response) {
                //alert(response.responseText);
                alert("Sorry! no flight found");
            },
            error: function (response) {
                //alert(response.responseText);
                alert("Sorry! No flight found");
             },
             complete: function () {
                 $('#myModal').modal('hide');
             },

        });
    }

    function SortByAirlineName(vl,chk) {



        if (parseInt($('#hdnSorByAirlineName').val()) == 0) {
            $('#hdnSorByAirlineName').val("1");
        }
        else {
            $('#hdnSorByAirlineName').val("0");
        }
        if (chk == 1 && vl == 0) {

            $('#hdnSorByAirlineName').val("0");

        }
        else if (chk == 1 && vl == 1) {
            $('#hdnSorByAirlineName').val("1");
        }

        $('#hdnSortResult').val("airline");
        $('#hdnPageIndex').val("0");
        filterResult();
        setPriceLowToHigh();
    }
    function SortByPrice(vl,chk) {

        if (parseInt($('#hdnSorPrice').val()) == 0) {
            $('#hdnSorPrice').val("1");
            $("#sppricelow").removeClass("active");
            $("#sppricehigh").addClass("active");

        }

        else {
            $('#hdnSorPrice').val("0");
            $("#sppricehigh").removeClass("active");
            $("#sppricelow").addClass("active");
        }


        if (chk == 1 && vl == 0) {

            $('#hdnSorPrice').val("0");

        }
        else if (chk == 1 && vl == 1) {
            $('#hdnSorPrice').val("1");
        }
        $('#hdnSortResult').val("price");
        $('#hdnPageIndex').val("0");
        filterResult();
        //setPriceLowToHigh();
    }
    function myFunction() {
        var x = document.getElementById("div2");
        if (x.style.display === "none") {
            x.style.display = "block";
        } else {
            x.style.display = "none";
        }

    }
    function SortByDuration(vl,chk) {

        if (parseInt($('#hdnSortDuration').val()) == 0) {
            $('#hdnSortDuration').val("1");
        }
        else {
            $('#hdnSortDuration').val("0");
        }


        if (chk == 1 && vl == 0) {

            $('#hdnSortDuration').val("0");

        }
        else if (chk == 1 && vl == 1) {
            $('#hdnSortDuration').val("1");
        }


        $('#hdnSortResult').val("durarion");
        $('#hdnPageIndex').val("0");
        filterResult();
        setPriceLowToHigh();
    }




    function FirstloadResult() {
        loadResult(",", ",");
        $('.stopscheckbox').click(function () {
            //if (parseInt($('#hdnSorPrice').val()) == 0) {
            //    $('#hdnSorPrice').val("1");
            //}
            //else {
            //    $('#hdnSorPrice').val("0");
            //}
            $('#hdnSorPrice').val("0");
            $('#hdnSortResult').val("price");
            filterResult();
            setPriceLowToHigh();
        });

        $('.chkAirlinelist').click(function () {
           $('#hdnSorPrice').val("0");
            $('#hdnSortResult').val("price");
            $('#hdnPageIndex').val("0");
         filterResult();
            setPriceLowToHigh();
        });
    }

    function filterResult() {

        var stopsx = '';
        $('.stopscheckbox').each(function (i, items) {
            if ($(this).prop('checked')) {
                stopsx += $(items).val() + ',';
            }

        });
        //alert(stopsx);
        var airlinesx = '';
        $('.chkAirlinelist').each(function (i, items) {
            if ($(this).prop('checked')) {
                airlinesx += $(items).val() + ',';
            }

        });
        loadResult(stopsx, airlinesx);
    }


   function loadResult(stopsx,airlinesx) {

 if ((typeof (airlinesx) == "undefined" || airlinesx == ''))
        {
            airlinesx = ',';

        }
       if ((typeof (stopsx) == "undefined" || stopsx == ''))
        {
            stopsx = ',';

        }
        $('#hdnstopsx').val(stopsx);
        $('#hdnairlinesx').val(airlinesx);
        var cnt = parseInt(parseInt($("#hdnAirlineCnt").val())/3);
        var pageindex = 0;
        //var PageSize = 5;
        var PageSize = 20;
         $.ajax({
             type: "get",
             beforeSend: function () {
