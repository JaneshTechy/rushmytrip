             data: { "Stopsx": "" + $('#hdnstopsx').val() + "", "Airlinex": "" + $('#hdnairlinesx').val() + "", "MinPrice": "" + $('#hdnMinPrice').val() + "", "MaxPrice": "" + $('#hdnMaxPrice').val() + "", "SortPrice": "" + $('#hdnSorPrice').val() + "", "SortDuration": "" + $('#hdnSortDuration').val() + "", "SorByAirlineName": "" + $('#hdnSorByAirlineName').val() + "", "SortResult": "" + $('#hdnSortResult').val() + "", "Pageindex": "" + pageindex + "", "PageSize": "" + PageSize + "", "OutDep": "" + $('#hdnoutboundDep').val() + "", "OutArr": "" + $('#hdnoutboundArr').val() + "", "InnDep": "" + $('#hdninboundDep').val() + "", "InnArr": "" + $('#hdninboundArr').val() + "" },
            contentType: "application/html; charset=utf-8",
            accepts: "application/html; charset=utf-8",
              //dataType: "json",
            success: function (response) {
                $('#dvResult').html(response);
                $('#myModal').modal('hide');
                $('#dvMainResultView').show();
                $('#dvHeight').hide();

                //var counterlooppaging = parseInt($('#hdnResultCount').val()) / PageSize;
                //$('#hdncounterlooppaging').val(counterlooppaging);
                LoadMore(counterlooppaging);
                //LoadMoreFlight();
                //  $('#dialog').dialog('open');
            },
            failure: function (response) {
               // alert(response.responseText);
            },
            error: function (response) {
               // alert(response.responseText);
             },

        });
       }



</script>

<script>

