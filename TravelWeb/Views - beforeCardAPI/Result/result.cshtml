<script>
    var inactivityTime = function () {
        var time;
        window.onload = resetTimer;
        // DOM Events
        document.onmousemove = resetTimer;
        document.onkeydown = resetTimer;
        document.onmousedown = resetTimer; // touchscreen presses
        document.ontouchstart = resetTimer;
        document.onclick = resetTimer;     // touchpad clicks
        document.onkeydown = resetTimer;   // onkeypress is deprectaed
        document.addEventListener('scroll', resetTimer, true);
        function logout() {
           // SendEmailtoBusiness();
            //alert("OOPS! Seems like your session expired please search again.")
            //if (!alert('OOPS! Seems like your session expired please search again.')) { window.location.href = "@ViewBag.BackToResult"; }
            $('#divSessionOut').show();
           // alert("OOPS! Seems like your session expired please search again.")
            //window.location.href = "@ViewBag.BackToResult";

        }

        function resetTimer() {
            clearTimeout(time);
            //time = setTimeout(logout, 2000)
            time = setTimeout(logout, 120000)
            // 1000 milliseconds = 1 second
        }
    };


