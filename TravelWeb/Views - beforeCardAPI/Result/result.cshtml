<div id="myModal" class="modal fade modal-dialog-centered">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="row">
                    <div class="col-4 col-md-4 col-sm-4 col-xs-4">
                        @*<img src="img/logo.png" alt="logo" class="img-responsive" />*@
                    </div>
                    <div class="col-4 col-md-4 col-sm-4 col-xs-12">
                        <img src="img/Flights Hall (1).png" alt="logo" class="img-responsive center-block" />
                        @*<img src="img/logo.png" alt="logo" class="img-responsive" />*@
                    </div>
                    <div class="col-4 col-md-4 col-sm-4 col-xs-4">
                        @*<img src="img/logo.png" alt="logo" class="img-responsive" />*@
                    </div>
                </div>
            </div>
            <div class="modal-body" style="text-align:center">
                <div class="plsWaitCaption">
                    <p>Please Wait For Your Flights...</p>
                    <p>Let us search the best Flight Deals For You.</p>
                </div>
                <h2>
                    @(ViewBag.DepCode)&nbsp;
                    <img src="./img/airline/aeroplane.gif" />&nbsp;
                    @(ViewBag.DestCode)
                </h2>

            </div>
            <div class="modal-footer">
                <div class="diparCaptionBox">
                    <div class="row">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-6" id="diparBox">
                            <strong>Departure Date</strong>
                            <p style="color:white">@(Convert.ToDateTime(ViewBag.DepartDate).ToString("dd-MMM-yyyy"))</p>
                        </div>

                        @if (ViewBag.RoundTrip.ToString() == "2")
                        {

                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-6" id="diparBox">
                            <strong>Return Date</strong>
                            <p style="color:white">@(Convert.ToDateTime(ViewBag.ReturnDate).ToString("dd-MMM-yyyy"))</p>
                        </div>
                        }
                        else
                        {

                        <text>One Way</text>
