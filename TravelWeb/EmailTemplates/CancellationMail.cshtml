                                            @foreach (var item in Model.InBoundFlights)
                                            {
                                                @* int InBoundStop = (Model?.InBoundFlights?.Count ?? 0) - 1;

                                                TimeSpan time = XmlConvert.ToTimeSpan(item?.ElapsedTime ?? "PT0H0M");
                                                string journeyTimeIn = $"{(int)time.TotalHours}h {time.Minutes}m"; *@

                                                <!-- Flight Body -->
                                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                    <tr>
                                                        <td style="padding:18px 18px 14px;">
                                                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                                <tr>
                                                                    <td width="30%" style="text-align:left;">
                                                                        <div style="font-size:28px;font-weight:700;color:#1a3a2a;">
                                                                            @(item?.FromAirport?.CityCode ?? "")
                                                                        </div>
                                                                        <div style="font-size:11px;color:#999;margin-top:2px;">
                                                                            @(item?.FromAirport?.CityName ?? "")
                                                                        </div>
                                                                        <div style="font-size:13px;font-weight:600;color:#2d6a4f;margin-top:6px;">
                                                                            @(item?.DepartureDate != null ? item.DepartureDate.ToString("hh:mm tt") : "")
                                                                        </div>
                                                                        <div style="font-size:11px;color:#718096;">
                                                                            @(item?.DepartureDate != null ? item.DepartureDate.ToString("ddd,MMM dd") : "")
                                                                        </div>
                                                                    </td>
                                                                    <td width="40%" style="text-align:center;padding:0 10px;">
                                                                       @*  <div style="font-size:10px;color:#999;text-transform:uppercase;letter-spacing:0.5px;">
                                                                            @if (InBoundStop == 0)
                                                                            {
                                                                                <span>Non-Stop</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span>@InBoundStop Stop</span>
                                                                            }
                                                                        </div> *@
                                                                        @* <div style="font-size:11px;color:#2d6a4f;font-weight:600;">
                                                                            @journeyTimeIn
                                                                        </div> *@
                                                                        <div style="margin-top:8px;background:#fff;border:1px solid #e2e8f0;border-radius:6px;padding:3px 8px 6px;display:inline-block;line-height: 1;">
                                                                            <span style="font-size:11px;color:#4a5568;font-weight:600;">
                                                                                @(item?.Airline?.Code ?? "")-@(item?.FlightNo ?? "")
                                                                            </span>
                                                                        </div>
                                                                        <div style="font-size:11px;color:#999;margin-top:4px;">
