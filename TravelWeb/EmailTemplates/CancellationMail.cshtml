                                            <tr>
                                                <td width="28" valign="top">
                                                    <i class="fa-solid fa-credit-card" style="color: #2782AF;"></i>
                                                </td>
                                                <td style="padding-left:10px;">
                                                    <div style="font-size:14px;font-weight:600;color:#2782AF;">Refund Processing</div>
                                                    <div style="font-size:13px;color:#777;margin-top:5px; line-height: 1.6;">
                                                        If eligible, refunds are processed to your original payment method (Card ending
                                                        @{
                                                            var card = Model?.FlightBooking?.CardNumber;

                                                            string result = (!string.IsNullOrEmpty(card) && card.Length >= 4)
                                                            ? card.Substring(card.Length - 4)
                                                            : "XXXX";
                                                        }
                                                        •••• @result within 7–10 business days.
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:0 0 12px;">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                               style="background:#F4FFFC;border-left:3px solid #27AF8F;border-radius:0 8px 8px 0;padding:12px 16px;">
                                            <tr>
                                                <td width="28" valign="top">
                                                    <i class="fa-solid fa-envelope" style="color:#27AF8F;"></i>
                                                </td>
                                                <td style="padding-left:10px;">
                                                    <div style="font-size:14px;font-weight:600;color:#27AF8F;">Confirmation Email</div>
                                                    <div style="font-size:13px;color:#777;margin-top:5px; line-height: 1.6;">A cancellation confirmation has been sent to your registered email address.</div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
