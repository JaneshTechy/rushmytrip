                    <!-- ═══ PASSENGER & REFUND ═══ -->
                    <tr>
                        <td style="padding:15px 40px 0;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

                                <tr>
                                    <td width="48%" valign="top">
                                        <h3 style="margin:0 0 12px;font-size:13px;font-weight:700;color:#2d6a4f;text-transform:uppercase;letter-spacing:1px;">Passenger</h3>
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                               style="background:#f8fffe;border:1px solid #c8e6d4;border-radius:8px;">
                                            @if (Model?.BookingPaxDetail != null)
                                            {
                                                foreach (var item in Model.BookingPaxDetail)
                                                {
                                                    var firstInitial = item?.FirstName != null && item.FirstName.Length > 0
                                                    ? item.FirstName[0].ToString()
                                                    : "";

                                                    var lastInitial = item?.LastName != null && item.LastName.Length > 0
                                                    ? item.LastName[0].ToString()
                                                    : "";

                                                    var initials = (firstInitial + lastInitial);

                                                    <tr>
                                                        <td style="padding:14px 16px;">
                                                            <div style="display:inline-block;width:32px;height:32px;background:#2d6a4f;border-radius:50%;text-align:center;line-height:32px;color:#fff;font-weight:700;font-size:13px;margin-bottom:8px;">
                                                                @(initials?.ToUpper() ?? "")
                                                            </div>
                                                            <div style="font-size:14px;font-weight:700;color:#2d6a4f;">
                                                                @(item?.FirstName ?? "") @(item?.LastName ?? "")
                                                            </div>
                                                            <div style="font-size:12px;color:#999;margin-top:2px;">
                                                                @(item?.PaxType ?? "") • @(item?.PaxTitle ?? "")
                                                            </div>
                                                            <div style="margin-top:10px;padding-top:10px;border-top:1px solid #e2e8f0;">
                                                                <span style="font-size:11px;color:#888;">Ticket Status</span><br />
                                                                <span style="font-size:12px;font-weight:600;color:#c0392b;">Cancelled</span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </table>
                                    </td>
                                    <td width="4%"></td>
                                    <!-- Refund Summary -->
                                    <td width="48%" valign="top">
                                        <h3 style="margin:0 0 12px;font-size:13px;font-weight:700;color:#2d6a4f;text-transform:uppercase;letter-spacing:1px;">Summary</h3>
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                               style="background:#f8fffe;border:1px solid #c8e6d4;border-radius:8px;">
                                            <tr>
                                                @{
                                                    var booking = Model?.FlightBooking;

                                                    decimal adultTotal = (booking?.AdultFare ?? 0) * (booking?.Adult ?? 0);
                                                    decimal childTotal = (booking?.ChildFare ?? 0) * (booking?.Child ?? 0);
                                                    decimal infantTotal = (booking?.InfantFare ?? 0) * (booking?.Infant ?? 0);

                                                    decimal totalBaseFare = adultTotal + childTotal + infantTotal;

                                                    decimal adultTotalTax = (booking?.AdutlTax ?? 0) * (booking?.Adult ?? 0);
                                                    decimal childTotalTax = (booking?.ChildTax ?? 0) * (booking?.Child ?? 0);
                                                    decimal infantTotalTax = (booking?.InfantTax ?? 0) * (booking?.Infant ?? 0);

                                                    decimal totalTax = adultTotalTax + childTotalTax + infantTotalTax;

                                                    decimal payable = totalBaseFare + totalTax;
                                                }
                                                <td style="padding:14px 16px;">
                                                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                        <tr>
                                                            <td style="font-size:12px;color:#888;padding-bottom:8px;">Base Fare</td>
                                                            <td style="font-size:12px;color:#888;text-align:right;padding-bottom:8px;">$@totalBaseFare </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:12px;color:#888;padding-bottom:8px;">Taxes &amp; Fees</td>
                                                            <td style="font-size:12px;color:#888;text-align:right;padding-bottom:8px;">$ @totalTax</td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="2" style="border-top:1px dashed #c8e6d4;padding-top:8px;"></td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-size:13px;font-weight:700;color:#2d6a4f;">Amount Paid</td>
                                                            <td style="font-size:13px;font-weight:700;color:#2d6a4f;text-align:right;">$@payable</td>
                                                        </tr>
                                                    </table>
                                                    <div style="margin-top:12px;background:#fff3cd;border:1px solid #ffc107;border-radius:6px;padding:8px 10px;">
                                                        <span style="font-size:11px;color:#856404;font-weight:600;">
                                                            <i class="fa-solid fa-circle-exclamation"></i> Refund subject to airline policy. Please contact support for details.
                                                        </span>
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <!-- ═══ WHAT NEXT ═══ -->
