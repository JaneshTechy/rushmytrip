                                                        <span style="color:#B83000;font-size:10px;font-weight:700;padding:2px 10px;border-radius:20px;letter-spacing:0.5px; background: #FFF5F2; margin-right: 10px;">@(Model.InBoundFlights.Count - 1) - Stop/s</span>
