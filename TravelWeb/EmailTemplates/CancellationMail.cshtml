@using System.Xml
@using TravelWeb.Utilities;
@model TravelWeb.Areas.Admin.Models.EmailbookingModel
@{
    Layout = null;
}


@{
    var bookingPaxCount = @Model.BookingPaxDetail.Count;
    var adultFlightBooking = @Model.FlightBooking.Adult;
    var childFlightBooking = @Model.FlightBooking.Child;
    var infantFlightBooking = @Model.FlightBooking.Infant;
    var sumOfAll = adultFlightBooking + childFlightBooking + infantFlightBooking;

    if (bookingPaxCount != sumOfAll)
    {
        Model.FlightBooking.Adult = @Model.BookingPaxDetail.Where(x => x.PaxType == "Adult").Count();
        Model.FlightBooking.Child = @Model.BookingPaxDetail.Where(x => x.PaxType == "Child").Count();
        Model.FlightBooking.Infant = @Model.BookingPaxDetail.Where(x => x.PaxType == "Infant").Count();
    }
}

