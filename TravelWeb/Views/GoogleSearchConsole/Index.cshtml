@model TravelWeb.Models.GoogleSearchConsoleVM

@using System.Text.Json

@{    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Google Search Traffic";

    var dateLabels = JsonSerializer.Serialize(
        Model.Dates.Select(x => x.Date)
    );

    var clicksData = JsonSerializer.Serialize(
        Model.Dates.Select(x => x.Clicks)
    );

    var impressionsData = JsonSerializer.Serialize(
        Model.Dates.Select(x => x.Impressions)
    );

}


<div class="p-6 lg:p-10 bg-slate-50 min-h-screen">

    <!-- PAGE HEADER -->

    <div class="flex items-center justify-between mb-8">

        <div>
            <h1 class="text-3xl font-black text-slate-800">
                Google Search Traffic
            </h1>

            <p class="text-slate-500 mt-1">
                Search performance overview for RushMyFlight
            </p>
        </div>

        <div class="flex items-center gap-2
                    bg-green-50 text-green-600
                    px-4 py-2 rounded-xl
                    font-bold text-sm">

            <span class="w-2 h-2 bg-green-500 rounded-full"></span>

            Google Connected

        </div>

    </div>


    <!-- SUMMARY CARDS -->

    <div class="grid grid-cols-1
                md:grid-cols-2
                xl:grid-cols-4
                gap-5 mb-8">


        <!-- CLICKS -->

        <div class="bg-white rounded-2xl
                    border border-slate-200
                    p-6 shadow-sm">

            <div class="flex items-center justify-between">

                <div>

                    <p class="text-sm font-bold
                              text-slate-500 uppercase">

                        Total Clicks

                    </p>

                    <h2 class="text-3xl font-black
                               text-slate-800 mt-3">

                        @Model.TotalClicks.ToString("N0")

                    </h2>

                </div>


                <div class="w-12 h-12
                            bg-blue-50
                            text-blue-600
                            rounded-xl
                            flex items-center
                            justify-center">

                    <i class="fas fa-mouse-pointer text-xl"></i>

                </div>

            </div>

        </div>



        <!-- IMPRESSIONS -->

        <div class="bg-white rounded-2xl
                    border border-slate-200
                    p-6 shadow-sm">

            <div class="flex items-center justify-between">

                <div>

                    <p class="text-sm font-bold
                              text-slate-500 uppercase">

                        Total Impressions

                    </p>

                    <h2 class="text-3xl font-black
                               text-slate-800 mt-3">

                        @Model.TotalImpressions.ToString("N0")

                    </h2>

                </div>


                <div class="w-12 h-12
                            bg-purple-50
                            text-purple-600
                            rounded-xl
                            flex items-center
                            justify-center">

                    <i class="fas fa-eye text-xl"></i>

                </div>

            </div>

        </div>



        <!-- CTR -->

        <div class="bg-white rounded-2xl
                    border border-slate-200
                    p-6 shadow-sm">

            <div class="flex items-center justify-between">

                <div>

                    <p class="text-sm font-bold
                              text-slate-500 uppercase">

                        Average CTR

                    </p>

                    <h2 class="text-3xl font-black
                               text-slate-800 mt-3">

                        @Model.AverageCtr.ToString("0.00")%

                    </h2>

                </div>


                <div class="w-12 h-12
                            bg-green-50
                            text-green-600
                            rounded-xl
                            flex items-center
                            justify-center">

                    <i class="fas fa-percentage text-xl"></i>

                </div>

            </div>

        </div>



        <!-- POSITION -->

        <div class="bg-white rounded-2xl
                    border border-slate-200
                    p-6 shadow-sm">

            <div class="flex items-center justify-between">

                <div>

                    <p class="text-sm font-bold
                              text-slate-500 uppercase">

                        Average Position

                    </p>

                    <h2 class="text-3xl font-black
                               text-slate-800 mt-3">

                        @Model.AveragePosition.ToString("0.00")

                    </h2>

                </div>


                <div class="w-12 h-12
                            bg-orange-50
                            text-orange-600
                            rounded-xl
                            flex items-center
                            justify-center">

                    <i class="fas fa-chart-line text-xl"></i>

                </div>

            </div>

        </div>

    </div>


    <!-- PERFORMANCE GRAPH -->

    <div class="bg-white rounded-2xl
                border border-slate-200
                shadow-sm
                p-6 mb-8">

        <div class="flex items-center
                    justify-between mb-6">

            <div>

                <h2 class="text-xl font-black text-slate-800">
                    Search Performance
                </h2>

                <p class="text-sm text-slate-500 mt-1">
                    Daily clicks and impressions
                </p>

            </div>


            <div class="flex items-center gap-5 text-sm">

                <div class="flex items-center gap-2">

                    <span class="w-3 h-3
                                 rounded-full
                                 bg-blue-500">
                    </span>

                    Clicks

                </div>


                <div class="flex items-center gap-2">

                    <span class="w-3 h-3
                                 rounded-full
                                 bg-purple-500">
                    </span>

                    Impressions

                </div>

            </div>

        </div>


        <div style="height:380px; width:100%;">

            <canvas id="searchPerformanceChart"
                    style="width:100%; height:100%;">
            </canvas>

        </div>

    </div>


    <!-- KEYWORDS -->

    <div class="bg-white rounded-2xl
                border border-slate-200
                shadow-sm overflow-hidden">

        <div class="p-6 border-b border-slate-200">

            <h2 class="text-xl font-black text-slate-800">
                Top Google Search Keywords
            </h2>

            <p class="text-sm text-slate-500 mt-1">
                Queries bringing users from Google Search
            </p>

        </div>


        <div class="overflow-x-auto">

            <table class="w-full">

                <thead class="bg-slate-50">

                    <tr>

                        <th class="text-left
                                   px-6 py-4
                                   text-xs font-black
                                   uppercase text-slate-500">

                            Keyword

                        </th>

                        <th class="text-right px-6 py-4">
                            Clicks
                        </th>

                        <th class="text-right px-6 py-4">
                            Impressions
                        </th>

                        <th class="text-right px-6 py-4">
                            CTR
                        </th>

                        <th class="text-right px-6 py-4">
                            Position
                        </th>

                    </tr>

                </thead>


                <tbody class="divide-y divide-slate-100">

                    @foreach (var item in Model.Queries)
                    {
                        <tr class="hover:bg-orange-50/40
                                   transition-colors">

                            <td class="px-6 py-4
                                       font-bold text-slate-700">

                                <i class="fas fa-search
                                          text-slate-300 mr-3">
                                </i>

                                @item.Query

                            </td>


                            <td class="px-6 py-4
                                       text-right font-bold
                                       text-blue-600">

                                @item.Clicks.ToString("N0")

                            </td>


                            <td class="px-6 py-4
                                       text-right text-slate-600">

                                @item.Impressions.ToString("N0")

                            </td>


                            <td class="px-6 py-4 text-right">

                                <span class="bg-green-50
                                             text-green-600
                                             px-3 py-1
                                             rounded-lg
                                             font-bold text-sm">

                                    @item.Ctr.ToString("0.00")%

                                </span>

                            </td>


                            <td class="px-6 py-4 text-right">

                                <span class="bg-orange-50
                                             text-orange-600
                                             px-3 py-1
                                             rounded-lg
                                             font-bold">

                                    @item.Position.ToString("0.00")

                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

                                             <script>
    document.addEventListener("DOMContentLoaded", function () {

        const labels = @Html.Raw(dateLabels);
        const clicks = @Html.Raw(clicksData);
        const impressions = @Html.Raw(impressionsData);

        const canvas =
            document.getElementById("searchPerformanceChart");

        if (!canvas || labels.length === 0) {
            return;
        }

        const ctx = canvas.getContext("2d");

        function drawChart() {

            const rect = canvas.getBoundingClientRect();

            const dpr = window.devicePixelRatio || 1;

            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;

            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            const width = rect.width;
            const height = rect.height;

            ctx.clearRect(0, 0, width, height);

            const padding = {
                top: 30,
                right: 30,
                bottom: 55,
                left: 60
            };

            const chartWidth =
                width - padding.left - padding.right;

            const chartHeight =
                height - padding.top - padding.bottom;


            const maxClicks =
                Math.max(...clicks, 1);

            const maxImpressions =
                Math.max(...impressions, 1);


            // GRID

            ctx.strokeStyle = "#e2e8f0";
            ctx.lineWidth = 1;

            ctx.fillStyle = "#94a3b8";
            ctx.font = "12px Arial";

            const gridLines = 5;

            for (let i = 0; i <= gridLines; i++) {

                const y =
                    padding.top +
                    (chartHeight / gridLines) * i;

                ctx.beginPath();

                ctx.moveTo(
                    padding.left,
                    y
                );

                ctx.lineTo(
                    width - padding.right,
                    y
                );

                ctx.stroke();


                const value =
                    Math.round(
                        maxImpressions -
                        (maxImpressions / gridLines) * i
                    );

                ctx.fillText(
                    value.toLocaleString(),
                    5,
                    y + 4
                );
            }


            function getX(index) {

                if (labels.length === 1) {
                    return padding.left;
                }

                return padding.left +
                    (
                        index /
                        (labels.length - 1)
                    ) * chartWidth;
            }


            function drawLine(
                values,
                maxValue,
                strokeColor,
                fillColor
            ) {

                const gradient =
                    ctx.createLinearGradient(
                        0,
                        padding.top,
                        0,
                        height - padding.bottom
                    );

                gradient.addColorStop(
                    0,
                    fillColor
                );

                gradient.addColorStop(
                    1,
                    "rgba(255,255,255,0)"
                );


                // AREA

                ctx.beginPath();

                values.forEach((value, index) => {

                    const x = getX(index);

                    const y =
                        padding.top +
                        chartHeight -
                        (
                            value / maxValue
                        ) * chartHeight;

                    if (index === 0) {
                        ctx.moveTo(x, y);
                    }
                    else {
                        ctx.lineTo(x, y);
                    }

                });

                ctx.lineTo(
                    getX(values.length - 1),
                    height - padding.bottom
                );

                ctx.lineTo(
                    getX(0),
                    height - padding.bottom
                );

                ctx.closePath();

                ctx.fillStyle = gradient;

                ctx.fill();


                // LINE

                ctx.beginPath();

                values.forEach((value, index) => {

                    const x = getX(index);

                    const y =
                        padding.top +
                        chartHeight -
                        (
                            value / maxValue
                        ) * chartHeight;

                    if (index === 0) {
                        ctx.moveTo(x, y);
                    }
                    else {
                        ctx.lineTo(x, y);
                    }

                });

                ctx.strokeStyle = strokeColor;
                ctx.lineWidth = 3;
                ctx.lineJoin = "round";
                ctx.lineCap = "round";

                ctx.stroke();

            }


            // IMPRESSIONS

            drawLine(
                impressions,
                maxImpressions,
                "#8b5cf6",
                "rgba(139,92,246,0.15)"
            );


            // CLICKS

            drawLine(
                clicks,
                maxClicks,
                "#3b82f6",
                "rgba(59,130,246,0.18)"
            );


            // DATE LABELS

            const labelCount =
                Math.min(7, labels.length);

            const step =
                Math.max(
                    1,
                    Math.floor(
                        labels.length / labelCount
                    )
                );

            ctx.fillStyle = "#94a3b8";
            ctx.font = "12px Arial";

            for (
                let i = 0;
                i < labels.length;
                i += step
            ) {

                const x = getX(i);

                const date =
                    new Date(labels[i]);

                const text =
                    date.toLocaleDateString(
                        "en-US",
                        {
                            month: "short",
                            day: "numeric"
                        }
                    );

                ctx.fillText(
                    text,
                    x - 15,
                    height - 20
                );
            }

        }


        drawChart();

        window.addEventListener(
            "resize",
            drawChart
        );

    });
</script>