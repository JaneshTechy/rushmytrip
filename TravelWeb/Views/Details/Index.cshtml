    <script>
        /* ══════ CARD NETWORK DETECTION ENGINE ═══════ */
        const NETWORKS = [
            {
                id: 'amex',
                label: 'American Express',
                cvvLen: 4,
                cvvPos: 'front of card',
                maxLen: 17,
                grouping: [4, 6, 5],
                pattern: /^3[47]/,
                chip: 'chip-amex',
            },
            {
                id: 'diners',
                label: 'Diners Club',
                cvvLen: 3,
                cvvPos: 'back of card',
                maxLen: 16,
                grouping: [4, 6, 4],
                pattern: /^3(?:0[0-5]|[68])/,
                chip: 'chip-diners',
            },
            {
                id: 'discover',
                label: 'Discover',
                cvvLen: 3,
                cvvPos: 'back of card',
                maxLen: 19,
                grouping: [4, 4, 4, 4],
                pattern: /^6(?:011|5[0-9]{2})/,
                chip: 'chip-discover',
            },
            {
                id: 'jcb',
                label: 'JCB',
                cvvLen: 3,
                cvvPos: 'back of card',
                maxLen: 19,
                grouping: [4, 4, 4, 4],
                pattern: /^35(?:2[89]|[3-8][0-9])/,
                chip: 'chip-jcb',
            },
            {
                id: 'rupay',
                label: 'RuPay',
                cvvLen: 3,
                cvvPos: 'back of card',
                maxLen: 19,
                grouping: [4, 4, 4, 4],
                pattern: /^6(?:0[0-9]|[1-9])/,
                chip: 'chip-rupay',
            },
            {
                id: 'unionpay',
                label: 'UnionPay',
                cvvLen: 3,
                cvvPos: 'back of card',
                maxLen: 23,
                grouping: [4, 4, 4, 4],
                pattern: /^62/,
                chip: 'chip-unionpay',
            },
            {
                id: 'mc',
                label: 'Mastercard',
                cvvLen: 3,
                cvvPos: 'back of card',
                maxLen: 19,
                grouping: [4, 4, 4, 4],
                pattern: /^5[1-5]|^2(?:2(?:2[1-9]|[3-9])|[3-6]|7(?:[01]|20))/,
                chip: 'chip-mc',
            },
            {
                id: 'visa',
                label: 'Visa',
                cvvLen: 3,
                cvvPos: 'back of card',
                maxLen: 19,
                grouping: [4, 4, 4, 4],
                pattern: /^4/,
                chip: 'chip-visa',
            },
        ];

        let currentNetwork = null;

        /* ───── FIX 1: safer detection ───── */
        function detectNetwork(raw) {
            if (!raw) return null;
            for (const net of NETWORKS) {
                if (net.pattern.test(raw)) return net;
            }
            return null;
        }

        /* ───── grouping formatter (unchanged logic) ───── */
        function applyGrouping(raw, grouping) {
            let result = '';
            let idx = 0;

            for (let i = 0; i < grouping.length; i++) {
                const chunk = raw.substring(idx, idx + grouping[i]);
                if (!chunk) break;
                result += (i > 0 && chunk ? ' ' : '') + chunk;
                idx += grouping[i];
            }

            return result.trim();
        }

        /* ───── FIX 2: correct max length logic ───── */
        function onCardInput(el) {
            const raw = el.value.replace(/\D/g, '');
            const net = detectNetwork(raw);

            const grouping = net ? net.grouping : [4, 4, 4, 4];

            // FIXED: DO NOT subtract grouping length
            const maxDigits = net ? net.maxLen : 19;

            const clipped = raw.substring(0, maxDigits);
            const formatted = applyGrouping(clipped, grouping);

            el.value = formatted;
            el.maxLength = net ? net.maxLen : 19;

            updateNetworkUI(net, raw.length);
        }

        /* ───── UI update ───── */
        function updateNetworkUI(net, rawLen) {
            const badge   = document.getElementById('cardIconBadge');
            const pill    = document.getElementById('cardIconPill');
            const chip    = document.getElementById('cardChip');
            const chipLbl = document.getElementById('chipLabel');

            currentNetwork = net;

            if (!net || rawLen === 0) {
                badge.style.display = 'none';
                chip.className = 'card-detect-chip';
                setCvv(3, 'back of card');
                return;
            }

            badge.style.display = 'block';

            pill.className = 'cn-icon cn-' + net.id + ' active';
            pill.textContent = net.label;

            chip.className = 'card-detect-chip show ' + net.chip;
            chipLbl.textContent = net.label + ' detected';

            setCvv(net.cvvLen, net.cvvPos);
        }

        /* ───── FIX 3: CVV input ID corrected ───── */
        function setCvv(len, pos) {
            const cvvIn    = document.getElementById('txtCardSecurity');
            const cvvBadge = document.getElementById('cvvBadge');
            const cvvHint  = document.getElementById('cvvHint');

            if (!cvvIn) return;

            cvvIn.maxLength = len;
            cvvIn.placeholder = '•'.repeat(len);

            if (cvvIn.value.length > len) {
                cvvIn.value = cvvIn.value.substring(0, len);
            }

            cvvBadge.textContent = len === 4 ? '4 digits' : '3 digits';
            cvvBadge.className = 'cvv-length-badge ' + (len === 4 ? 'four' : 'three');

            cvvHint.innerHTML = `
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:11px;height:11px;flex-shrink:0;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                ${len} digit${len > 1 ? 's' : ''} on the ${pos}
            `;
        }

        /* ───── submit ───── */
        function submitPayment() {
            alert('Payment form submitted! (demo only)');
        }
    </script>
