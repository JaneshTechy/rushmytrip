            function validateForm() {
                let isValid = true;
                let firstInvalid = null;

                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                document.querySelectorAll(".required-fields").forEach(el => {
                    el.style.border = "";

                    const value = el.value ? el.value.trim() : "";

                    if (!value || value === "0") {
                        markError(el);
                        isValid = false;
                        if (!firstInvalid) firstInvalid = el;
                        return;
                    }

                    if (el.id === "txtEmail" && !emailRegex.test(value)) {
                        markError(el);
                        isValid = false;
                        if (!firstInvalid) firstInvalid = el;
                    }
                });

                // const email = document.getElementById("txtEmail")?.value.trim();
                // const confirmEmail = document.getElementById("emailConfirm")?.value.trim();

                // if (email && confirmEmail && email !== confirmEmail) {
                //     const el = document.getElementById("emailConfirm");
                //     markError(el);
                //     isValid = false;
                //     if (!firstInvalid) firstInvalid = el;
                // }

                const phone = document.getElementById("txtphone");
                const country = document.getElementById("PhoneCountry");

                if (phone && (!phone.value || phone.value.trim().length < 8)) {
                    markError(phone);
                    isValid = false;
                    if (!firstInvalid) firstInvalid = phone;
                }

                if (country && !country.value) {
                    markError(country);
                    isValid = false;
                    if (!firstInvalid) firstInvalid = country;
                }

                return { isValid, firstInvalid };
