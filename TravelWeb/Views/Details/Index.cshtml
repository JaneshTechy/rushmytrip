                            if (leg == null || !leg.Any()) { continue; }
                            var f = leg.FirstOrDefault()?.FromAirport?.CityName ?? leg.FirstOrDefault()?.FromAirport?.Code;
                            var t = leg.LastOrDefault()?.ToAirport?.CityName ?? leg.LastOrDefault()?.ToAirport?.Code;
                            if (!string.IsNullOrEmpty(f) && (cities.Count == 0 || cities[cities.Count - 1] != f))
                            {
                                cities.Add(f);
                            }
                            if (!string.IsNullOrEmpty(t))
                            {
                                cities.Add(t);
                            }
