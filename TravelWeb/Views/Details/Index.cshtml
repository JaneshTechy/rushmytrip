        }
        if (child > 0) {
            $("#bsumChildLabel").text(child + " Child × " + currencyFmt(childFare + childMarkup));
            $("#bsumChildVal").text(currencyFmt((childFare + childMarkup) * child));
        }
        if (infant > 0) {
            $("#bsumInfantLabel").text(infant + " Infant × " + currencyFmt(infantFare + infantMarkup));
            $("#bsumInfantVal").text(currencyFmt((infantFare + infantMarkup) * infant));
        }

        var taxTotal = (adultTax * adult) + (childTax * child) + (infantTax * infant);
        $("#bsumTaxesVal").text(currencyFmt(taxTotal));
        $("#bsumAtolVal").text(currencyFmt(atol));
    }

    function updateDisplayedTotal(total, res) {
        var t = money(total);
        var atol = res && res.atolCharge != null ? Number(res.atolCharge) : 0;
        var payable = res && res.payable != null ? Number(res.payable) : (Number(t) + (isNaN(atol) ? 0 : atol));
        var display = money(payable);

        $("#subTotal").text(display);
        $("#TotalAmountWithPreference").val(display);
        $("#subTotalAmt").val(t);
        $("#hdnspTotalCostAmount").val(t);
        $("#bsumGrandTotal").text(currencyFmt(payable));
        $("#bsumGrandTotalNote").text(currencyFmt(payable));
        $(".bsum-total, .sidebar-total, #grandTotalDisplay").each(function () {
            if ($(this).length) $(this).text(display);
        });
        updateFareHiddenFields(res);
    }

    function acceptLivePrice(optionIndex) {
        var searchId = $("#hdnVerifierSearchId").val();
        var flightId = $("#hdnFlightId").val() || $("#FlightId").val();
        return $.ajax({
            url: "/details/accept-live-price",
            type: "POST",
            data: {
                searchId: searchId,
                flightId: flightId,
                bookingOptionIndex: optionIndex
            }
        });
    }

    $("#btn-price-new-search").on("click", function () {
        var back = "@Html.Raw(ViewBag.BackToResult ?? "/")";
        window.location.href = back || "/";
    });

    function selectTicketCard($card) {
        var idx = parseInt($card.attr("data-option-index"), 10);
        var price = parseFloat($card.attr("data-price"));
        $(".ticket-card").removeClass("is-selected").attr("aria-pressed", "false");
        $(".ticket-card .ticket-radio").removeClass("checked");
        $(".ticket-card .ticket-selected-badge").remove();
        $card.addClass("is-selected").attr("aria-pressed", "true");
        $card.find(".ticket-radio").addClass("checked");
        if ($card.find(".ticket-selected-badge").length === 0) {
            $card.prepend('<span class="ticket-selected-badge" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>');
        }
        $("#hdnSelectedTicketIndex").val(idx);
        var displayPrice = parseFloat($card.attr("data-display-price"));
        var markup = parseFloat($("#choose-ticket-wrap").attr("data-markup-total")) || 0;
        var atol = parseFloat($("#choose-ticket-wrap").attr("data-atol")) || 0;
        if (!isNaN(displayPrice)) {
            // displayPrice already includes markup + ATOL; total = GrandTotal (excl. ATOL)
            updateDisplayedTotal(displayPrice - atol, {
                payable: displayPrice,
                atolCharge: atol
            });
        } else if (!isNaN(price)) {
            updateDisplayedTotal(price + markup, {
                payable: price + markup + atol,
                atolCharge: atol
            });
        }

        acceptLivePrice(idx).done(function (res) {
            if (res && res.ok) updateDisplayedTotal(res.total, res);
        });
    }

    $(document).on("click", ".ticket-card", function () {
        selectTicketCard($(this));
    });

    window.showTicketDetails = function (idx) {
        var raw = document.getElementById("ticket-options-json");
        if (!raw) return;
        var options = [];
        try { options = JSON.parse(raw.textContent || "[]"); } catch (e) { return; }
        var opt = options[idx];
        if (!opt) return;
        var title = opt.fare || opt.fare_type || opt.vendor || "Fare";
        $("#ticket-details-title").text(title + " details");
        var list = $("#ticket-details-list").empty();
        var texts = opt.featureText && opt.featureText.length
            ? opt.featureText
            : (opt.features || []).map(function (f) { return f.text; });
        if (!texts || !texts.length) {
            texts = ["Flight ticket", opt.vendor ? ("Vendor: " + opt.vendor) : "Selected fare option"];
        }
        (texts || []).forEach(function (t) {
            list.append($("<li/>").text(t));
        });
        $("#ticket-details-modal").show().attr("aria-hidden", "false");
    };

    window.hideTicketDetails = function () {
        $("#ticket-details-modal").hide().attr("aria-hidden", "true");
    };

    var $sel = $(".ticket-card.is-selected").first();
    if ($sel.length) {
        $("#hdnSelectedTicketIndex").val($sel.attr("data-option-index") || 0);
    }
})();
</script>

</body>
</html>
