                        @* @{
                            var fare = Model.FlightFare;

                            var adultBaseTotal = fare.AdultFare * fare.Adult;
                            var childBaseTotal = fare.ChildFare * fare.Child;
                            var infantBaseTotal = fare.InfantFare * fare.Infant;

                            var totalTaxAndMarkup =
                            ((fare.AdultTax + fare.AdultMarkup) * fare.Adult) +
                            ((fare.ChildTax + fare.ChildMarkup) * fare.Child) +
                            ((fare.InfantTax + fare.InfantMarkup) * fare.Infant);

                            var grandTotal = fare.GrandTotal;
                        } *@

                       @{
    var fare = Model.FlightFare;

    // Original totals
    decimal adultBaseTotal = Convert.ToDecimal(fare.AdultFare * fare.Adult);
    decimal childBaseTotal = Convert.ToDecimal(fare.ChildFare * fare.Child);
    decimal infantBaseTotal = Convert.ToDecimal(fare.InfantFare * fare.Infant);

    decimal totalBaseFare =
        adultBaseTotal +
        childBaseTotal +
        infantBaseTotal;

    decimal totalTax =
        Convert.ToDecimal(fare.AdultTax * fare.Adult) +
        Convert.ToDecimal(fare.ChildTax * fare.Child) +
        Convert.ToDecimal(fare.InfantTax * fare.Infant);

    decimal totalMarkup =
        Convert.ToDecimal(fare.AdultMarkup * fare.Adult) +
        Convert.ToDecimal(fare.ChildMarkup * fare.Child) +
        Convert.ToDecimal(fare.InfantMarkup * fare.Infant);

            decimal atolCharge = Convert.ToDecimal(fare?.AtolCharge ?? 0);


    decimal grandTotal =
        Convert.ToDecimal(fare.GrandTotal);
        
         var formatted = grandTotal.ToString("C");
    var symbol = System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol;
    // @(symbol + formatted.Replace(symbol, "").Trim())

    // Adjust fares proportionally
    decimal adjustedAdultTotal = adultBaseTotal;
    decimal adjustedChildTotal = childBaseTotal;
    decimal adjustedInfantTotal = infantBaseTotal;

    if (totalMarkup != 0 && totalBaseFare > 0)
    {
        adjustedAdultTotal += totalMarkup * (adultBaseTotal / totalBaseFare);
        adjustedChildTotal += totalMarkup * (childBaseTotal / totalBaseFare);
        adjustedInfantTotal += totalMarkup * (infantBaseTotal / totalBaseFare);
    }

    // Per passenger fare
    decimal adjustedAdultFare =
        fare.Adult > 0
            ? adjustedAdultTotal / fare.Adult
            : 0;

    decimal adjustedChildFare =
        fare.Child > 0
            ? adjustedChildTotal / fare.Child
            : 0;

    decimal adjustedInfantFare =
        fare.Infant > 0
            ? adjustedInfantTotal / fare.Infant
            : 0;

    // Final tax adjustment
    decimal adjustedFareTotal =
        adjustedAdultTotal +
        adjustedChildTotal +
        adjustedInfantTotal;

    decimal adjustedTax =
        grandTotal - adjustedFareTotal;

    if (adjustedTax < 0)
    {
        adjustedTax = 0;
    }
    if (atolCharge > 0)
    {
         grandTotal = grandTotal + Convert.ToDecimal(atolCharge);

    }
}

