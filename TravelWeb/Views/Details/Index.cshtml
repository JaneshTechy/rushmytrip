    @section Scripts {
        <script type="text/javascript">

            /* =========================
               CONFIG
            ========================= */
            const countriesFile = '/json/data_iso_3166-1.json';
            const statesFile = '/json/data_iso_3166-2.json';

            let countriesData = [];
            let statesData = [];

            let isSubmitting = false;

            /* =========================
               INIT
            ========================= */
            document.addEventListener("DOMContentLoaded", async function () {
                try {
                    const [countriesRes, statesRes] = await Promise.all([
                        fetch(countriesFile),
                        fetch(statesFile)
                    ]);

                    const countriesJson = await countriesRes.json();
                    const statesJson = await statesRes.json();

                    countriesData = countriesJson["3166-1"] || [];
                    statesData = statesJson["3166-2"] || [];

                    populateCountries();
                    populatePhoneCountries();

                    const detectedCountry = await detectUserCountryCode();
                    const defaultCountry = detectedCountry || 'IN';

                    const countryDropdown = document.getElementById('drpCountry');
                    const phoneDropdown = document.getElementById('PhoneCountry');

                    if (countryDropdown) {
                        countryDropdown.value = defaultCountry;
                        populateStates(defaultCountry);

                        countryDropdown.addEventListener('change', function () {
                            populateStates(this.value);
                        });
                    }

                    if (phoneDropdown) {
                        phoneDropdown.value = defaultCountry;
                    }

                } catch (error) {
                    console.error('Initialization error:', error);
                }
            });

            /* =========================
               Show Loader
            ========================= */

            function showLoader() {
                document.getElementById("loader")?.classList.add("active");
            }

            function hideLoader() {
                document.getElementById("loader")?.classList.remove("active");
            }

            /* =========================
               COUNTRY DROPDOWN
            ========================= */
            function populateCountries() {
                const el = document.getElementById('drpCountry');
                if (!el) return;

                el.innerHTML = '<option value="0">Select Country</option>';

                countriesData.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.alpha_2;
                    opt.textContent = c.name;
                    el.appendChild(opt);
                });
            }

            /* =========================
               PHONE COUNTRY DROPDOWN
            ========================= */
            function populatePhoneCountries() {
                const el = document.getElementById('PhoneCountry');
                if (!el) return;

                el.innerHTML = '<option value="">Code</option>';

                countriesData.forEach(c => {
                    if (!c.alpha_2) return;

                    const opt = document.createElement('option');
                    opt.value = c.alpha_2;
                    opt.textContent = c.alpha_2;
                    el.appendChild(opt);
                });
            }

            /* =========================
               STATES DROPDOWN
            ========================= */
            function populateStates(countryCode) {
                const el = document.getElementById('drpState');
                if (!el) return;

                el.innerHTML = '<option value="">State/Region</option>';

                if (!countryCode || countryCode === "0") return;

                statesData
                    .filter(s => s.code.startsWith(countryCode + "-"))
                    .forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.code;
                        opt.textContent = s.name;
                        el.appendChild(opt);
                    });
            }

            /* =========================
               COUNTRY DETECTION
            ========================= */
            async function detectUserCountryCode() {
                try {
                    const locale = Intl.DateTimeFormat().resolvedOptions().locale;
                    const parts = locale.split('-');

                    if (parts.length > 1) {
                        const code = parts[1].toUpperCase();
                        if (countriesData.some(c => c.alpha_2 === code)) {
                            return code;
                        }
                    }

                    const res = await fetch('https://ipapi.co/json/');
                    const data = await res.json();

                    if (data?.country_code) return data.country_code;

                } catch (e) {
                    console.warn('Country detection failed');
                }

                return 'IN';
            }

