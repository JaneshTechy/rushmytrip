<div class="theme-page-section theme-page-section-lg detailPage detail-mob-space">
    <div class="detailTitle">
        <div class="container">
            @{
                string[] Values = (ViewBag.Trip).Split(',');


            }
            <span class="destiTitle">@(ViewBag.FromName) → @(ViewBag.ToName)</span>
            <div class="dltTitle"><span><i class="fa fa-male" aria-hidden="true"></i>@Values[2].ToString()</span>&nbsp; • &nbsp;<span>@Values[0].ToString()</span>&nbsp; • &nbsp;<span>@Values[1].ToString() class</span></div>
            <div class="dltTitle"><a href="@(ViewBag.BackToResult)" style="color:white"><i class="fa fa-long-arrow-left" href="@(ViewBag.BackToResult)"  aria-hidden="true" style="color:white"></i> Back to result</a></div>
        </div>
    </div>
    <div class="container">
        <div class="row row-col-static row-col-mob-gap gap-hide" id="sticky-parent" data-gutter="60" style="color:#0b1f66 !important">
            <br />

            @if (Model != null)
            {

                //var Tax = Convert.ToDouble(0.2 * Model.FlightFare.GrandTotal);


                <div class="col-md-8 col-xs-12">
                    <div class="theme-payment-page-sections">
                        @*<div class="breadcrumbBox hidephone">
                                <ul class="breadcrumb">
                                    <li><a href="#">Search</a></li>
                                    <li class="active">Flight details</li>
                                    <li><a href="#">Passenger details</a></li>
                                    <li><a href="#">Billing information</a></li>
                                    <li><a href="#">Payment details</a></li>
                                    <li><a href="#">confirmation</a></li>
                                </ul>
                            </div>*@
                        @*<div class="backModifyBox">
                                <div class="row back-mob">
                                    <div class="col-md-6 col-xs-6"><a href="@(ViewBag.BackToResult)" class=""><i class="fa fa-long-arrow-left" aria-hidden="true"></i> Back to result</a></div>
                                    <div class="col-md-6 col-xs-6 text-right"><a href="/" class=""><i class="fa fa-pencil" aria-hidden="true"></i> Modify</a></div>
                                </div>
                            </div>*@

                        <div class="theme-payment-page-sections-item" style="display:none">
                            <div class="theme-search-results-item theme-payment-page-item-thumb" styl>
                                <div class="row" data-gutter="20">
                                    <div class="col-md-9 ">
                                        <p class="theme-search-results-item-flight-payment-airline">You are flying @(Common.GetAirline(Model.Airline.Code).Name) Airways</p>
                                        <h5 class="theme-search-results-item-title">@(ViewBag.FromName), @(ViewBag.FromCode) &nbsp;&rarr;&nbsp; @(ViewBag.ToName),  @(ViewBag.ToCode)</h5>
                                        <p class="theme-search-results-item-flight-payment-info">@(ViewBag.Trip)</p>
                                        <ul class="theme-search-results-item-flight-payment-dates">
                                            <li>Depart: @(Convert.ToDateTime(ViewBag.Depart).ToString("MMM, dd, yyyy"))</li>
                                            @if (ViewBag.FlightWay == "RoundTrip")
                                            {
                                                <li>Return: @(Convert.ToDateTime(ViewBag.Return).ToString("MMM, dd, yyyy"))</li>
                                            }
                                        </ul>
                                        <a class="theme-search-results-item-flight-payment-details-link" href="#FlightPaymentDetails" data-toggle="collapse" aria-expanded="false" aria-controls="FlightPaymentDetails">
                                            Flight Details &nbsp;
                                            <i class="fa fa-angle-down"></i>
                                        </a>
                                        <div class="collapse _pt-20" id="FlightPaymentDetails">
                                            @*<div class="collapse _pt-20 collapse in" id="FlightPaymentDetails" aria-expanded="true">*@
                                            <div class="theme-search-results-item-flight-detail-items">
                                                <div class="theme-search-results-item-flight-details">
                                                    <div class="row">

                                                        <div class="col-md-3 ">
                                                            <div class="theme-search-results-item-flight-details-info">
                                                                <h5 class="theme-search-results-item-flight-details-info-title">Depart</h5>
                                                                <p class="theme-search-results-item-flight-details-info-date">@(Convert.ToDateTime(ViewBag.Depart).ToString("MMM, dd, yyyy"))</p>
                                                                <p class="theme-search-results-item-flight-details-info-cities">@(ViewBag.FromName) &rarr; @(ViewBag.ToName)</p>
                                                                @{ int depstop = 0; string dephrscalc = "";}
                                                                @foreach (var onb in Model.Outbound)
                                                                {
                                                                    TimeSpan t = TimeSpan.FromMinutes(Convert.ToInt32(onb.TotalTime));
                                                                    string hours = t.TotalHours.ToString().Split(".")[0];
                                                                    dephrscalc = string.Format("{0}h {1:D2}m", hours, t.Minutes);
                                                                    depstop++;
                                                                }
                                                                <p class="theme-search-results-item-flight-details-info-fly-time">@(dephrscalc)</p>
                                                                <p class="theme-search-results-item-flight-details-info-stops">@(depstop - 1) stop</p>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-9 ">
                                                            <div class="theme-search-results-item-flight-details-schedule">
                                                                <ul class="theme-search-results-item-flight-details-schedule-list">
                                                                    @{ int otbcnt = 0;

                                                                    }
                                                                    @foreach (var onb in Model.Outbound)
                                                                    {
                                                                        string tothours = "";
                                                                        if (Convert.ToInt32(onb.ElapsedTime) > 0)
                                                                        {
                                                                            TimeSpan finalcale = TimeSpan.FromMinutes(Convert.ToInt32(onb.ElapsedTime));
                                                                            tothours = string.Format("{0:D2}h {1:D2}m", finalcale.Hours, finalcale.Minutes);
                                                                        }
                                                                        else
                                                                        {
                                                                            TimeSpan calinbtes = Convert.ToDateTime(onb.ArrivalDate) - Convert.ToDateTime(onb.DepartureDate);
                                                                            TimeSpan finalcale = TimeSpan.FromMinutes(calinbtes.TotalMinutes);
                                                                            tothours = string.Format("{0:D2}h {1:D2}m", finalcale.Hours, finalcale.Minutes);
                                                                        }

                                                                        <li>
                                                                            <i class="fa fa-plane outbound theme-search-results-item-flight-details-schedule-icon"></i>

                                                                            <div class="theme-search-results-item-flight-details-schedule-dots"></div>

                                                                            <p class="theme-search-results-item-flight-details-schedule-date">
                                                                                @(Convert.ToDateTime(onb.DepartureDate).ToString("MMM, dd, yyyy"))&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                                                &nbsp;&nbsp;&nbsp;&mdash;&mdash;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                                                @(Convert.ToDateTime(onb.ArrivalDate).ToString("MMM, dd, yyyy"))&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                                                &nbsp;&nbsp;&nbsp;&nbsp;&emsp;&emsp;&emsp;&emsp;
                                                                                &nbsp;&nbsp;&nbsp;&nbsp;
                                                                                &nbsp;&nbsp;&nbsp;&nbsp;&emsp;&emsp;&emsp;&emsp;<i style="font-size:16px;color:black" class="fa fa-clock-o" aria-hidden="true"></i>
                                                                                @*- @(Convert.ToDateTime(onb.DepartureDate).ToString("MMM, dd, yyyy"))*@
                                                                            </p>

                                                                            <div class="theme-search-results-item-flight-details-schedule-time">
                                                                                <span class="theme-search-results-item-flight-details-schedule-time-item">
                                                                                    @(Convert.ToDateTime(onb.DepartureDate).ToString("HH:mm"))
                                                                                    @*<span>@(Convert.ToDateTime(onb.DepartureDate).ToString("tt"))</span>*@
                                                                                </span>
                                                                                <span class="theme-search-results-item-flight-details-schedule-time-separator">&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;</span>
                                                                                <span class="theme-search-results-item-flight-details-schedule-time-item">
                                                                                    @(Convert.ToDateTime(onb.ArrivalDate).ToString("HH:mm"))
                                                                                    @*<span> @(Convert.ToDateTime(onb.ArrivalDate).ToString("tt"))</span>*@
                                                                                </span>
                                                                            </div>

                                                                            <p class="theme-search-results-item-flight-details-schedule-fly-time">@(tothours)</p>
                                                                            <div class="theme-search-results-item-flight-details-schedule-destination">
                                                                                <div class="theme-search-results-item-flight-details-schedule-destination-item">
                                                                                    <p class="theme-search-results-item-flight-details-schedule-destination-title">
                                                                                        <b>@(onb.FromAirport.Code)</b>&nbsp; @(Common.GetAirport(onb.FromAirport.Code).Name)
                                                                                    </p>
                                                                                    <p class="theme-search-results-item-flight-details-schedule-destination-city">@(Common.GetAirport(onb.FromAirport.Code).CityName)</p>
                                                                                </div>
                                                                                <div class="theme-search-results-item-flight-details-schedule-destination-separator">
                                                                                    <span>&rarr;</span>
                                                                                </div>
                                                                                <div class="theme-search-results-item-flight-details-schedule-destination-item">
                                                                                    <p class="theme-search-results-item-flight-details-schedule-destination-title">
                                                                                        <b>@(onb.ToAirport.Code)</b> &nbsp; @(Common.GetAirport(onb.ToAirport.Code).Name)
                                                                                    </p>
                                                                                    <p class="theme-search-results-item-flight-details-schedule-destination-city">@(Common.GetAirport(onb.ToAirport.Code).CityName)</p>
                                                                                </div>
                                                                            </div>
                                                                            <ul class="theme-search-results-item-flight-details-schedule-features">
                                                                                @{
                                                                                    Airline airname = Common.GetAirline(onb.Airline.Code);
                                                                                }
                                                                                <li>@(airname.Code)@(onb.FlightNo)</li>
                                                                                <li><img src="@(Common.WebSitePath)img/airline/icon/@(airname.Code).png"> @(airname.Name.ToLower())</li>



                                                                            </ul>
                                                                        </li>
                                                                        @if (depstop > 1 && otbcnt < (depstop - 1))
                                                                        {
                                                                            <li>
                                                                                <i class="fa fa-exchange theme-search-results-item-flight-details-schedule-icon"></i>
                                                                                <div style="top:42px !important" class="theme-search-results-item-flight-details-schedule-dots">

                                                                                </div>
                                                                                <p class="theme-search-results-item-flight-details-schedule-date">
                                                                                    @Convert.ToDateTime(Model.Outbound[otbcnt].ArrivalDate).ToString("MMM, dd, yyyy")&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                                                    &nbsp;&nbsp;&nbsp;&mdash;&mdash;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;@Convert.ToDateTime(Model.Outbound[otbcnt + 1].DepartureDate).ToString("MMM, dd, yyyy")
                                                                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                                                    &nbsp;&nbsp;&nbsp;&nbsp;&emsp;&emsp;&emsp;&emsp;
                                                                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                                                                    &nbsp;&nbsp;&nbsp;&nbsp;&emsp;&emsp;
                                                                                    <img src="~/img/rest-area-icon-18.jpg" width="30" height="30" />
                                                                                </p>
                                                                                <div class="theme-search-results-item-flight-details-schedule-time">
                                                                                    <span class="theme-search-results-item-flight-details-schedule-time-item">
                                                                                        @(Convert.ToDateTime(Model.Outbound[otbcnt].ArrivalDate).ToString("HH:mm"))
                                                                                    </span>
                                                                                    <span class="theme-search-results-item-flight-details-schedule-time-separator">&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;</span>
