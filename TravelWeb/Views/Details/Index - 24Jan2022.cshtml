<script>
    function IsValidContactDetails() {
        var lbool = true;
        if ($('#txtphone').val().trim() == '')
        {
            //Swal.fire('Please Enter Your Valid Mobile Number')
            $('#txtphone').css({ "border-color": "red" });
            //document.getElementById('txtphoneerror').innerHTML="Please enter phone no";
            $('#txtphone').focus();
            return lbool = false;
        }
        else {
            $('#txtphone').css({ "border": "" });
            lbool = true;
        }
        if ($('#txtEmail').val().trim() == '')
        {
            $('#txtEmail').css({ "border-color": "red" });
            //document.getElementById('txtEmailerror').innerHTML = "Please enter email";
            $('#txtEmail').focus();
            lbool = false;
        }
        else {
            if (!isEmail($("#txtEmail").val())) {
                $("#txtEmail").css({ "border-color": "red!important" });
                //document.getElementById('txtEmailerror').innerHTML = "Please enter valid email";
                $("#txtEmail").focus();
                lbool = false;
            }
            else {
                $('#txtEmail').css({ "border": "" }); lbool = true;
            }

        }
        return lbool;
    }

