<style>
    .item {
        background: rgba(255, 255, 255, 0.20);
    }
    /* Section spacing and header (consistent with prior conversions) */
    .deals-today-section {
        padding-top: 4rem;
        padding-bottom: 4rem;
    }
    /* py-16 */
    .deals-today-header {
        text-align: center;
        margin-bottom: 3rem;
    }
    /* mb-12 */
    .deals-today-title {
        font-size: 1.875rem;
        line-height: 2.25rem;
        font-weight: 700;
        color: #1F2937;
    }

    .deals-today-subtitle {
        color: #6B7280;
        margin-top: 0.5rem;
    }

    .deals-today-underline {
        width: 5rem;
        height: .25rem;
        background: #FF4A55;
        margin: .5rem auto 0;
        border-radius: 9999px;
    }

    @@media (prefers-color-scheme: dark) {
        .deals-today-title {
            color: #F9FAFB;
        }

        .deals-today-subtitle {
            color: #9CA3AF;
        }
    }

    /* Responsive grid */
    .deals-today-grid {
        display: grid;
        grid-template-columns: 1fr; /* grid-cols-1 */
        gap: 2rem; /* gap-8 */
    }

    @@media (min-width: 640px) { /* sm */
        .deals-today-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (min-width: 1024px) { /* lg */
        .deals-today-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* Cards */
    .deal-card {
        position: relative; /* relative */
        border-radius: .5rem; /* rounded-lg */
        overflow: hidden; /* overflow-hidden */
        box-shadow: 0 10px 15px -3px rgba(0,0,0,.1), 0 4px 6px -4px rgba(0,0,0,.1); /* shadow-lg */
        transform: translateZ(0);
        transition: transform 300ms ease; /* hover:-translate-y-2 */
    }

        .deal-card:hover {
            transform: translateY(-0.5rem);
        }
    /* -translate-y-2 */

    .deal-card__img {
        width: 100%; /* w-full */
        height: 12rem; /* h-48 */
        object-fit: cover; /* object-cover */
        display: block;
    }

    .deal-card__body {
        padding: 1.5rem;
    }
    /* p-6 */

    .deal-card__row {
        display: flex;
        align-items: center;
        justify-content: space-between; /* flex justify-between items-center */
        margin-bottom: 0.5rem; /* mb-2 */
    }

    .deal-card__title {
        font-size: 1.25rem; /* text-xl */
        font-weight: 600; /* font-semibold */
        color: #1F2937;
    }

    .deal-card__price {
        font-size: 1.125rem; /* text-lg */
        font-weight: 700; /* font-bold */
        color: #e5e7eb; /* light gray on dark; adjust as needed for theme */
    }

    .deal-card__route {
        color: #6B7280; /* secondary text */
        margin-bottom: 1rem; /* mb-4 */
    }

    .deal-card__meta {
        display: flex;
        align-items: center;
        color: #6B7280;
        font-size: .875rem; /* text-sm */
    }

    .deal-card__meta-icon {
        font-size: 1rem; /* text-base */
        margin-right: .25rem; /* mr-1 */
    }

    @@media (prefers-color-scheme: dark) {
        .deal-card__title {
            color: #F9FAFB;
        }

        .deal-card__route, .deal-card__meta {
            color: #9CA3AF;
        }
    }

    .deals-section {
        padding-top: 4rem; /* py-16 */
        padding-bottom: 4rem;
    }

    .deals-hero {
        position: relative;
        /* border-radius: 0.5rem; */ /* rounded-lg */
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -4px rgba(0,0,0,0.1); /* shadow-lg */
        overflow: hidden;
        background-size: cover; /* bg-cover */
        background-position: center; /* bg-center */
        min-height: 500px; /* min-h-[500px] */
        display: flex; /* flex */
        align-items: center; /* items-center */
        justify-content: center; /* justify-center */
        color: #fff; /* text-white */
    }

    .deals-hero__overlay {
        position: absolute; /* absolute inset-0 */
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5); /* bg-black bg-opacity-50 */
    }

    .deals-hero__content {
        position: relative; /* relative z-10 */
        z-index: 10;
        width: 100%; /* w-full */
        max-width: 64rem; /* max-w-4xl */
        margin-left: auto; /* mx-auto */
        margin-right: auto;
        padding-left: 1rem; /* px-4 */
        padding-right: 1rem;
        text-align: center; /* text-center */
    }

    .deals-title {
        font-size: 1.875rem; /* text-3xl */
        line-height: 2.25rem;
        font-weight: 700; /* font-bold */
        margin-bottom: 1.5rem; /* mb-6 */
    }

    @@media (min-width: 768px) {
        .deals-title {
            font-size: 2.25rem;
            line-height: 2.5rem;
        }
    }

    .deals-card {
        background: rgba(255,255,255,0.10); /* bg-white/10 */
        backdrop-filter: blur(6px); /* backdrop-blur-sm */
        border-radius: 0.5rem; /* rounded-lg */
        padding: 5rem; /* p-4 */
        margin: 2rem;
    }

    .deals-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem; /* space-y-3 */
    }

    .deal-row {
        display: grid; /* grid */
        grid-template-columns: 1fr auto auto; /* 2 cols for route + two autos for dates/price */
        align-items: center; /* items-center */
        gap: 0.5rem; /* gap-2 */
        padding: 0.75rem; /* p-3 */
        border-radius: 0.5rem; /* rounded-lg */
        transition: background-color 300ms ease; /* transition-colors duration-300 */
    }

        .deal-row:hover {
            background: rgba(255,255,255,0.20); /* hover:bg-white/20 */
        }

    .deal-route {
        font-weight: 600; /* font-semibold */
        text-align: left; /* text-left */
    }

    .deal-dates {
        font-size: 0.875rem; /* text-sm */
        opacity: 0.95;
    }

    .deal-price {
        font-weight: 700; /* font-bold */
        font-size: 1.125rem; /* text-lg */
        color: #e5e7eb; /* text-secondary (approx light gray on dark) */
    }

    /* Match original responsive grid where route spans 2 of 4 columns */
    @@media (min-width: 640px) {
        .deal-row {
            grid-template-columns: 2fr 1fr 1fr; /* emulates grid-cols-4 with route col-span-2 */
        }
    }
    /* Spacing wrapper reused from previous section style */
    .why-section {
        padding-top: 4rem;
        padding-bottom: 4rem;
    }
    /* py-16 */

    .why-header {
        text-align: center;
        margin-bottom: 3rem;
    }
    /* mb-12 */
    .why-title {
        font-size: 1.875rem;
        line-height: 2.25rem;
        font-weight: 700;
        color: #1F2937;
    }

    .why-subtitle {
        color: #6B7280;
        margin-top: 0.5rem;
    }

    .why-underline {
        width: 5rem;
        height: 0.25rem;
        background: #FF4A55;
        margin: 0.5rem auto 0;
        border-radius: 9999px;
    }

    @@media (prefers-color-scheme: dark) {
        .why-title {
            color: #F9FAFB;
        }

        .why-subtitle {
            color: #9CA3AF;
        }
    }

    /* Responsive grid */
    .why-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem; /* gap-8 */
    }

    @@media (min-width: 640px) { /* sm */
        .why-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (min-width: 1024px) { /* lg */
        .why-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    /* Cards */
    .why-card {
        padding: 5.5rem; /* p-6 */
        border-radius: 0.5rem; /* rounded-lg */
        box-shadow: 0 4px 6px -1px rgba(0,0,0,.1), 0 2px 4px -2px rgba(0,0,0,.1); /* shadow-md */
        text-align: center;
        transform: translateZ(0); /* for smoother hover */
        transition: transform 300ms ease; /* hover:scale-105 duration-300 */
    }

        .why-card:hover {
            transform: scale(1.05);
        }

    /* Gradient backgrounds */
    .why-card--purple {
        background: linear-gradient(135deg, #F3E8FF 0%, #FFE4E6 100%); /* from-purple-100 to-pink-100 */
    }

    .why-card--indigo {
        background: linear-gradient(135deg, #DBEAFE 0%, #E0E7FF 100%); /* from-blue-100 to-indigo-100 */
    }

    .why-card--greenblue {
        background: linear-gradient(135deg, #DCFCE7 0%, #DBEAFE 100%); /* from-green-100 to-blue-100 */
    }

    .why-card--redyellow {
        background: linear-gradient(135deg, #FEE2E2 0%, #FEF3C7 100%); /* from-red-100 to-yellow-100 */
    }

    /* Dark-mode friendly overlays (approximate Tailwind dark variants) */
    @@media (prefers-color-scheme: dark) {
        .why-card--purple {
            background: linear-gradient(135deg, rgba(88,28,135,.3) 0%, rgba(131,24,67,.3) 100%);
        }

        .why-card--indigo {
            background: linear-gradient(135deg, rgba(30,58,138,.3) 0%, rgba(49,46,129,.3) 100%);
        }

        .why-card--greenblue {
            background: linear-gradient(135deg, rgba(20,83,45,.3) 0%, rgba(30,58,138,.3) 100%);
        }

        .why-card--redyellow {
            background: linear-gradient(135deg, rgba(153,27,27,.3) 0%, rgba(161,98,7,.3) 100%);
        }
    }

    /* Icon pill */
    .why-icon {
        display: inline-block;
        margin-bottom: 1rem; /* mb-4 */
        padding: 1rem; /* p-4 */
        border-radius: 9999px; /* rounded-full */
        background: #FFA3AB; /* primary light */
        color: #FF4A55; /* primary */
    }

        .why-icon .material-icons {
            font-size: 2.875rem;
            line-height: 1;
        }
    /* text-3xl */

    /* Text */
    .why-card__title {
        font-size: 2.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #1F2937;
    }

    .why-card__text {
        color: #6B7280;
    }

    @@media (prefers-color-scheme: dark) {
        .why-card__title {
            color: #F9FAFB;
        }

        .why-card__text {
            color: #9CA3AF;
        }
    }
</style>
