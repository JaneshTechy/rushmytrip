    <!-- ================= LAST MINUTE FLIGHTS ================= -->
    <section class="relative isolate overflow-hidden bg-ink-900 py-10 lg:py-14">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_15%_0%,rgba(255,95,19,.28),transparent)]"></div>
      <div class="mx-auto max-w-7xl px-5">
        <div class="reveal flex items-end justify-between gap-6">
          <div><p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-300">Spontaneous? Perfect.</p><h2 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">Last Minute Flights with 24/7 Human Support</h2></div>
          <div class="hidden gap-3 sm:flex">
            <button id="prevBtn" type="button" aria-label="Previous routes" class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-ink-900 transition hover:bg-brand-500 hover:text-white"><i class="fa-solid fa-arrow-left"></i></button>
            <button id="nextBtn" type="button" aria-label="Next routes" class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-ink-900 transition hover:bg-brand-500 hover:text-white"><i class="fa-solid fa-arrow-right"></i></button>
