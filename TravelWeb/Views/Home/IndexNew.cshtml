
@{
    Layout = "~/Views/Shared/_LayoutMainV1.cshtml";
    ViewData["Title"] = "RushMyTrip | Amazing Flights, Unbelievable Price";
}
<!-- ================= HERO (heading, paragraph, form) ================= -->
    <section id="top" class="relative isolate bg-ink-900 pb-10 pt-8 sm:pt-12 lg:pb-14 z-50">
      <div class="absolute inset-0 -z-10 overflow-hidden">
        <img src="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=2000&q=75" alt="" fetchpriority="high" onerror="this.remove()" class="h-full w-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-b from-ink-900/80 via-ink-900/60 to-ink-900/90"></div>
        <div class="absolute inset-0 bg-[radial-gradient(60%_50%_at_80%_0%,rgba(255,95,19,.35),transparent)]"></div>
      </div>

      <div class="mx-auto max-w-7xl px-5">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-xs font-bold uppercase tracking-[0.25em] text-brand-300 sm:text-sm">Amazing Flights, Unbelievable Price!</p>
          <h1 class="reveal mt-4 text-4xl font-black leading-[1.08] tracking-tight text-white sm:text-6xl" data-delay="80">Hop On-Board and Travel the World</h1>
          <p class="reveal mx-auto mt-5 max-w-xl text-base leading-relaxed text-slate-200 sm:text-lg" data-delay="160">Cheap flight tickets, great deals and a real person to help you 24/7, in English, Spanish and Portuguese.</p>
        </div>

        <!-- SEARCH -->
        <div id="search" class="mt-8 scroll-mt-24 lg:mt-10">
         <form id="searchForm" novalidate data-cities-url="@Url.Content("~/XML/City.xml")" class="reveal rounded-[2rem] bg-white p-4 shadow-[0_40px_80px_-20px_rgba(0,0,0,.55)] sm:p-5" data-delay="120" aria-label="Flight search">
            <div class="flex flex-wrap items-center gap-3 px-1 pb-4">
              <div class="inline-flex rounded-full bg-slate-100 p-1 text-sm font-semibold" role="radiogroup" aria-label="Trip type">
                <label class="cursor-pointer"><input type="radio" name="trip" value="round" checked class="peer sr-only"><span class="block rounded-full px-4 py-2 text-slate-600 transition peer-checked:bg-white peer-checked:text-brand-600 peer-checked:shadow peer-focus-visible:ring-2 peer-focus-visible:ring-brand-500">Round Trip</span></label>
                <label class="cursor-pointer"><input type="radio" name="trip" value="oneway" class="peer sr-only"><span class="block rounded-full px-4 py-2 text-slate-600 transition peer-checked:bg-white peer-checked:text-brand-600 peer-checked:shadow peer-focus-visible:ring-2 peer-focus-visible:ring-brand-500">One Way</span></label>
              </div>
              <label class="relative inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-ink-900">
                <span class="sr-only">Cabin</span>
                <select id="cabin" name="cabin" class="bg-transparent pr-1 focus:outline-none"><option>Economy</option><option>Premium Economy</option><option>Business</option><option>First</option></select>
              </label>
            </div>

            <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-[1.2fr_1.2fr_1fr_1fr_1.1fr_auto]">
              <label class="relative block">
              <span class="field-label">From City</span>
              <span class="field-box"><i class="fa-solid fa-plane-departure text-brand-500"></i>
                <input id="from" name="from" autocomplete="off" placeholder="City or airport code" class="field-input"></span>
              <input type="hidden" id="fromCode" name="fromCode">
              <button id="swapBtn" type="button" aria-label="Swap origin and destination" class="absolute -bottom-[22px] right-5 z-10 flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-brand-600 shadow transition hover:bg-brand-500 hover:text-white md:bottom-auto md:right-[-22px] md:top-1/2 md:-translate-y-1/2 lg:right-[-24px]"><i class="fa-solid fa-right-left"></i></button>
            </label>
              <label class="relative block">
                <span class="field-label">To City</span>
                <span class="field-box"><i class="fa-solid fa-plane-arrival text-brand-500"></i>
                <input id="to" name="to" autocomplete="off" placeholder="City or airport code" class="field-input"></span>
                <input type="hidden" id="toCode" name="toCode">
              </label>
              <label class="block">
                <span class="field-label">Departure</span>
                <span class="field-box"><i class="fa-regular fa-calendar text-brand-500"></i>
                  <input id="depart" name="depart" type="date" class="field-input"></span>
              </label>
              <label id="returnField" class="block transition">
                <span class="field-label">Returning</span>
                <span class="field-box"><i class="fa-regular fa-calendar-check text-brand-500"></i>
                  <input id="return" name="return" type="date" class="field-input"></span>
              </label>
              <div class="relative">
                <span class="field-label">Passengers</span>
                <button id="paxBtn" type="button" aria-expanded="false" aria-controls="paxPanel" class="field-box w-full text-left">
                  <i class="fa-regular fa-user text-brand-500"></i>
                  <span id="paxLabel" class="flex-1 truncate text-sm font-semibold text-ink-900">1 Pax, Economy</span>
                  <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                </button>
                <div id="paxPanel" hidden class="absolute left-0 right-0 top-[calc(100%+8px)] z-30 min-w-[280px] rounded-2xl bg-white p-4 shadow-[0_30px_60px_-15px_rgba(10,15,28,.45)] ring-1 ring-slate-200 lg:left-auto lg:w-80">
                  <div class="space-y-3" id="paxRows"></div>
                  <button id="paxDone" type="button" class="mt-4 w-full rounded-xl bg-ink-900 py-2.5 text-sm font-bold text-white transition hover:bg-brand-500">Done</button>
                </div>
              </div>
              <button type="submit" class="inline-flex items-center justify-center gap-2 self-end rounded-2xl bg-gradient-to-r from-brand-500 to-brand-600 px-8 py-4 text-base font-bold text-white shadow-glow transition hover:-translate-y-0.5 hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 md:col-span-2 lg:col-span-1"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
            </div>

            <p id="formError" role="alert" aria-live="assertive" class="mt-3 hidden rounded-xl bg-red-50 px-4 py-2.5 text-sm font-medium text-red-700"></p>
            <datalist id="airports">
              <option value="New York (NYC)" />
              <option value="Los Angeles (LAX)" />
              <option value="Chicago (ORD)" />
              <option value="Miami (MIA)" />
              <option value="Atlanta (ATL)" />
              <option value="Philadelphia (PHL)" />
              <option value="Honolulu (HNL)" />
              <option value="Buenos Aires (EZE)" />
              <option value="Guadalajara (GDL)" />
              <option value="Lagos (LOS)" />
              <option value="San Francisco (SFO)" />
              <option value="Las Vegas (LAS)" />
              <option value="Seattle (SEA)" />
              <option value="Orlando (MCO)" />
              <option value="Denver (DEN)" />
              <option value="London (LHR)" />
              <option value="Paris (CDG)" />
              <option value="Mexico City (MEX)" />
            </datalist>
          </form>
        </div>
      </div>
    </section>

    <!-- ================= CERTIFIED & TRUSTED ================= -->
