      <div class="mx-auto grid max-w-7xl gap-8 px-5 lg:grid-cols-[0.7fr_1.3fr] lg:gap-14">
        <div class="reveal lg:sticky lg:top-24 lg:self-start">
          <p class="eyebrow">Why book with us</p>
          <h2 class="h2">What We Offer</h2>
          <a href="tel:+1-800-231-7119" class="mt-5 inline-flex items-center gap-2 font-bold text-brand-600 hover:underline"><i class="fa-solid fa-phone-volume"></i> +1-800-231-7119</a>
        </div>
        <ol class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
          <li class="reveal flex gap-4 border-t-2 border-slate-200 pt-5 transition hover:border-brand-500">
            <span class="text-3xl font-black leading-none text-brand-200">01</span>
            <div><h3 class="flex items-center gap-2 text-lg font-bold text-ink-900"><i class="fa-solid fa-ticket text-brand-500"></i>Cheap Flight Tickets</h3><p class="mt-2 text-sm leading-relaxed text-slate-600">Book affordable flights at guaranteed low prices with exclusive travel deals.</p></div>
          </li>
          <li class="reveal flex gap-4 border-t-2 border-slate-200 pt-5 transition hover:border-brand-500" data-delay="80">
