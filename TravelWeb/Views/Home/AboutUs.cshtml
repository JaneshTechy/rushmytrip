@{
    Layout = "~/Views/Shared/_LayoutMainV1.cshtml";
    ViewData["Title"] = "About Us | RushMyTrip";
}

<!-- ================= PAGE HERO ================= -->
<section class="relative isolate overflow-hidden bg-ink-900 py-14 sm:py-20">
  <div class="absolute inset-0 -z-10">
    <img src="https://images.unsplash.com/photo-1464037866556-6812c9d1c72e?auto=format&fit=crop&w=2000&q=75" alt="" fetchpriority="high" onerror="this.remove()" class="h-full w-full object-cover opacity-40">
    <div class="absolute inset-0 bg-gradient-to-b from-ink-900/70 via-ink-900/80 to-ink-900"></div>
    <div class="absolute inset-0 bg-[radial-gradient(55%_60%_at_85%_0%,rgba(255,95,19,.35),transparent)]"></div>
  </div>
  <div class="mx-auto max-w-7xl px-5 text-center">
    <nav aria-label="Breadcrumb" class="reveal">
      <ol class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold text-slate-200 backdrop-blur">
        <li><a href="/" class="transition hover:text-brand-300">Home</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-[10px] text-brand-400"></i></li>
        <li class="text-white" aria-current="page">About Us</li>
      </ol>
    </nav>
    <h1 class="reveal mt-5 text-4xl font-black tracking-tight text-white sm:text-6xl" data-delay="80">About RushMyTrip</h1>
    <p class="reveal mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg" data-delay="160">Real people, honest fares and help that doesn't clock out. Here's the team behind your next trip.</p>
  </div>
</section>

<!-- ================= OUR STORY ================= -->
<section class="py-12 lg:py-16">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div class="reveal">
      <p class="eyebrow">Our Story</p>
      <h2 class="h2">Travel booking should feel like talking to a friend who knows the airlines</h2>
      <p class="mt-5 leading-relaxed text-slate-600">RushMyTrip started with a simple frustration: booking a flight online often means endless tabs, confusing fare rules and nobody to ask when plans change. We wanted to bring back the part of travel planning that actually helps, a real person on the other end of the line.</p>
      <p class="mt-4 leading-relaxed text-slate-600">Today we combine an easy online search with a team of experienced travel agents. You can look up routes and fares on your own, then call us whenever you want a second opinion, a better connection or someone to sort out a last-minute change.</p>
      <p class="mt-4 leading-relaxed text-slate-600">Whether it's a family visit, a work trip or a long-awaited holiday, our job is the same: get you the right seat at a fair price, and stay with you until you land.</p>

      <div class="mt-8 grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl bg-brand-50 p-4 ring-1 ring-brand-100">
          <i class="fa-solid fa-headset text-xl text-brand-600"></i>
          <p class="mt-2 text-lg font-black text-ink-900">24/7</p>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Human support</p>
        </div>
        <div class="rounded-2xl bg-brand-50 p-4 ring-1 ring-brand-100">
          <i class="fa-solid fa-language text-xl text-brand-600"></i>
          <p class="mt-2 text-lg font-black text-ink-900">3 Languages</p>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">EN · ES · PT</p>
        </div>
        
      </div>
    </div>

    <div class="reveal relative" data-delay="120">
      <div class="absolute -left-6 -top-6 -z-10 h-40 w-40 rounded-full bg-brand-500/20 blur-3xl"></div>
      <div class="overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-400 to-brand-700 shadow-card">
        <img src="https://images.unsplash.com/photo-1488085061387-422e29b40080?auto=format&fit=crop&w=1200&q=75" alt="Traveler looking out at an airport runway" loading="lazy" onerror="this.remove()" class="aspect-[4/5] h-full w-full object-cover">
      </div>
      <div class="absolute -bottom-6 left-6 right-6 flex items-center gap-4 rounded-2xl bg-white p-4 shadow-card ring-1 ring-slate-200 sm:left-auto sm:right-[-1.5rem] sm:w-72">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-ink-900 text-white"><i class="fa-solid fa-phone-volume"></i></span>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Talk to an agent</p>
          <a href="tel:+1-855-510-4060" class="text-base font-extrabold text-ink-900 hover:text-brand-600">+1-855-510-4060</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= WHO WE ARE / WHAT WE DO ================= -->
<section class="bg-slate-50 py-12 lg:py-16">
  <div class="mx-auto grid max-w-7xl gap-6 px-5 lg:grid-cols-2">
    <div class="reveal rounded-3xl bg-white p-7 shadow-card ring-1 ring-slate-200/70 sm:p-9">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-lg text-brand-600"><i class="fa-solid fa-users"></i></span>
      <h2 class="mt-5 text-2xl font-black tracking-tight text-ink-900">Who we are</h2>
      <p class="mt-3 leading-relaxed text-slate-600">We're a travel agency made up of booking specialists who spend their day working with airline schedules, fare classes and route options. That experience is what we put to work for every caller, so you don't have to become an expert in airline pricing just to plan a trip.</p>
      <ul class="mt-6 space-y-3 text-sm text-ink-900">
        <li class="flex items-start gap-3"><i class="fa-solid fa-circle-check mt-0.5 text-brand-500"></i>Experienced agents who handle domestic and international itineraries</li>
        <li class="flex items-start gap-3"><i class="fa-solid fa-circle-check mt-0.5 text-brand-500"></i>Support in English, Spanish and Portuguese</li>
        <li class="flex items-start gap-3"><i class="fa-solid fa-circle-check mt-0.5 text-brand-500"></i>Recognized by leading travel industry associations</li>
      </ul>
    </div>

    <div class="reveal rounded-3xl bg-gradient-to-br from-ink-900 to-ink-700 p-7 text-white shadow-card sm:p-9" data-delay="100">
      <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-lg text-brand-300"><i class="fa-solid fa-plane-up"></i></span>
      <h2 class="mt-5 text-2xl font-black tracking-tight">What we do</h2>
      <p class="mt-3 leading-relaxed text-slate-300">We help travelers find and book flights that fit their dates, budget and comfort. Beyond the booking itself, we're the people you call when something needs fixing.</p>
      <ul class="mt-6 grid gap-3 text-sm sm:grid-cols-2">
        <li class="flex items-center gap-3 rounded-xl bg-white/5 px-4 py-3 ring-1 ring-white/10"><i class="fa-solid fa-ticket text-brand-400"></i>New flight bookings</li>
        <li class="flex items-center gap-3 rounded-xl bg-white/5 px-4 py-3 ring-1 ring-white/10"><i class="fa-solid fa-calendar-days text-brand-400"></i>Date &amp; flight changes</li>
        <li class="flex items-center gap-3 rounded-xl bg-white/5 px-4 py-3 ring-1 ring-white/10"><i class="fa-solid fa-chair text-brand-400"></i>Seat selection help</li>
        <li class="flex items-center gap-3 rounded-xl bg-white/5 px-4 py-3 ring-1 ring-white/10"><i class="fa-solid fa-id-card text-brand-400"></i>Check-in assistance</li>
        <li class="flex items-center gap-3 rounded-xl bg-white/5 px-4 py-3 ring-1 ring-white/10"><i class="fa-solid fa-bolt text-brand-400"></i>Last-minute trips</li>
        <li class="flex items-center gap-3 rounded-xl bg-white/5 px-4 py-3 ring-1 ring-white/10"><i class="fa-solid fa-people-group text-brand-400"></i>Family &amp; group travel</li>
      </ul>
    </div>
  </div>
</section>

<!-- ================= HOW IT WORKS ================= -->
<section class="py-12 lg:py-16">
  <div class="mx-auto max-w-7xl px-5">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">How it works</p>
      <h2 class="h2">From first search to safe landing</h2>
      <p class="mt-3 text-slate-600">Book online, over the phone, or a bit of both. Either way, the same team is behind you.</p>
    </div>
    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <li class="reveal relative rounded-3xl bg-white p-6 ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-card">
        <span class="text-4xl font-black leading-none text-brand-200">01</span>
        <h3 class="mt-4 text-lg font-bold text-ink-900">Search your route</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Enter where you're flying from, where you're headed and your dates to see what's available.</p>
      </li>
      <li class="reveal relative rounded-3xl bg-white p-6 ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-card" data-delay="80">
        <span class="text-4xl font-black leading-none text-brand-200">02</span>
        <h3 class="mt-4 text-lg font-bold text-ink-900">Talk it through</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Call an agent to compare options, ask about baggage or find a smarter connection.</p>
      </li>
      <li class="reveal relative rounded-3xl bg-white p-6 ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-card" data-delay="160">
        <span class="text-4xl font-black leading-none text-brand-200">03</span>
        <h3 class="mt-4 text-lg font-bold text-ink-900">Book securely</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Confirm your trip with secure payment and receive your booking details by email.</p>
      </li>
      <li class="reveal relative rounded-3xl bg-white p-6 ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-card" data-delay="240">
        <span class="text-4xl font-black leading-none text-brand-200">04</span>
        <h3 class="mt-4 text-lg font-bold text-ink-900">We stay with you</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Plans change. Reach us any time of day, even from the airport, and we'll help sort it out.</p>
      </li>
    </ol>
  </div>
</section>

<!-- ================= OUR VALUES ================= -->
<section class="relative isolate overflow-hidden bg-ink-900 py-12 lg:py-16">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_10%_0%,rgba(255,95,19,.28),transparent)]"></div>
  <div class="mx-auto max-w-7xl px-5">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-300">What we stand for</p>
      <h2 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">The promises behind every booking</h2>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <div class="reveal rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 transition hover:bg-white/10">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-500 text-white"><i class="fa-solid fa-scale-balanced"></i></span>
        <h3 class="mt-5 font-bold text-white">Straight answers</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-300">We explain fare rules, change options and baggage in plain language before you pay.</p>
      </div>
      <div class="reveal rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 transition hover:bg-white/10" data-delay="80">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-500 text-white"><i class="fa-solid fa-hand-holding-dollar"></i></span>
        <h3 class="mt-5 font-bold text-white">Value that counts</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-300">A good deal isn't just a low number. It's the right routing, timing and price together.</p>
      </div>
      <div class="reveal rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 transition hover:bg-white/10" data-delay="160">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-500 text-white"><i class="fa-solid fa-heart"></i></span>
        <h3 class="mt-5 font-bold text-white">Care under pressure</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-300">Emergencies and missed connections happen. That's exactly when we pick up the phone.</p>
      </div>
      <div class="reveal rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 transition hover:bg-white/10" data-delay="240">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-500 text-white"><i class="fa-solid fa-lock"></i></span>
        <h3 class="mt-5 font-bold text-white">Protected payments</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-300">Your card details are processed through PCI-compliant systems built for secure transactions.</p>
      </div>
    </div>
  </div>
</section>



<!-- ================= MISSION + CTA ================= -->
<section class="pb-14 lg:pb-20">
  <div class="mx-auto max-w-7xl px-5">
    <div class="reveal relative isolate grid items-center gap-8 overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-500 to-brand-700 p-7 text-white shadow-glow sm:p-10 lg:grid-cols-[1.3fr_0.7fr]">
      <div class="absolute -right-16 -top-16 -z-10 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-100">Our mission</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">Make every trip easier to plan, book and take</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-brand-50">We believe great travel help shouldn't be reserved for first class. Every traveler deserves fair fares, clear information and someone who answers when it matters. That's the standard we hold ourselves to on every call and every booking.</p>
      </div>
      <div class="flex flex-col gap-3">
        <a href="/#search" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-6 py-4 font-bold text-brand-700 transition hover:-translate-y-0.5 hover:shadow-lg"><i class="fa-solid fa-magnifying-glass"></i> Search flights</a>
        <a href="tel:+1-855-510-4060" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-ink-900 px-6 py-4 font-bold text-white transition hover:-translate-y-0.5 hover:bg-ink-700"><i class="fa-solid fa-phone-volume"></i> +1-855-510-4060</a>
        <p class="text-center text-xs text-brand-100">Available 24/7 in English, Spanish &amp; Portuguese</p>
      </div>
    </div>
  </div>
</section>
