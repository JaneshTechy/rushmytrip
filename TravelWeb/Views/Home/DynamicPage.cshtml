@model TravelWeb.Models.PageModel

@{
    var seo = ViewBag.Seo as SeoEntities;

    ViewData["Title"] = Html.Raw(seo?.MetaTitle ?? Model.Title ?? "").ToString();
    ViewData["Description"] = Html.Raw(seo?.MetaDescription ?? "").ToString();

    ViewData["OgImage"] =  !string.IsNullOrEmpty(Model.AltImageText)
        ? Model.AltImageText
        : Model.Title;

    ViewData["OgImageAlt"] = !string.IsNullOrEmpty(Model.AltImageText)
        ? Model.AltImageText
        : Model.Title;
}

@section MetaTags {
    <title>@Html.Raw(seo?.MetaTitle ?? Model.Title ?? "RushMyFlight")</title>
    <meta name="description" content="@Html.Raw(seo?.MetaDescription ?? "")" />
    <meta name="keywords" content="@Html.Raw(seo?.MetaKeywords ?? "")" />
           <meta property="og:image:url" content="@ViewData["OgImage"]" />
    <meta property="og:image" content="@ViewData["OgImage"]" />
    <meta property="og:image:alt" content="@ViewData["OgImageAlt"]" />
}

<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

<style>

    body {
        font-family: 'Roboto',sans-serif;
        margin: 0;
        background: #f8f9fa;
        color: #212529;
    }

    /* Hero Section */

    .hero {
        background: linear-gradient(to right,#1e3a8a,#1d4ed8);
        color: white;
        padding: 9px 20px;
        text-align: center;
    }

        .hero h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .hero .updated {
            font-size: 13px;
            opacity: 0.85;
        }

    /* Container */

    .container {
        max-width: 820px;
        margin: auto;
        padding: 40px 20px;
    }

    /* Image */

    

    /* CMS Content */

    .content {
        font-size: 15px;
        line-height: 1.7;
    }

        .content h1 {
            color: #1e3a8a;
            font-size: 26px;
        }

        .content h2 {
            color: #1d4ed8;
            font-size: 22px;
        }

        .content a {
            color: #2563eb;
        }

            .content a:hover {
                color: #1e40af;
            }

        .content p {
            margin-bottom: 14px;
        }

    .feature-image {
        margin-bottom: 25px;
        border-radius: 10px;
        overflow: hidden;
        /* box-shadow: 0 6px 20px rgba(0,0,0,0.12); */
        text-align: center;
        /* background: #fff; */
        padding: 10px;
    }

        .feature-image img {
            width: auto;
            max-width: 100%;
            height: auto;
            max-height: 360px;
            object-fit: contain;
            border-radius: 8px;
        }

    .hero {
        background: linear-gradient(to right,#1e3a8a,#1d4ed8);
        color: white;
        padding: 35px 20px;
        text-align: center;
    }

        .hero h1 {
            font-size: 30px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .faq-section {
        margin-top: 40px;
    }

    .faq-item {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        margin-bottom: 12px;
        overflow: hidden;
        background: #fff;
    }

    .faq-question {
        width: 100%;
        padding: 16px 20px;
        border: none;
        background: #f8fafc;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
        cursor: pointer;
        text-align: left;
    }

    .faq-question:hover {
        background: #eef2ff;
    }

    .faq-answer {
        display: none;
        padding: 18px 20px;
        border-top: 1px solid #eee;
        background: white;
        line-height: 1.7;
    }

    .faq-item.active .faq-answer {
        display: block;
    }

    .faq-item.active .faq-icon {
        content: "-";
    }
</style>



<section class="hero">

    <h1>@Model.Title</h1>

    <div class="updated">
       
        Updated on @Model.UpdatedOn?.ToString("MMM dd, yyyy")
    </div>

</section>


<main class="container">

    @if (!string.IsNullOrWhiteSpace(Model.FeatureImageUrl))
    {
        <div class="feature-image">
            <img src="@Url.Content(Model.FeatureImageUrl)"
                 alt="@Model.AltImageText"
                 onerror="this.style.display='none';" />
        </div>
    }

    <div class="content">
        @Html.Raw(Model.Content)
    </div>
    @if (Model.FAQs?.Any() == true)
{
    <section class="faq-section mt-5">
        <h2 class="faq-title">Frequently Asked Questions</h2>

        @foreach (var faq in Model.FAQs)
        {
            <div class="faq-item">
                <button class="faq-question" onclick="toggleFaq(this)">
                    <span>@faq.Question</span>
                    <span class="faq-icon">+</span>
                </button>

                <div class="faq-answer">
                    @Html.Raw(faq.Answer)
                </div>
            </div>
        }
    </section>
}
</main>
<script>
    function toggleFaq(button) {
        const item = button.closest('.faq-item');
        item.classList.toggle('active');

        const icon = button.querySelector('.faq-icon');
        icon.textContent = item.classList.contains('active') ? '-' : '+';
    }
</script>
@if (Model.FAQs?.Any() == true)
{
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            @for (int i = 0; i < Model.FAQs.Count; i++)
            {
                var faq = Model.FAQs[i];

                <text>
                {
                    "@@type": "Question",
                    "name": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(faq.Question))",
                    "acceptedAnswer": {
                        "@@type": "Answer",
                        "text": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(System.Text.RegularExpressions.Regex.Replace(faq.Answer ?? "", "<.*?>", "")))"
                    }
                }@(i < Model.FAQs.Count - 1 ? "," : "")
                </text>
            }
        ]
    }
    </script>
}