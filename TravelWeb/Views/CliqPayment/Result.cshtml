@model TravelWeb.Models.CliqPaymentResponse
@{
    ViewData["Title"] = "Payment Result";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #f3f5f9;
        font-family: Inter, system-ui, Segoe UI, Roboto, Arial, sans-serif;
    }

    .result-wrap {
        max-width: 720px;
        margin: 56px auto;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 28px rgba(0,0,0,.12);
        overflow: hidden;
    }

    .result-head {
        padding: 18px 22px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .result-head h2 {
            margin: 0;
            font-weight: 700;
            color: #1e293b;
            font-size: 1.2rem;
        }

    .status-badge {
        margin-left: auto;
    }

    .result-body {
        padding: 22px;
    }

    .receipt {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 16px;
        background: #fafafa;
    }

        .receipt h5 {
            margin: 0 0 10px 0;
            font-weight: 600;
            color: #111827;
        }

    .kv {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #e5e7eb;
    }

        .kv:last-child {
            border-bottom: 0;
        }

        .kv .k {
            color: #6b7280;
        }

        .kv .v {
            color: #111827;
            font-weight: 500;
        }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 16px;
    }

    details summary {
        cursor: pointer;
    }

    pre.raw {
        background: #0f172a;
        color: #e2e8f0;
        border-radius: 10px;
        padding: 14px;
        overflow: auto;
        font-size: .85rem;
        margin-top: 10px;
    }
</style>

<div class="result-wrap" role="region" aria-labelledby="resTitle">
    <div class="result-head">
        <img src="@Url.Content("~/img/brands/cliq-payments-inline.png")" alt="Cliq Payments" height="20" />
        <h2 id="resTitle">Payment Result</h2>

        @if (Model.Approved)
        {
            <span class="badge text-bg-success status-badge">Approved</span>
        }
        else
        {
            <span class="badge text-bg-danger status-badge">Declined / Error</span>
        }
    </div>

    <div class="result-body">
        @if (Model.Approved)
        {
            <div class="alert alert-success d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                <div>Approved — Transaction ID: @Model.TransactionId</div>
            </div>
        }
        else
        {
            <div class="alert alert-danger d-flex align-items-center" role="alert">
                <i class="bi bi-x-circle me-2"></i>
                <div>Declined or Error — @Model.Message</div>
            </div>
        }

        <div class="receipt mt-3" aria-label="Receipt summary">
            <h5>Summary</h5>
            <div class="kv"><span class="k">Status</span><span class="v">@((Model.Approved ? "Approved" : "Declined / Error"))</span></div>
            <div class="kv"><span class="k">Transaction ID</span><span class="v">@Model.TransactionId</span></div>
            <div class="kv"><span class="k">Message</span><span class="v">@Model.Message</span></div>
        </div>

        <div class="actions">
            <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print</button>
            @if (Model.Approved)
            {
                <a href="/Orders" class="btn btn-primary">View orders</a>
            }
            else
            {
                <a href="/Payment" class="btn btn-primary">Try again</a>
            }
            <a href="/" class="btn btn-light">Home</a>
        </div>

        <details class="mt-3">
            <summary class="text-muted">Technical response</summary>
            <pre class="raw mb-0">@Model.Raw</pre>
        </details>
    </div>
</div>
