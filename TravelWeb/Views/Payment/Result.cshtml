@{
    ViewData["Title"] = "Payment Result";
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

<style>
    body {
        background: linear-gradient(135deg, #f3f8ff, #e8f0ff);
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 10px;
    }

    .result-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
        max-width: 520px;
        width: 100%;
        padding: 40px 35px;
        text-align: center;
        transition: all 0.3s ease;
    }

        .result-card:hover {
            box-shadow: 0 10px 36px rgba(0, 0, 0, 0.18);
            transform: translateY(-3px);
        }

    .result-image {
        width: 274px;
        height: 130px;
        object-fit: contain;
        margin-bottom: 20px;
    }

    h2 {
        font-weight: 700;
        margin-bottom: 12px;
    }

    .success h2 {
        color: #16a34a;
    }

    .failed h2 {
        color: #dc2626;
    }

    .details {
        text-align: left;
        background: #f8fafc;
        border-radius: 12px;
        padding: 18px;
        margin-top: 18px;
        font-size: 0.95rem;
    }

        .details p {
            margin: 4px 0;
        }

    .footer-buttons {
        margin-top: 25px;
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .btn-custom {
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-custom:hover {
            transform: scale(1.05);
        }

    .travel-bg {
        position: absolute;
        inset: 0;
        background: url('https://cdn.pixabay.com/photo/2017/01/20/00/30/travel-1996347_1280.jpg') center/cover no-repeat;
        filter: blur(20px) opacity(0.2);
        z-index: -1;
    }
</style>

<div class="travel-bg"></div>

<div class="result-card @(ViewBag.IsSuccess == true ? "success" : "failed")">
    @if (ViewBag.IsSuccess == true)
    {
        <img class="result-image" src="https://www.rushmyflight.com/img/RMFLogo.png" alt="Success" />
        <h2>Payment Successful 🎉</h2>
        <p class="text-muted mb-3">Thank you! Your payment was processed successfully.</p>

        <div class="details">
            <p><strong>Transaction ID:</strong> @ViewBag.TransactionId</p>
            <p><strong>Auth Code:</strong> @ViewBag.AuthCode</p>
            <p><strong>Invoice:</strong> @ViewBag.Invoice</p>
            <p><strong>Message:</strong> @ViewBag.Message</p>
            <p><strong>AVS:</strong> @ViewBag.AVS</p>
            <p><strong>CVV:</strong> @ViewBag.CVV</p>
        </div>

        <div class="footer-buttons">
            @*             <a href="/" class="btn btn-success btn-custom"><i class="bi bi-house-door"></i> Home</a>
 *@            <a href="/Payment" class="btn btn-outline-success btn-custom"><i class="bi bi-arrow-left"></i> Make Another</a>
        </div>
    }
    else
    {
        <img class="result-image" src="https://www.rushmyflight.com/img/RMFLogo.png" alt="Failed" />
        <h2>Payment Failed 😞</h2>
        <p class="text-muted mb-3">We couldn’t process your transaction. Please try again.</p>

        <div class="details">
            <p><strong>Invoice:</strong> @ViewBag.Invoice</p>
            <p><strong>Message:</strong> @ViewBag.Message</p>
            <p><strong>AVS:</strong> @ViewBag.AVS</p>
            <p><strong>CVV:</strong> @ViewBag.CVV</p>
        </div>

        <div class="footer-buttons">
            <a href="/Payment" class="btn btn-danger btn-custom"><i class="bi bi-arrow-repeat"></i> Try Again</a>
            <a href="/" class="btn btn-outline-danger btn-custom"><i class="bi bi-house-door"></i> Home</a>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.js"></script>
