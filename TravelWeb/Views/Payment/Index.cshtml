@model TravelWeb.Models.PaymentViewModel
@using Microsoft.Extensions.Options
@inject IOptions<TravelWeb.Models.PaymentSettings> Opts

@{

    ViewData["Title"] = "Secure Payment";
    var accounts = Opts.Value.Accounts;
    var publicKeys = accounts.ToDictionary(
        a => a.Key,
        a => new { apiLoginId = a.Value.AcceptJsApiLoginId, clientKey = a.Value.AcceptJsClientKey,useSandbox = a.Value.UseSandbox
 });

 var requested = !string.IsNullOrWhiteSpace(Model.Account)
    ? Model.Account
    : Context.Request.Query["account"].ToString();
    var currentKey = accounts.ContainsKey(requested ?? "") ? requested : Opts.Value.DefaultAccount;

    var current = accounts[currentKey];
    var acceptJsUrl = current.UseSandbox
        ? "https://jstest.authorize.net/v1/Accept.js"
        : "https://js.authorize.net/v1/Accept.js";
}


