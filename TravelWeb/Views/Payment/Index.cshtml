<script>
    function wireCustomDatalist(inputId, datalistId, panelId) {
      const input = document.getElementById(inputId);
      const datalist = document.getElementById(datalistId);
      const panel = document.getElementById(panelId);
      const wrap = panel.parentElement;

      let activeIndex = -1;

      function getAllOptions() {
        return Array.from(datalist.options).map(o => o.value);
      }

      function render(list) {
        panel.innerHTML = '';
        const frag = document.createDocumentFragment();
        list.forEach((val, i) => {
          const div = document.createElement('div');
          div.className = 'datalist-item';
          div.textContent = val;

          if (i === activeIndex) div.classList.add('active');

          div.addEventListener('mousedown', e => {
            e.preventDefault();
            e.stopPropagation();

            input._suppressUpdate = true;
            input.value = val;
            hide();

            setTimeout(() => {
              input.dispatchEvent(new Event('input', { bubbles: true }));
              input._suppressUpdate = false;
            }, 100);
          });

          frag.appendChild(div);
        });
        panel.appendChild(frag);
      }

      function show() {
        wrap.classList.add('open');
        panel.style.display = 'block';
      }

      function hide() {
        wrap.classList.remove('open');
        panel.style.display = 'none';
        activeIndex = -1;
      }

      function update() {
        const q = input.value.trim().toLowerCase();
        const all = getAllOptions();
        const filtered = q ? all.filter(v => v.toLowerCase().includes(q)) : all;
        render(filtered);
        if (filtered.length) show(); else hide();
      }

      input.addEventListener('focus', update);

      input.addEventListener('input', () => {
        if (input._suppressUpdate) return;
        update();
      });

      input.addEventListener('keydown', e => {
        const items = Array.from(panel.querySelectorAll('.datalist-item'));
        if (!items.length) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeIndex = (activeIndex + 1) % items.length;
          render(items.map(i => i.textContent));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeIndex = (activeIndex - 1 + items.length) % items.length;
          render(items.map(i => i.textContent));
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeIndex >= 0 && activeIndex < items.length) {
            const val = items[activeIndex].textContent;
            input._suppressUpdate = true;
            input.value = val;
            hide();
            setTimeout(() => {
              input.dispatchEvent(new Event('input', { bubbles: true }));
              input._suppressUpdate = false;
            }, 100);
          } else {
            hide();
          }
        } else if (e.key === 'Escape') {
          hide();
        }
      });

      document.addEventListener('mousedown', e => {
        if (!wrap.contains(e.target)) hide();
      });

      const resizeObserver = new ResizeObserver(() => {
        panel.style.minWidth = input.offsetWidth + 'px';
      });
      resizeObserver.observe(input);
    }

    document.addEventListener('DOMContentLoaded', () => {
      wireCustomDatalist('Country', 'CountryList', 'CountryPanel');
      wireCustomDatalist('State', 'StateList', 'StatePanel');
      wireCustomDatalist('City', 'CityList', 'CityPanel');
    });
</script>


