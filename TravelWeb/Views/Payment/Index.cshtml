    <script>
    // ----- Authorize.net Tokenization -----
    const ACCEPT_ACCOUNTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(publicKeys));

    function luhn(card) {
        let sum = 0, alt = false;
        for (let i = card.length - 1; i >= 0; i--) {
            let n = parseInt(card[i], 10);
            if (alt) { n *= 2; if (n > 9) n -= 9; }
            sum += n; alt = !alt;
        }
        return (sum % 10) === 0;
    }

    document.getElementById('paymentForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const form = e.target;

        const cardNumber = document.getElementById('cardNumber').value.replace(/\s+/g, '');
        const expMonth = document.getElementById('expMonth').value;
        const expYear = document.getElementById('expYear').value;
        const cardCode = document.getElementById('cardCode').value;

        if (!/^\d{13,19}$/.test(cardNumber) || !luhn(cardNumber)) { alert('Invalid card number.'); return; }
        const m = parseInt(expMonth, 10), y = parseInt(expYear, 10);
        if (!(m >= 1 && m <= 12) || !(y >= 2025 && y <= 2100)) { alert('Invalid expiration date.'); return; }
        if (!/^\d{3,4}$/.test(cardCode)) { alert('Invalid CVV.'); return; }

        const acct = ACCEPT_ACCOUNTS[document.querySelector('[name="Account"]').value];
        if (!acct) { alert('Please select a payment account.'); return; }

        const authData = { clientKey: acct.clientKey, apiLoginID: acct.apiLoginId };
        const cardData = { cardNumber, month: ("0" + m).slice(-2), year: y.toString(), cardCode };

        Accept.dispatchData({ authData, cardData }, function (resp) {
            if (resp.messages.resultCode === "Error") {
                const msg = (resp.messages.message || []).map(m => `${m.code}: ${m.text}`).join("; ");
                alert("Tokenization error: " + msg);
                return;
            }
            if (!resp.opaqueData || !resp.opaqueData.dataValue) {
                alert("Tokenization failed. Please try again.");
                return;
            }
             
            document.querySelector('input[name="OpaqueDataDescriptor"]').value = resp.opaqueData.dataDescriptor;
            document.querySelector('input[name="OpaqueDataValue"]').value = resp.opaqueData.dataValue;

            document.getElementById('cardNumber').value = '';
            document.getElementById('cardCode').value = '';

            form.submit();
        });
    });

    document.getElementById('Account').addEventListener('change', function () {
    location.href = this.dataset.url + '?account=' + encodeURIComponent(this.value);
});
</script>
