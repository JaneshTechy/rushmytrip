<style>
    /* Wrapper to anchor the custom panel */
    .input-with-datalist {
        position: relative; /* anchors the popup */
    }

    /* The custom suggestion panel */
    .datalist-panel {
        position: absolute;
        left: 0;
        right: 0;
        z-index: 1000;
        margin-top: 2px;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.12);
        overflow-y: auto;
        /* Show only ~4 items; tune item height or this value as needed */
        max-height: calc(4 * 40px);
        display: none; /* toggled via JS */
    }

    /* Each visible option row */
    .datalist-item {
        padding: 10px 12px;
        font-size: 0.95rem;
        line-height: 20px; /* ~40px total row area including padding */
        cursor: pointer;
        color: #111827;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        /* Hover/active states */
        .datalist-item:hover,
        .datalist-item.active {
            background: #f3f4f6;
        }

    /* Make the input visually connect with the popup when open */
    .input-with-datalist.open input[list] {
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }

        /* Optional: align with your existing focus look */
        .input-with-datalist.open input[list]:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.15rem rgba(13,110,253,0.25);
        }

