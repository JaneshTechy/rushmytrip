        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

          const payBtn = document.getElementById("payBtn");
          const alertBox = document.createElement("div");
          alertBox.id = "alertBox";
          document.body.prepend(alertBox);

          function showError(message) {
            alertBox.innerHTML = `<div class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded mb-4 max-w-4xl mx-auto"><strong>Error:</strong> ${message}</div>`;
          }
          function showSuccess(message) {
            alertBox.innerHTML = `<div class="bg-green-100 border border-green-300 text-green-800 px-4 py-3 rounded mb-4 max-w-4xl mx-auto"><strong>Success:</strong> ${message}</div>`;
          }
          function markInvalid(el) {
            if (!el) return;
            el.classList.add("border", "border-red-500");
            setTimeout(()=> el.classList.remove("border","border-red-500"), 3000);
          }

          payBtn.addEventListener("click", async function (e) {
            e.preventDefault();
            alertBox.innerHTML = "";
            debugger
            // Build payload from IDs (these IDs MUST exist in DOM)
            const payload = {
              ccNumber: (document.getElementById("card-number")?.value || "").replace(/\s+/g,''),
              ccExp: (document.getElementById("expiry-date")?.value || "").replace(/\D/g,''),
              cvv: document.getElementById("cvv")?.value || "",
              amount: parseFloat(document.getElementById("amount")?.value || "0") || 0,
              firstName: document.getElementById("firstName")?.value.trim() || "",
              lastName: document.getElementById("lastName")?.value.trim() || "",
              address1: document.getElementById("address1")?.value.trim() || "",
              city: document.getElementById("city")?.value.trim() || "",
              state: document.getElementById("state")?.value.trim() || "",
              zip: document.getElementById("zip")?.value.trim() || "",
              country: document.getElementById("country")?.value.trim() || "",
              email: document.getElementById("email")?.value.trim() || "",
              orderId: document.getElementById("orderId")?.value.trim() || ('ORD'+Date.now()),
              paymentToken: "",
              googlePayData: "",
              applePayData: "",
              customerVaultId: "",
              customerReceipt: true
            };

            // DEBUG: show payload in console (mask card for safety)
            const debugPayload = { ...payload, ccNumber: payload.ccNumber ? '****'+payload.ccNumber.slice(-4) : '' };
            console.log("DEBUG: payload ->", debugPayload);

            // Simple required checks
            const req = ["firstName","lastName","email","address1","city","state","zip","country","orderId","ccNumber","ccExp","cvv","amount"];
            const missing = req.filter(k => !payload[k] || payload[k].toString().trim()==="");
            if (missing.length) {
              missing.forEach(m => {
                const id = m === "ccNumber" ? "card-number" : (m === "ccExp" ? "expiry-date" : m);
                markInvalid(document.getElementById(id));
              });
              showError("Please fill required fields: " + missing.join(", "));
              return;
            }

            // quick format checks
            if (payload.ccNumber.length < 12) { markInvalid(document.getElementById("card-number")); showError("Invalid card number"); return; }
            if (payload.ccExp.length !== 4) { markInvalid(document.getElementById("expiry-date")); showError("Expiry must be MMYY"); return; }
            if (payload.cvv.length < 3) { markInvalid(document.getElementById("cvv")); showError("Invalid CVV"); return; }
            if (isNaN(payload.amount) || payload.amount <= 0) { markInvalid(document.getElementById("amount")); showError("Invalid amount"); return; }

            // disable button
            payBtn.disabled = true;
            const old = payBtn.innerHTML;
            payBtn.innerHTML = "Processing...";

            try {
              const resp = await fetch("/sale", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
              });

              const data = await resp.json().catch(()=>null);
              console.log("DEBUG: response ->", data);

              if (!resp.ok) {
                showError(`Server error ${resp.status} ${data ? JSON.stringify(data) : ""}`);
              } else if (data && (data.response === "1" || data.response === 1)) {
                showSuccess(`Payment successful. Txn: ${data.transactionid || '—'}`);
              } else {
                showError(data?.responsetext || JSON.stringify(data) || "Payment failed");
              }
            } catch (err) {
              showError("Network error: " + err.message);
              console.error(err);
            } finally {
              payBtn.disabled = false;
              payBtn.innerHTML = old;
            }
          });

        });
    </script>
</body>
</html> *@



