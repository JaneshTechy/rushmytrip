                    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Complete your transaction by providing the following information.</p>
                </div>
                <div class="flex-grow">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <input class="w-full bg-gray-100 dark:bg-gray-900 border-transparent rounded-full px-5 py-3 text-gray-700 dark:text-gray-200 placeholder-gray-500 dark:placeholder-gray-400 focus:ring-primary focus:border-primary" placeholder="Amount" type="text" id="amount" />
                        <input class="w-full bg-gray-100 dark:bg-gray-900 border-transparent rounded-full px-5 py-3 text-gray-700 dark:text-gray-200 placeholder-gray-500 dark:placeholder-gray-400 focus:ring-primary focus:border-primary" placeholder="Invoice ID" type="text" id="orderId" />
                    </div>
                    <div>
                        <!-- Card information header + logos (updated) -->
                        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Card information</h3>

