                                </svg>

                                <!-- Mastercard (two overlapping circles) -->
                                <svg class="h-6 w-auto" viewBox="0 0 36 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mastercard">
                                    <circle cx="12" cy="12" r="9" fill="#EB001B"></circle>
                                    <circle cx="24" cy="12" r="9" fill="#F79E1B" fill-opacity="0.95"></circle>
                                </svg>

                                <!-- American Express (block with text) -->
                                <svg class="h-6 w-auto" viewBox="0 0 60 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="American Express">
                                    <rect width="60" height="24" rx="4" fill="#0077A2"></rect>
                                    <text x="8" y="16" font-family="Inter, Arial, sans-serif" font-size="10" font-weight="700" fill="#ffffff">AMEX</text>
                                </svg>

