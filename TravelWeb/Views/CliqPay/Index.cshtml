                            <div class="flex items-center space-x-3">
                                <!-- Visa (simple stylized text logo) -->
                                <svg class="h-6 w-auto" viewBox="0 0 64 20" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Visa">
