<script>
    $(function () {

        $('#pass_info').val($('#hdntotpax').val() + " Pax, " + $('#hdnFLYCLS').val());
        $('#flight_adult').val($('#hdnADT').val());
        $('#flight_child').val($('#hdnCHD').val());
        $('#flight_infant').val($('#hdnINF').val());

        $('#flight_class_' + $('#hdnFLYCLSCode').val()).prop("checked", true);
    });
    $(function () {
        $('#pass_info').click(function () {
            $('#FlySearchPassengers').slideToggle();

        });

        $("#prsn_done").click(function () {
            $("#FlySearchPassengers").slideUp("slow");
        });
        $('body').click(function () {
            $("#FlySearchPassengers").slideUp("slow");
        });
        $('.prp_popup').click(function (e) {
            e.stopPropagation();
        });

    });
</script>


