@{
    ViewData["Title"] = "result";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    var nwDate = "";
    var PageSize = 14;
}


<style>
  @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

  *{box-sizing:border-box;}

  

  /* ---------- demo page behind the modal (stand-in for a real site) ---------- */
  .page{
    max-width:760px;
    margin:0 auto;
    padding:64px 24px 120px;
    
  }
  .page h1{font-size:22px;font-weight:800;margin:0 0 6px;}
  .page p{font-size:14px;line-height:1.6;max-width:520px;}
  .page .strip{
    margin-top:28px;
    border:1px solid #2A251C;
    border-radius:10px;
    padding:16px 18px;
    font-size:13px;
    
    display:flex;
    justify-content:space-between;
  }
  .page .strip b{font-weight:700;}

  /* ---------- overlay ---------- */
 .overlay{
    position:fixed;
    inset:0;
    background:rgba(15,12,9,.72);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    opacity:1;
    pointer-events:auto;
    z-index:999;
}

.overlay .ticket{
    transform:translateY(0) scale(1);
    opacity:1;
}
  /* ---------- ticket card ---------- */
  .ticket{
    position:relative;
    width:100%;
    max-width:408px;
    background:#FFFBF3;
    border-radius:22px;
    border:1px solid rgba(255,255,255,.5);
    box-shadow:0 40px 70px -24px rgba(0,0,0,.6), 0 0 0 1px rgba(255,90,31,.06), 0 0 90px -10px rgba(255,90,31,.35);
    transform:translateY(24px) scale(.94);
    opacity:0;
    transition:transform .5s cubic-bezier(.2,1.1,.3,1), opacity .4s ease;
    overflow:hidden;
  }
  .overlay.is-open .ticket{
    transform:translateY(0) scale(1);
    opacity:1;
  }
  .topbar{
    height:5px;
    background:linear-gradient(90deg,#FF5A1F,#FFAE00,#FF5A1F);
    background-size:200% 100%;
    animation:shimmer 3s linear infinite;
  }
  @@keyframes shimmer{
    0%{background-position:0% 0;}
    100%{background-position:-200% 0;}
  }

  .close{
    position:absolute;
    top:14px;
    right:14px;
    width:30px;
    height:30px;
    border-radius:50%;
    border:none;
    background:rgba(21,18,13,.06);
    color:#15120D;
    font-size:15px;
    line-height:1;
    cursor:pointer;
    z-index:5;
  }
  .close:hover{background:rgba(21,18,13,.12);}

  .head{
    padding:22px 24px 0;
  }
  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:7px;
    font-size:11px;
    font-weight:800;
    letter-spacing:.07em;
    text-transform:uppercase;
    color:#D63F0E;
    background:linear-gradient(90deg,rgba(255,90,31,.14),rgba(255,174,0,.14));
    border:1px solid rgba(255,90,31,.18);
    padding:6px 12px 6px 9px;
    border-radius:100px;
  }
  .eyebrow .dot{
    width:6px;height:6px;border-radius:50%;
    background:#FF5A1F;
    box-shadow:0 0 0 0 rgba(255,90,31,.6);
    animation:pulse 1.6s infinite;
  }
  @@keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(255,90,31,.55);}
    70%{box-shadow:0 0 0 7px rgba(255,90,31,0);}
    100%{box-shadow:0 0 0 0 rgba(255,90,31,0);}
  }

  /* route */
  .route{
    position:relative;
    padding:20px 24px 24px;
    display:flex;
    align-items:flex-end;
    gap:10px;
  }
  .route::before{
    content:"";
    position:absolute;
    top:0; left:50%;
    width:220px; height:120px;
    transform:translateX(-50%);
    background:radial-gradient(circle,rgba(255,174,0,.16),transparent 70%);
    pointer-events:none;
  }
  .city{flex:0 0 auto;}
  .city{position:relative;z-index:1;}
  .city .code{
    font-size:36px;
    font-weight:900;
    letter-spacing:-.02em;
    background:linear-gradient(180deg,#15120D,#3A3327);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    line-height:1;
  }
  .city .name{
    margin-top:5px;
    font-size:11.5px;
    font-weight:600;
    color:#8C8577;
    text-transform:uppercase;
    letter-spacing:.03em;
  }
  .path{
    flex:1;
    position:relative;
    height:34px;
    margin:0 2px 15px;
  }
  .path svg{width:100%;height:100%;display:block;overflow:visible;}
  .path .dashline{
    stroke:#E7DFCE;
    stroke-width:2;
  }
  .path .drawline{
    stroke:#FF5A1F;
    stroke-width:2;
    stroke-dasharray:140;
    stroke-dashoffset:140;
    transition:stroke-dashoffset 1.1s cubic-bezier(.4,0,.2,1) .35s;
  }
  .overlay.is-open .path .drawline{stroke-dashoffset:0;}
  .path .plane{
    opacity:0;
    transition:opacity .3s ease .3s;
  }
  .overlay.is-open .path .plane{opacity:1;}

  .fareline{
    margin:0 24px;
    padding:12px 0 14px;
    border-top:1.5px dashed #E7DFCE;
    display:flex;
    align-items:baseline;
    justify-content:space-between;
  }
  .fareline .label{font-size:12px;color:#8C8577;font-weight:500;}
  .fareline .price{font-size:15px;font-weight:800;color:#15120D;}
  .fareline .price span{
    background:linear-gradient(90deg,#D63F0E,#FFAE00);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    font-size:17px;
  }

  /* perforation divider */
  .perf{
    position:relative;
    height:0;
    margin:2px 24px 0;
    border-top:2px dashed #E2D9C6;
  }

  /* stub / cta */
  .stub{
    background:linear-gradient(180deg,#FBF4E7,#F6EDDC);
    padding:24px 24px 26px;
    text-align:center;
  }
  .stub .msg{
    font-size:13px;
    color:#8C8577;
    margin:0 0 14px;
    font-weight:500;
  }
  .stub .msg b{color:#15120D;font-weight:700;}

  .callbtn{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    width:100%;
    background:linear-gradient(135deg,#FF5A1F,#D63F0E);
    color:#FFF8F1;
    border:none;
    border-radius:14px;
    padding:15px 16px;
    font-family:inherit;
    font-size:16px;
    font-weight:700;
    letter-spacing:.01em;
    cursor:pointer;
    text-decoration:none;
    overflow:hidden;
    box-shadow:0 12px 24px -8px rgba(255,90,31,.6);
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .callbtn::after{
    content:"";
    position:absolute;
    top:0; left:-60%;
    width:40%; height:100%;
    background:linear-gradient(115deg,transparent,rgba(255,255,255,.35),transparent);
    transform:skewX(-20deg);
    transition:left .5s ease;
  }
  .callbtn:hover::after{left:130%;}
  .callbtn:hover{transform:translateY(-1px);box-shadow:0 16px 28px -8px rgba(255,90,31,.65);}
  .callbtn:active{transform:translateY(0) scale(.98);}
  .callbtn .code{
    background:rgba(255,255,255,.2);
    padding:3px 8px;
    border-radius:7px;
    font-size:13px;
    font-weight:800;
  }
  .callbtn svg{flex:0 0 auto;}

  .subnote{
    margin:12px 0 0;
    font-size:11.5px;
    color:#8C8577;
  }

  .barcode{
    margin-top:16px;
    height:26px;
    display:flex;
    align-items:stretch;
    gap:2px;
    opacity:.55;
  }
  .barcode span{
    flex:0 0 auto;
    background:#15120D;
  }
</style>


<div class="page">
    <h1>
        <span id="pageDepart">JFK</span>
        →
        <span id="pageArrival">LAX</span>
    </h1>

    <p>
        Search results for your
        <span id="pageRoute">JFK → LAX</span>
        route.
        A fare hold notice appears automatically once pricing is confirmed.
    </p>

    <div class="strip">
        <span id="pageFareInfo">1 Adult · Economy</span>
        <b>from $612</b>
    </div>
</div>

<div class="overlay" id="overlay">
  <div class="ticket" role="dialog" aria-modal="true" aria-label="Fare hold for Dubai to Atlanta">
    <div class="topbar"></div>
   @*  <button class="close" id="closeBtn" aria-label="Close">✕</button> *@

    <div class="head">
      <span class="eyebrow"><span class="dot"></span>Fare held for you</span>
    </div>

    <div class="route">

    <div class="city">
        <div class="code" id="popupDepart">JFK</div>
        <div class="name" id="popupDepartName">JFK</div>
    </div>

    <div class="path">
        <svg viewBox="0 0 140 34" preserveAspectRatio="none">
            <line x1="2" y1="17"
                  x2="138" y2="17"
                  class="dashline"
                  stroke-dasharray="3 5"/>

            <line x1="2" y1="17"
                  x2="138" y2="17"
                  class="drawline"/>

            <g class="plane">
                <path d="M126 17 l-9 -4.5 v3 l-6 1.5 l6 1.5 v3 z"
                      fill="#FF5A1F"/>
            </g>
        </svg>
    </div>

    <div class="city" style="text-align:right;">
        <div class="code" id="popupArrival">LAX</div>
        <div class="name" id="popupArrivalName">LAX</div>
    </div>

</div>

<div class="fareline">
    <span class="label" id="popupFareInfo">
        1 Adult · Economy
    </span>

    <!-- AMOUNT SAME -->
    @* <span class="price">
        from <span>$612</span>
    </span> *@
</div>

    <div class="perf"></div>

    <div class="stub">
      <p class="msg">This fare is <b>held for the next 15 minutes</b>. Call to lock it in before seats reprice.</p>

      <a class="callbtn" href="tel:+18002317199">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFF8F1" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span class="code">+1</span>
        (800) 231-7199
      </a>

      <p class="subnote">Booking line open 24/7 · avg. wait under 2 min</p>

      <div class="barcode" aria-hidden="true"></div>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById('overlay');
  const closeBtn = document.getElementById('closeBtn');

  setTimeout(() => {
    overlay.classList.add('is-open');
  }, 2000);

  

  // barcode fill
  const bc = document.querySelector('.barcode');
  for(let i=0;i<38;i++){
    const bar = document.createElement('span');
    const w = [1,1,2,1,3,1][i % 6];
    bar.style.width = w + 'px';
    bc.appendChild(bar);
  }



  document.addEventListener("DOMContentLoaded", function () {

    const params = new URLSearchParams(window.location.search);

    // -----------------------------
    // Route
    // -----------------------------
    const depart = (
        params.get("depart") ||
        "JFK"
    ).toUpperCase();

    const arrival = (
        params.get("arrival") ||
        "LAX"
    ).toUpperCase();


    // -----------------------------
    // Trip
    // -----------------------------
    const trip = (
        params.get("trip") ||
        "oneway"
    ).toLowerCase();


    // -----------------------------
    // Passengers
    // -----------------------------
    const adult = parseInt(params.get("adult") || "0");
    const child = parseInt(params.get("child") || "0");
    const infant = parseInt(params.get("infant") || "0");
    const seniors = parseInt(params.get("seniors") || "0");

    const totalPax = adult + child + infant + seniors;


    // -----------------------------
    // Cabin
    // -----------------------------
    const cabin = (
        params.get("cabin") ||
        "Y"
    ).toUpperCase();


    const cabinNames = {
        "Y": "Economy",
        "W": "Premium Economy",
        "C": "Business",
        "F": "First"
    };

    const cabinName = cabinNames[cabin] || "Economy";


    // -----------------------------
    // Passenger text
    // -----------------------------
    let passengerParts = [];

    if (adult > 0) {
        passengerParts.push(
            adult + " " + (adult === 1 ? "Adult" : "Adults")
        );
    }

    if (child > 0) {
        passengerParts.push(
            child + " " + (child === 1 ? "Child" : "Children")
        );
    }

    if (infant > 0) {
        passengerParts.push(
            infant + " " + (infant === 1 ? "Infant" : "Infants")
        );
    }

    if (seniors > 0) {
        passengerParts.push(
            seniors + " " + (seniors === 1 ? "Senior" : "Seniors")
        );
    }

    const passengerText =
        passengerParts.length > 0
            ? passengerParts.join(" · ")
            : "1 Adult";


    // -----------------------------
    // Final information
    // -----------------------------
    const fareInfo =
        passengerText + " · " + cabinName;


    // -----------------------------
    // PAGE BINDING
    // -----------------------------
    document.getElementById("pageDepart").textContent = depart;
    document.getElementById("pageArrival").textContent = arrival;

    document.getElementById("pageRoute").textContent =
        depart + " → " + arrival;

    document.getElementById("pageFareInfo").textContent =
        fareInfo;


    // -----------------------------
    // POPUP BINDING
    // -----------------------------
    document.getElementById("popupDepart").textContent =
        depart;

    document.getElementById("popupArrival").textContent =
        arrival;

    document.getElementById("popupDepartName").textContent =
        depart;

    document.getElementById("popupArrivalName").textContent =
        arrival;

    document.getElementById("popupFareInfo").textContent =
        fareInfo;


    // -----------------------------
    // Popup accessibility text
    // -----------------------------
    const ticket = document.querySelector(".ticket");

    if (ticket) {
        ticket.setAttribute(
            "aria-label",
            "Fare hold for " + depart + " to " + arrival
        );
    }

});
</script>



