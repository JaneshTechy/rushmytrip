<input type="hidden" id="hdnADT" value="@(Convert.ToInt16(ViewBag.adult))" />
<input type="hidden" id="hdnCHD" value="@(Convert.ToInt16(ViewBag.child))" />
<input type="hidden" id="hdnINF" value="@(Convert.ToInt16(ViewBag.infant))" />
<input type="hidden" id="hdnFLYCLS" value="@(ViewBag.flightClass)" />
<input type="hidden" id="hdnFLYCLSCode" value="@(ViewBag.FlyClass)" />
