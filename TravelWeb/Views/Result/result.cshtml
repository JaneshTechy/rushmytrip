            contentType: "application/html; charset=utf-8",
            accepts: "application/html; charset=utf-8",
           success: function (response) {
                       hideLoaderdwdw();
                $('#dvResult').html(response);
                $('#myModal').modal('hide');
                $('#dvMainResultView').show();
               $('#dvHeight').hide();
               $('#loadmore').show();

               var TotalList = $("#TotallistCount").val();
               TotalList = parseInt(TotalList);
               if (TotalList < PageSize) {
                   $('#loadmore').hide();

