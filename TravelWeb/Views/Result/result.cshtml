<div class="theme-hero-area front">
    <div class="theme-hero-area-bg-wrap">
        <div class="theme-hero-area-bg theme-hero-area-bg-blur"></div>
    </div>
    <div class="theme-hero-area-body mob-margin-extra">
        <button class="amend-search-btn" id="amendSearchBtn" data-i18n="result.amendSearch">
    Amend Search
</button>
        <section class="search-section" id="Search-Section">
            <div class="mobile-controls">
                <button class="mobile-btn time-btn"><span data-i18n="result.time">Time</span> <i class="fa fa-chevron-down"></i></button>
                <button class="mobile-btn stops-btn"><span data-i18n="result.stops">Stops</span> <i class="fa fa-chevron-down"></i></button>
                <button class="mobile-btn filter-btn"><span data-i18n="result.filters">Filter</span> <i class="fa fa-filter"></i></button>
            </div>

            <div class="time-dropdown">
                <div class="dropdown-option" data-i18n="result.departureTime">Departure Time</div>
                <div class="dropdown-option" data-i18n="result.arrivalTime">Arrival Time</div>
            </div>

            <div class="stops-dropdown">
                <div class="dropdown-option" data-i18n="result.nonStop">Non-stop</div>
                <div class="dropdown-option">1 Stop</div>
                <div class="dropdown-option">2+ Stops</div>
            </div>

            <div class="trip-options">
                <div class="toggle-switch">
                    @if (ViewBag.RoundTrip == 2)
                    {
                        <button type="button" class="toggle-btn active" id="RoundTrip" name="flight-options" data-trip="roundtrip" onclick="switchingOne()" data-i18n="search.roundTrip">Round Trip</button>

                        <button type="button" class="toggle-btn" id="OneWay" name="flight-options" data-trip="oneway" onclick="onewaytodate('OneWay')" data-i18n="search.oneWay">One Way</button>
                    }
                    else if (ViewBag.RoundTrip == 1)
                    {
                        <button type="button" class="toggle-btn active" id="OneWay" name="flight-options" data-trip="oneway" onclick="onewaytodate('OneWay');" data-i18n="search.oneWay">One Way</button>

                        <button type="button" class="toggle-btn" id="RoundTrip" name="flight-options" onclick="switchingOne()" data-trip="roundtrip" data-i18n="search.roundTrip">Round Trip</button>
                    }
                </div>
                <div class="trip-btn">
                    <select id="flight_class_select" name="flight_class">
                        <option id="flight_class_4" value="4" data-i18n="search.economy">Economy</option>
                        <option id="flight_class_3" value="3" data-i18n="search.premium">Premium</option>
                        <option id="flight_class_2" value="2" data-i18n="search.business">Business</option>
                        <option id="flight_class_1" value="1" data-i18n="search.first">First</option>
                    </select>
                </div>
            </div>

            <div class="search-form" id="hero-search-form">
                <div class="swap_wrapper">
                    <div class="form-group">
                        <div class="city-input">
                            <span class="input-icon icon-plane-departure"> <img src="img/air.png" class="img-fluid"></span>
                            <div class="city-content">
                                <div class="city-label" data-i18n="search.fromCity">From City</div>
                                <input id="flight_from" type="text" value="@(ViewBag.departure)" class="city-input-field" placeholder="Departure" data-i18n-placeholder="search.departure" data-provide="typeahead" onClick="this.select()">
                            </div>
                        </div>
                    </div>

                    <div id="swapBtn" class="swap-btn"><span class="icon-exchange"></span></div>

                    <div class="form-group">
                        <div class="city-input">
                            <span class="input-icon icon-plane-arrival">
                                <img src="img/land.png" class="img-fluid">
                            </span>
                            <div class="city-content">
                                <div class="city-label" data-i18n="search.toCity">To City</div>

                                <input id="flight_to" type="text" class="city-input-field inputvalue" value="@(ViewBag.destination)" placeholder="Arrival" data-i18n-placeholder="search.arrival" data-provide="typeahead" onClick="this.select()">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="calender_wrap notranslate">
                    <div class="form-group">

                        <div class="input-wrapper">
                            <span class="input-icon icon-calendar"></span>
                            <label data-i18n="search.departure">Departure</label>
                            <div class="date-input" style="padding-right: 0px">
                                <input id="txtFromDate" class="theme-search-area-section-input notranslate" value="@(Convert.ToDateTime(ViewBag.DepartDate).ToString("MM-dd-yyyy"))" type="text" placeholder="dd-mm-yyyy" autocomplete="off" style="padding: 0px; height: auto" />
                            </div>
                        </div>
                    </div>
                    <div class="hrline">
                        <span class="line"></span>
                    </div>

                    <div class="form-group">

                        <div class="input-wrapper">
                            <span class="input-icon icon-calendar-plus"></span>
                            <label data-i18n="search.returning">Returning</label>
                            <div class="date-input" style="padding-right: 0px">
                                @if (ViewBag.ReturnDate == "0001-01-01" || ViewBag.ReturnDate == "1900-01-01")
                                {
                                    <input id="txtToDate" class="theme-search-area-section-input notranslate" value="" type="text" placeholder="+ Add Return" data-i18n-placeholder="search.addReturn" autocomplete="off" style="padding: 0px; height: auto" />
                                    <span class="closereturn" style="cursor:pointer; display:none; color:black">X</span>
                                }
                                else
                                {
                                    <input id="txtToDate" class="theme-search-area-section-input notranslate" value="@(Convert.ToDateTime(ViewBag.ReturnDate).ToString("MM-dd-yyyy"))" type="text" placeholder="dd-mm-yyyy" autocomplete="off" style="padding: 0px; height: auto" />
                                    <span class="closereturn" style="cursor: pointer; display: none; color: black">X</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="passenger-dropdown-wrapper">
                    <div class="form-group adult">
                        <label data-i18n="search.passengers">Passenger(s)</label>
                        <div class="input-wrapper">
                            <span class="input-icon icon-user"></span>
                            <input class="theme-search-area-section-input" readonly name="pass_info" id="pass_info" placeholder="1 Pax, Economy" value="1 Pax, Economy" type="text" />
                        </div>
                    </div>
                    <div class="" id="FlySearchPassengers" style="display:none;">
                        <div class="quantity-selector-inner">
                            <div id="prsn_popup">
                                <ul class="slect_pssngr" style="list-style: none; padding: 0; margin: 0;">
                                    <li style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                                        <label>Adult &nbsp;<span style="font-size: 11px; color: #666;">(12+ Years)</span></label>
                                        <div class="count_pssngr" style="display: flex; gap: 10px;">
                                            <a href="javascript:void(0);"><em data-field="adult" data-opt="-" class="fa fa-minus inc_der"></em></a>
                                            <input type="text" readonly value="1" name="flight_adult" id="flight_adult" class="inpt_cout_pssngr" style="width: 30px; text-align: center; border: none; color: #000;" />
                                            <a href="javascript:void(0);"><em data-field="adult" data-opt="+" class="fa fa-plus inc_der"></em></a>
                                        </div>
                                    </li>
                                    <li style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                                        <label>Children &nbsp;<span style="font-size: 11px; color: #666;">(2-11 Years)</span></label>
                                        <div class="count_pssngr" style="display: flex; gap: 10px;">
                                            <a href="javascript:void(0);"><em data-field="child" data-opt="-" class="fa fa-minus inc_der"></em></a>
                                            <input type="text" readonly value="0" name="flight_child" id="flight_child" class="inpt_cout_pssngr" style="width: 30px; text-align: center; border: none; color: #000;" />
                                            <a href="javascript:void(0);"><em data-field="child" data-opt="+" class="fa fa-plus inc_der"></em></a>
                                        </div>
                                    </li>
                                    <li style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                                        <label>Infant &nbsp;<span style="font-size: 11px; color: #666;">(0-2 Years)</span></label>
                                        <div class="count_pssngr" style="display: flex; gap: 10px;">
                                            <a href="javascript:void(0);"><em data-field="infant" data-opt="-" class="fa fa-minus inc_der"></em></a>
                                            <input type="text" readonly value="0" name="flight_infant" id="flight_infant" class="inpt_cout_pssngr" style="width: 30px; text-align: center; border: none; color: #000;" />
                                            <a href="javascript:void(0);"><em data-field="infant" data-opt="+" class="fa fa-plus inc_der"></em></a>
                                        </div>
                                    </li>
                                </ul>
                                <div class="clss_done" id="ind_done" style="text-align: right; margin-top: 10px;">
                                    <a href="javascript:void(0);" id="prsn_done" style="font-weight: bold; color: #fff; background: #0971ff; text-decoration: none;">Done</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="search-btn" id="flight_submit" data-i18n="search.search">Search</button>
            </div>
        </section>
    </div>
</div>
<div class="theme-page-section resultPage" id="padZero">

    <div id="dvHeight" style="height:10px;">&nbsp;</div>
    <div id="dvMainResultView" style="display:show;" class="result-outer">
        <input type="hidden" id="hdncounterlooppaging" />

        <div class="results-head">
            <div class="container d-flex space-between">
                <div class="result-head-left">
                    <h1>
                        @(ViewBag.departure?.ToString().Split('-')[1].Split(',')[0])
                        <svg width="26" height="13" viewBox="0 0 26 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M23.283 5.80716L18.2373 0.95335L19.2315 0L26 6.5L19.2315 13L18.2013 12.0467L23.2556 7.19284H12.9863V5.80716H23.283ZM5.77169 5.80716H10.1005V7.19284H5.77169V5.80716ZM0 5.80716H2.88584V7.19284H0V5.80716Z" fill="#1B2A4A" />
                        </svg>
                        @(ViewBag.destination?.ToString().Split('-')[1].Split(',')[0])
                        <span>
                            &bull;
                            @if (ViewBag.ReturnDate != null && ViewBag.ReturnDate != "{1/1/1900 12:00:00 AM}" && ViewBag.ReturnDate != "1900-01-01")
                            {
                                <span data-i18n="search.roundTrip">Round Trip</span>
                            }
                            else
                            {
                                <span data-i18n="search.oneWay">One Way</span>
                            }
                        </span>
                    </h1>
                </div>
                <div class="sort-bar">
                    <span class="sort-chip">
                        @{
                            DateTime? departDate = ViewBag.departOn as DateTime?;
                            DateTime? returnDate = ViewBag.returnOn as DateTime?;
                            DateTime? returnOn = ViewBag.returnOn as DateTime?;
                        }

                        @if (returnOn != null && returnOn != new DateTime(1900, 1, 1))
                        {
                            @departDate?.ToString("MMM dd")
                            <text>→</text> @returnDate?.ToString("MMM dd, yyyy")
                        }
                        else
                        {
                            @departDate?.ToString("MMM dd, yyyy")
                        }
                    </span>
                    <span id="passengerSummary" class="sort-chip">
                        @ViewBag.Adult @(ViewBag.Adult == 1 ? "Adult" : "Adults")

                        @if (ViewBag.Child != null && ViewBag.Child > 0)
                        {
                            @ViewBag.Child @(ViewBag.Child == 1 ? "Child" : "Children")
                        }

                        @if (ViewBag.Infant != null && ViewBag.Infant > 0)
                        {
                            @ViewBag.Infant @(ViewBag.Infant == 1 ? "Infant" : "Infants")
                        }
                    </span>
                    <span class="sort-chip">
                        @{
                            string cabin = "Unknown";
                            int cabinValue = 0;

                            if (int.TryParse(ViewBag.cabin?.ToString(), out cabinValue))
                            {
                                switch (cabinValue)
                                {
                                    case 1:
                                        cabin = "First";
                                        break;
                                    case 2:
                                        cabin = "Business";
                                        break;
                                    case 3:
                                        cabin = "Premium";
                                        break;
                                    case 4:
                                        cabin = "Economy";
                                        break;
                                }
                            }
                        }
                        @cabin
                    </span>
