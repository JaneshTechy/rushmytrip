<script>
    document.addEventListener("DOMContentLoaded", function() {
        const swapBtn = document.getElementById('swapBtn');
        const fromInput = document.getElementById('flight_from');
        const toInput = document.getElementById('flight_to');
        const fromBadge = document.getElementById('fromBadge');
        const toBadge = document.getElementById('toBadge');
        function updateBadgeFromInput(inputElement, badgeElement) {
            const val = inputElement.value.trim();
            const match = val.match(/^([A-Z]{3})[ -]/) || val.match(/\(([A-Z]{3})\)/);

            if (match) {
                badgeElement.textContent = match[1]; // Set text to "MIA"
                badgeElement.style.display = 'block'; // Make visible
            } else {
                badgeElement.textContent = "";
                badgeElement.style.display = 'none';  // Hide if invalid/empty
            }
        }

        let lastFromVal = "";
        let lastToVal = "";

        setInterval(() => {
            if (fromInput.value !== lastFromVal) {
                lastFromVal = fromInput.value;
                updateBadgeFromInput(fromInput, fromBadge);
            }

            if (toInput.value !== lastToVal) {
                lastToVal = toInput.value;
                updateBadgeFromInput(toInput, toBadge);
            }
        }, 200);

        if (swapBtn) {
            let isRotated = false;
            swapBtn.addEventListener('click', () => {
                const tempValue = fromInput.value;
                fromInput.value = toInput.value;
                toInput.value = tempValue;

                lastFromVal = fromInput.value;
                lastToVal = toInput.value;

                updateBadgeFromInput(fromInput, fromBadge);
                updateBadgeFromInput(toInput, toBadge);

                const icon = swapBtn.querySelector('.icon-exchange') || swapBtn;
                icon.style.transition = "transform 0.3s ease";
                icon.style.transform = isRotated ? "rotate(0deg)" : "rotate(180deg)";
                isRotated = !isRotated;
            });
        }
    });
</script>

