    $('#mobileFilters').click(function () {
        $('#divLeftPanel .sticky-col.customHideClass').toggle();
    });


    $("#drpSorting").change(function () {
        if ($('option:selected', this).text() == "Price (Low to High)") {
            SortByPrice(0, 1);

        }
        else if ($('option:selected', this).text() == "Price (High to Low)") {
            SortByPrice(1, 1);
        }
        else if ($('option:selected', this).text() == "Duration (Low to High)") {
            SortByDuration(0, 1);

        }
        else if ($('option:selected', this).text() == "Duration (High to Low)") {
            SortByDuration(1, 1);
        }
        else if ($('option:selected', this).text() == "Airline (A-Z)") {
            SortByAirlineName(0, 1);
        }
        else if ($('option:selected', this).text() == "Airline (Z-A)") {
            SortByAirlineName(1, 1);
        }
    });

</script>

<script>

            function showLoaderwddwwwd() {
          var el = document.getElementById("loaderassss");
          if (!el) return;
          el.style.display = "flex";
          el.classList.add("is-active");
    }

    function hideLoaderdwdw() {
          var el = document.getElementById("loaderassss");
          if (!el) return;
          el.classList.remove("is-active");
          el.style.display = "none";
    }

    var ipaddress = ""
    window.onload = (event) => {
    $.getJSON("https://api.ipify.org?format=json", function (data) {
        ipaddress = (data.ip);
        console.log(data.ip);
        console.log(ipaddress);
    });
    };


     function getResultPage() {
         $('#hdnPageIndex').val("0");


     var geturl = {
        depart: "@(ViewBag.depart)",
        arrival: "@(ViewBag.arrival)",
        trip: "@(ViewBag.trip)",
        departOn: "@(ViewBag.departOn)",
        adult: "@(ViewBag.adult)",
        child: "@(ViewBag.child)",
        infant: "@(ViewBag.infant)",
        returnOn: "@(ViewBag.returnOn)",
        utm_source: "@(ViewBag.utm_source)",
        IsDirect: "@(ViewBag.IsDirect)",
        seniors: "@(ViewBag.seniors)",
        cabin: "@(ViewBag.cabin)",
        source: "@(ViewBag.source)",
        searchID: "@(ViewBag.searchID)",

        // Always search fares in USD (ignore localStorage / UI currency picker)
        currency: "USD"
    };
    try { localStorage.setItem("selectedCurrency", "USD"); } catch (e) { }
         $.ajax({
             type: "get",
             beforeSend: function () {
                 $("#myModal").modal({
                     backdrop: 'static',
                     keyboard: false
                 });
                 $('#loadmore').hide();
             },
             url: "@(TravelWeb.Utilities.Common.WebSitePath)Result/search",
             data: geturl,
            contentType: "application/html; charset=utf-8",
            accepts: "application/html; charset=utf-8",
             success: function (response) {
                 var $bundle = $('<div>').append($.parseHTML(response, document, true));
                 var $left = $bundle.find('#rmf-left');
                 var $results = $bundle.find('#rmf-results');

                 if ($left.length && $results.length) {
                     // Single round-trip: left panel + first page of flights
                     $('#divLeftPanel').html($left.html());
                     $('#dvResult').html($results.html());
                     $('#dvMainResultView').show();
                     $('#dvHeight').hide();
                     var total = parseInt($results.attr('data-total') || $('#TotallistCount').val() || '0', 10);
                     if (!isNaN(total) && total > 0) {
                         $('#TotallistCount').val(total);
                         $('#hdnResultCount').val(total);
                     }
                     var PageSize = @PageSize;
                     if (total > PageSize) $('#loadmore').show();
                     else $('#loadmore').hide();
                     bindResultFilterHandlers();
                 } else {
                     // Fallback for multicity / older response shape
                     $('#divLeftPanel').html(response);
                     $('#loadmore').hide();
                     FirstloadResult();
                 }

                 $('#myModal').modal('hide');
                if (window.refreshPageI18n) refreshPageI18n();
            },
             failure: function (response) {
                 $('#myModal').modal('hide');
                alert("Sorry! no flight found");
            },
             error: function (response) {
                 $('#myModal').modal('hide');
                alert("Sorry! No flight found");
             },
             complete: function () {
                 $('#myModal').modal('hide');
             },

        });
    }


    function SortByAirlineName(vl,chk) {

        if (parseInt($('#hdnSorByAirlineName').val()) == 0) {
            $('#hdnSorByAirlineName').val("1");
        }
        else {
            $('#hdnSorByAirlineName').val("0");
        }
        if (chk == 1 && vl == 0) {

            $('#hdnSorByAirlineName').val("0");

        }
        else if (chk == 1 && vl == 1) {
            $('#hdnSorByAirlineName').val("1");
        }

        $('#hdnSortResult').val("airline");
        $('#hdnPageIndex').val("0");
        filterResult();
