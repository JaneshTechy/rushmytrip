<script>
    const swapBtn = document.getElementById('swapBtn');
    const fromInput = document.getElementById('flight_from');
    const toInput = document.getElementById('flight_to');
    const fromBadge = document.getElementById('fromBadge');
    const toBadge = document.getElementById('toBadge');

    let isRotated = false;

    swapBtn.addEventListener('click', () => {
        const tempValue = fromInput.value;
        fromInput.value = toInput.value;
        toInput.value = tempValue;

        const tempBadge = fromBadge.textContent;
        fromBadge.textContent = toBadge.textContent;
        toBadge.textContent = tempBadge;

        if (!isRotated) {
            swapBtn.style.transform = "translate(-50%, -50%) rotate(180deg)";
        } else {
            swapBtn.style.transform = "translate(-50%, -50%) rotate(0deg)";
        }
        isRotated = !isRotated;
    });
</script>
<script>
        function updatePassengerSummary() {
        var adult = parseInt($("#flight_adult").val()) || 0;
        var child = parseInt($("#flight_child").val()) || 0;
        var infant = parseInt($("#flight_infant").val()) || 0;
        var t = window.SiteI18n ? SiteI18n.t.bind(SiteI18n) : function (k, fb) { return fb; };
        var text = "";

        if (adult > 0) {
            text += "<strong>" + adult + "</strong> " + (adult > 1 ? t('search.adults', 'Adults') : t('search.adult', 'Adult')) + " ";
        }

        if (child > 0) {
            text += "<strong>" + child + "</strong> " + (child > 1 ? t('search.children', 'Children') : t('search.child', 'Child')) + " ";
        }

        if (infant > 0) {
            text += "<strong>" + infant + "</strong> " + (infant > 1 ? t('search.infants', 'Infants') : t('search.infant', 'Infant'));
        }

        $("#passengerSummary").html(text.trim());
    }
</script>
<script>
    // Delegated Select handler — partial scripts often do not run after AJAX .html()
    $(document).on('click', '.btn-primary-inverse, .sidebar-select-btn, .mob-select-btn', function (e) {
        e.preventDefault();
        var flight_id = $(this).data('id');
        if (!flight_id) {
            return;
        }

        var chkAdultmore = parseInt(localStorage.getItem('moreadultcount'), 10) || 0;
        var chkChildmore = parseInt(localStorage.getItem('morechildcount'), 10) || 0;
        var qsval = window.location.search.replace(/^\?/, '');
        var searchId = ($('#searchId').val() || $('#SearchId').val() || '@(ViewBag.searchID)' || '').toString();
        if (searchId.indexOf(',') >= 0) {
            searchId = searchId.substring(searchId.lastIndexOf(',') + 1);
        }

        var detailsUrl = '@(TravelWeb.Utilities.Common.WebSitePath)details?' + qsval
            + '&flightId=' + encodeURIComponent(flight_id)
            + '&moreadultcount=' + chkAdultmore
            + '&morechildcount=' + chkChildmore
            + '&searchID=' + encodeURIComponent(searchId);

        if (typeof showLoaderwddwwwd === 'function') {
            showLoaderwddwwwd();
        }

        // Prepare + verifier run while loader is shown; navigate only after response
        $.ajax({
            url: '/details/prepare',
            type: 'POST',
            data: { searchId: searchId, flightId: flight_id },
            timeout: 90000
        }).always(function () {
            window.location.href = detailsUrl;
        });
    });
</script>
