<style>
    .loaderassssedeed {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(2px);
    }
    .loaderassssedeed.is-active {
        display: flex !important;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 14px;
    }
    .loaderassssedeed .loader-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #e5e7eb;
        border-top-color: #ED4214;
        border-radius: 50%;
        animation: detailsSelectSpin 0.8s linear infinite;
    }
    .loaderassssedeed .loader-bar {
        height: 4px;
        width: min(280px, 70vw);
        --c: no-repeat linear-gradient(#ED4214 0 0);
        background: var(--c), var(--c), #fff;
        background-size: 60% 100%;
        animation: l16 3s infinite;
        border-radius: 2px;
    }
    .loaderassssedeed .loader-text {
        font-size: 14px;
        color: #334155;
        font-weight: 600;
    }

    @@keyframes detailsSelectSpin {
        to { transform: rotate(360deg); }
    }

    @@keyframes l16 {
        0% {
            background-position: -150% 0, -150% 0;
        }

        66% {
            background-position: 250% 0, -150% 0;
        }

        100% {
            background-position: 250% 0, 250% 0;
        }
    }

    body {
        background-color: #f1f1f1 !important;
    }

    .backgroundOverlay {
        display: none !important
    }
</style>

