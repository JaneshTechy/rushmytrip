<script>
    $(function () {
        debugger;
        // coment by janesh-30102023;
        // var chkAdultmore = localStorage.getItem("moreadultcount");
        // var chkChildmore = localStorage.getItem("morechildcount");
        // if(@ViewBag.MorderAdult!=null){
        //     chkAdultmore = @(Convert.ToInt16(ViewBag.MorderAdult));
        //     chkChildmore = @(Convert.ToInt16(ViewBag.MoreChild));
        // }
        chkAdultmore = @(Convert.ToInt16(ViewBag.MorderAdult));
        chkChildmore = @(Convert.ToInt16(ViewBag.MoreChild));
        localStorage.setItem("moreadultcount", chkAdultmore);
        localStorage.setItem("morechildcount", chkChildmore);

        var infant = $('#hdnINF').val();
        infant = parseInt(infant);
        if (chkAdultmore != null && chkChildmore != null) {
            $('#pass_info').val(parseInt(chkAdultmore) + parseInt(chkChildmore)+infant + "Pax," + $('#hdnFLYCLS').val());
            $('#flight_adult').val(chkAdultmore);
            $('#flight_child').val(chkChildmore);
        }
        else {
            $('#pass_info').val($('#hdntotpax').val() + " Pax, " + $('#hdnFLYCLS').val());
            $('#flight_adult').val($('#hdnADT').val());
            $('#flight_child').val($('#hdnCHD').val());

        }
        $('#flight_infant').val($('#hdnINF').val());
    $('#flight_class_select').val($('#hdnFLYCLSCode').val());
    });
    $(function () {
        $('#pass_info').click(function () {
            $('#FlySearchPassengers').slideToggle();

        });

        $("#prsn_done").click(function () {
            $("#FlySearchPassengers").slideUp("slow");
        });
        $('body').click(function () {
            $("#FlySearchPassengers").slideUp("slow");
        });
        $('.#FlySearchPassengers').click(function (e) {
            e.stopPropagation();
        });

    });


</script>


