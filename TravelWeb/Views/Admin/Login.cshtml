@using Newtonsoft.Json
@{
    Layout = null; // No sidebar for login
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - RushMyFlight Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/@@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>
</head>
<body class="bg-slate-50 h-screen flex items-center justify-center p-6 font-sans antialiased">

    <div class="max-w-md w-full bg-white rounded-3xl shadow-xl border border-slate-100 p-10 relative z-10">
        <div class="text-center mb-10">
            <div class="h-20 w-25 bg-white rounded-2xl flex items-center justify-center mx-auto  mb-4 p-2">
                <img src="~/img/fav-icon.png"
                     alt="RushMyFlight Logo"
                     class="h-full w-full object-contain" />
            </div>
            <h2 class="text-2xl font-black text-slate-800">RushMyFlight <span class="text-orange-500">Admin</span></h2>
            <p class="text-slate-400 text-sm font-medium">Enter your credentials to manage system</p>
        </div>

        <form asp-action="Login" method="post" class="space-y-6">
            @* Added Hidden Input for ReturnUrl *@
            <input type="hidden" name="returnUrl" value="@Context.Request.Query["ReturnUrl"]" />

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2 ml-1">Email Address</label>
                <div class="relative">
                    <i class="fas fa-envelope absolute left-4 top-4 text-slate-300"></i>
                    <input name="email" type="email" required class="w-full pl-12 pr-4 py-3 rounded-xl border border-slate-200 focus:ring-4 focus:ring-orange-500/10 focus:border-orange-500 outline-none transition-all" placeholder="admin@example.com" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2 ml-1">Password</label>
                <div class="relative">
                    <i class="fas fa-lock absolute left-4 top-4 text-slate-300"></i>
                    <input name="password" type="password" required class="w-full pl-12 pr-4 py-3 rounded-xl border border-slate-200 focus:ring-4 focus:ring-orange-500/10 focus:border-orange-500 outline-none transition-all" placeholder="••••••••" />
                </div>
            </div>

            <button type="submit" class="w-full bg-slate-900 hover:bg-black text-white font-bold py-4 rounded-xl shadow-lg transition-all transform hover:-translate-y-1">
                Sign In to Dashboard
            </button>
        </form>

        <div class="text-center" style="margin-top:15px;">
            <p style="color:#d9534f; font-weight:600; font-size:14px;">
                Your IP Address: @ViewBag.UserIP
            </p>
            <p style="color:#a94442; font-size:12px;">
                Warning: Unauthorized access attempts are logged and monitored.
            </p>
        </div>
    </div>

    <div x-data="{
         show: false,
         message: '' ,
         type: 'success' ,
         init() {
         @if (TempData["Notification"] != null)
        {
             var notification = JsonConvert.DeserializeObject<dynamic>(TempData["Notification"].ToString());
                        <text>
                        this.message = '@notification.Message';
                        this.type = '@notification.Type';
                        this.show = true;
                        setTimeout(() => { this.show = false }, 5000);
                        </text>
                }
            }
         }"
         x-show="show"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 transform translate-y-2 scale-95"
         x-transition:enter-end="opacity-100 transform translate-y-0 scale-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 transform translate-y-0 scale-100"
         x-transition:leave-end="opacity-0 transform translate-y-2 scale-95"
         class="fixed bottom-10 right-10 z-[100] px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-4 min-w-[320px] border shadow-orange-500/10"
         :class="{
            'bg-white border-green-100 text-green-800': type === 'success',
            'bg-white border-red-100 text-red-800': type === 'error',
            'bg-white border-orange-100 text-orange-800': type === 'warning'
         }"
         x-cloak>

        <div class="h-10 w-10 rounded-xl flex items-center justify-center shrink-0 shadow-sm"
             :class="{
                'bg-green-500 text-white': type === 'success',
                'bg-red-500 text-white': type === 'error',
                'bg-orange-500 text-white': type === 'warning'
             }">
            <i class="fas" :class="type === 'success' ? 'fa-check' : (type === 'error' ? 'fa-exclamation-circle' : (type === 'warning' ? 'fa-exclamation-triangle' : ''))"></i>
        </div>

        <div class="flex-1">
            <p class="text-[10px] font-black uppercase tracking-widest opacity-40 leading-none mb-1" x-text="type"></p>
            <p class="text-sm font-bold leading-tight text-slate-700" x-text="message"></p>
        </div>

        <button @@click="show = false" class="text-slate-300 hover:text-slate-500 transition">
            <i class="fas fa-times"></i>
        </button>
    </div>

</body>
</html>