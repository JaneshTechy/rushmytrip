@model AllowRulesPageVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    // Null checks for safety
    var rulesCount = Model?.Rules?.Count() ?? 0;
}

<div class="space-y-10">

    @* HEADER *@
    <div>
        <h1 class="text-2xl font-black text-slate-800 uppercase">
            Allow Airline Routes
        </h1>
        <p class="text-sm text-slate-500">
            Manage allowed flight routes across origins and destinations.
        </p>
    </div>

    @* FORM SECTION *@
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">

        <div class="px-8 py-4 border-b border-slate-100 bg-slate-50/50">
            <h3 class="font-bold text-slate-700 text-sm uppercase">
                @(Model.FormRule.RoutesId > 0 ? "Edit Rule" : "Create Rule")
            </h3>
        </div>

        <form asp-action="SaveAllowRule" method="post" enctype="multipart/form-data" class="p-8">

            <input type="hidden" asp-for="FormRule.RoutesId" name="FormRule.RoutesId" />

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                @* ORIGINS *@
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Origins (comma separated)
                    </label>

                    <textarea name="OriginsText"
                              class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"
                              placeholder="US, IN, UK">@string.Join(", ", Model.FormRule.Origins)</textarea>
                </div>

                @* DESTINATIONS *@
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Destinations (comma separated)
                    </label>

                    <textarea name="DestinationsText"
                              class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"
                              placeholder="MX, AUH">@string.Join(", ", Model.FormRule.Destinations)</textarea>
                </div>

                @* STATUS *@
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Status
                    </label>

                    <select asp-for="FormRule.Status"
                            class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm">

                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>

                @* COMPANY *@
                @* <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Company
                    </label>

                    <input asp-for="FormRule.Company" name="FormRule.Company"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
                </div> *@

                <div>
    <label class="text-xs font-bold text-slate-500 uppercase">
        Company
    </label>

    <select asp-for="FormRule.Company"
            id="companyDropdown"
            class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"
            onchange="setCampaignId(this.value)">

        <option value="">Select Company</option>

        <option value="FareScrapper">FareScrapper</option>
        <option value="Trabber">Trabber</option>
        <option value="FareCompare">FareCompare</option>
        <option value="RushMyFlight Website">RushMyFlight Website</option>
        <option value="Es.RushMyFlight">Es.RushMyFlight</option>

    </select>
</div>

                @* CAMP ID *@
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Camp ID
                    </label>

                    <input asp-for="FormRule.CampID"
           id="campIdInput"
           readonly
           class="w-full px-4 py-3 rounded-xl border border-slate-200
                  text-sm bg-slate-50 font-semibold text-slate-600" />
                </div>

                @* UPDATED BY *@
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Updated By
                    </label>

                    <input asp-for="FormRule.UpdatedBy"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
                </div>

            </div>

            @* ACTION BAR *@
            <div class="mt-8 pt-8 border-t border-slate-100 flex justify-between items-center">

                <div class="flex items-center gap-3">

                    <label class="cursor-pointer">
                        <input type="file" name="excelFile" class="hidden" />

                        <div class="px-5 py-2.5 rounded-xl border border-slate-200 bg-white
                                    hover:border-orange-400 hover:bg-orange-50
                                    text-xs font-bold text-slate-600 shadow-sm">

                            <i class="fas fa-upload mr-2 text-orange-500"></i>
                            Upload Excel
                        </div>
                    </label>

                    <a asp-action="DownloadAllowExcel"
                       class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-900
                              text-white text-xs font-bold shadow-md">

                        <i class="fas fa-file-excel mr-2"></i>
                        Download Format
                    </a>

                </div>

               <div class="flex gap-3">

    <button type="submit"
            formaction="@Url.Action("AllowRulesView")"
            formmethod="get"
            class="px-6 py-3 rounded-xl bg-slate-800 text-white text-sm font-bold">
        Search
    </button>

    <button type="submit"
            class="px-10 py-3 rounded-xl bg-orange-500 text-white font-bold text-sm">
        Save Rule
    </button>

</div>

            </div>

        </form>
    </section>

    @* TABLE SECTION *@
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">

                <thead>
                    <tr class="bg-slate-50/50 border-b border-slate-100 text-xs text-slate-400 uppercase">
                        <th class="px-6 py-4">ID</th>
                        <th class="px-6 py-4">Origin</th>
                        <th class="px-6 py-4">Destination</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Company</th>
                        <th class="px-6 py-4">Camp ID</th>
                        <th class="px-6 py-4">Updated By</th>
                        <th class="px-6 py-4">Created At</th>
                        <th class="px-6 py-4">Updated At</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-50">

                    @if (Model.Rules != null && Model.Rules.Any())
                    {
                        foreach (var r in Model.Rules)
                        {
                            <tr class="hover:bg-slate-50/50">

                                <td class="px-6 py-3">@r.RoutesId</td>
                                <td class="px-6 py-3">@string.Join(", ", r.Origins)</td>
                                <td class="px-6 py-3">@string.Join(", ", r.Destinations)</td>

                                <td class="px-6 py-3">
                                    <span class="px-2 py-1 rounded-full text-xs font-bold
                                        @(r.Status ? "bg-green-100 text-green-700" : "bg-slate-100 text-slate-500")">
                                        @(r.Status ? "Active" : "Inactive")
                                    </span>
                                </td>

                                <td class="px-6 py-3">@r.Company</td>
                                <td class="px-6 py-3">@r.CampID</td>
                                <td class="px-6 py-3">@r.UpdatedBy</td>
                                <td class="px-6 py-3">@r.CreatedAt</td>
                                <td class="px-6 py-3">@r.UpdatedAt</td>

                                <td class="px-6 py-3 text-right">
                                    <div class="flex justify-end gap-3">

                                        <a asp-action="AllowRulesView" asp-route-editId="@r.RoutesId">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <a href="javascript:void(0);" onclick="confirmCopy(@r.RoutesId)">
    <i class="fas fa-copy"></i>
</a>
                                        @* <a asp-action="AllowRulesViewCopy" asp-route-copyId="@r.RoutesId">
                                            <i class="fas fa-copy"></i>
                                        </a> *@
                                                                             <form asp-action="DeleteAllowRule" asp-route-id="@r.RoutesId" method="post"
      onsubmit="return confirm('Delete this rule?');">
    <button type="submit">
        <i class="fas fa-trash-alt text-red-500"></i>
    </button>
</form>
                                        @* <a asp-action="DeleteAllowRule"
                                           asp-route-id="@r.RoutesId"
                                           onclick="return confirm('Delete this rule?');">
                                            <i class="fas fa-trash-alt text-red-500"></i>
                                        </a> *@

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-10 text-slate-400">
                                No rules found.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

    </section>

</div>
<form id="copyPostForm" method="post" action="/Admin/AllowRulesViewCopy">
    @Html.AntiForgeryToken()
    <input type="hidden" id="copyIdInput" name="copyId" />
</form>
@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success',
            text: '@TempData["Success"]',
            confirmButtonColor: '#3085d6'
        });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: '@TempData["Error"]',
            confirmButtonColor: '#d33'
        });


    </script>
}
<script>
function confirmCopy(ruleId) {
    swal({
        title: "Are you sure?",
        text: "Do you want to copy this Routes?",
        icon: "warning",
        buttons: ["No", "Yes"],
        dangerMode: true,
    })
    .then((willCopy) => {
        if (willCopy) {
            document.getElementById("copyIdInput").value = ruleId;
            document.getElementById("copyPostForm").submit();
        }
    });
}
function setCampaignId(company) {

        const campaignMap = {
            "FareScrapper": "Rush_FS",
            "Trabber": "Rush_Trabber",
            "FareCompare": "Rush_FC",
            "RushMyFlight Website": "Rush",
            "Es.RushMyFlight": "Rush_ES"
        };

        document.getElementById("campIdInput").value =
            campaignMap[company] || "";
    }
</script>
