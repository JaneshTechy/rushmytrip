@model CampaignPageVM

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var form = Model?.Form ?? new CampaignDto();
    var list = Model?.Campaigns ?? new List<CampaignDto>();
}

<div class="space-y-10">

    <!-- HEADER -->
    <div>
        <h1 class="text-2xl font-black text-slate-800 uppercase">
            Manage Campaign
        </h1>
        <p class="text-sm text-slate-500">
            Configure campaign settings and manage campaign list.
        </p>
    </div>

    <!-- CARD 1 : META PLATFORM -->
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200">

        <div class="px-8 py-4 border-b border-slate-100 bg-slate-50/50">
            <h3 class="font-bold text-slate-700 text-sm uppercase">
                Meta
            </h3>
        </div>

        <div class="p-8 grid grid-cols-1 md:grid-cols-3 gap-6">

            <div>
                <label class="text-xs font-bold text-slate-500 uppercase">
                    Meta Platform
                </label>

                <select class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm">
                    <option>Fare Scraper</option>
                    <option>Trabber</option>
                     <option>FareCompare</option>

                </select>
            </div>

        </div>

    </section>

    <!-- CARD 2 : FORM -->
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200">

        <div class="px-8 py-4 border-b border-slate-100 bg-slate-50/50">
            <h3 class="font-bold text-slate-700 text-sm uppercase">
                Manage Campaign
            </h3>
        </div>

        <form asp-action="SaveCampaign" method="post" class="p-8">

            <input type="hidden" name="Form.Id" value="@form.Id" />

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <!-- ON/OFF -->
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        On / Off Campaign
                    </label>

                    <select name="Form.Status"
                            class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm">

                        <option value="true" selected="@(form.Status)">Active</option>
                        <option value="false" selected="@(!form.Status)">Inactive</option>
                    </select>
                </div>

                <!-- PAX COUNT -->
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Pax Count
                    </label>

                    <input name="Form.PaxCount"
                           value="@form.PaxCount"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
                </div>

                <!-- CAMP ID -->
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Camp ID
                    </label>

                    <input name="Form.CampID"
                           value="@form.CampID"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
                </div>

                <!-- COMPANY -->
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Company
                    </label>

                    <input name="Form.Company"
                           value="@form.Company"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
                </div>

                <!-- UPDATED BY -->
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Updated By
                    </label>

                    <input name="Form.UpdatedBy"
                           value="@form.UpdatedBy"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
                </div>
                 <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Extra MArkup
                    </label>

                    <input name="Form.ExtraMarkup"
                           value="@form.ExtraMarkup"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
                </div>

            </div>

            <!-- BUTTON -->
            <div class="mt-8 pt-6 border-t border-slate-100 flex justify-end">

                <button type="submit"
                        class="px-10 py-3 rounded-xl bg-orange-500 hover:bg-orange-600
                               text-white font-bold text-sm shadow-lg">

                    <i class="fas fa-save mr-2"></i>
                    Save Campaign
                </button>

            </div>

        </form>
    </section>

    <!-- CARD 3 : LIST -->
    <section class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">

        <div class="px-8 py-4 border-b border-slate-100 bg-slate-50/50">
            <h3 class="font-bold text-slate-700 text-sm uppercase">
                Campaign List
            </h3>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">

                <thead>
                    <tr class="bg-slate-50/50 border-b border-slate-100 text-xs text-slate-400 uppercase">
                        <th class="px-6 py-4">ID</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Pax Count</th>
                        <th class="px-6 py-4">Camp ID</th>
                        <th class="px-6 py-4">Company</th>
                        <th class="px-6 py-4">Updated By</th>
                        <th class="px-6 py-4">Created At</th>
                        <th class="px-6 py-4">Updated At</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-50">

                    @if (list != null && list.Any())
                    {
                        foreach (var r in list)
                        {
                            <tr class="hover:bg-slate-50/50">

                                <td class="px-6 py-3">@r.Id</td>

                                <td class="px-6 py-3">
                                    <span class="px-2 py-1 rounded-full text-xs font-bold
                                        @(r.Status ? "bg-green-100 text-green-700" : "bg-slate-100 text-slate-500")">
                                        @(r.Status ? "Active" : "Inactive")
                                    </span>
                                </td>

                                <td class="px-6 py-3">@r.PaxCount</td>
                                <td class="px-6 py-3">@r.CampID</td>
                                <td class="px-6 py-3">@r.Company</td>
                                <td class="px-6 py-3">@r.UpdatedBy</td>
                                <td class="px-6 py-3">@r.CreatedAt</td>
                                <td class="px-6 py-3">@r.UpdatedAt</td>

                                <td class="px-6 py-3 text-right">
                                    <div class="flex justify-end gap-3">

                                        <!-- EDIT -->
                                        <a asp-action="ManageCampaign" asp-route-editId="@r.Id">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>

                                        <form asp-action="DeleteCampaign" asp-route-id="@r.Id" method="post"
      onsubmit="return confirm('Delete this campaign?');">
    <button type="submit">
        <i class="fas fa-trash-alt text-red-500"></i>
    </button>
</form>
                                        @* <!-- DELETE -->
                                        <a asp-action="DeleteCampaign"
                                           asp-route-id="@r.Id"
                                           onclick="return confirm('Delete this campaign?');">
                                            <i class="fas fa-trash-alt text-red-500"></i>
                                        </a> *@

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-10 text-slate-400">
                                No campaigns found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>

    </section>

</div>