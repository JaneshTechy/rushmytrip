                    <input name="FormRule.RuleName" value="@form.RuleName" class="input" />
                </div>

                <div>
                    <label class="label">Origin</label>
                    <textarea name="OriginsText" class="input">@(form.Origins != null ? string.Join(",", form.Origins) : "")</textarea>
                </div>

                <div>
                    <label class="label">Destination</label>
                    <textarea name="DestinationsText" class="input">@(form.Destinations != null ? string.Join(",", form.Destinations) : "")</textarea>
                </div>

                <div>
                    <label class="label">Airline</label>
                    <input name="AirlinesText" value="@(form.Airlines != null ? string.Join(",", form.Airlines) : "")" class="input" />
                </div>

                @* <div>
                    <label class="label">Cabin Class</label>
                    <input name="CabinText" value="@(form.CabinClasses != null ? string.Join(",", form.CabinClasses) : "")" class="input" />
                </div> *@
                <div>
    <label class="label">Cabin Class</label>
   <select name="CabinText" class="input">
        <option value="">All</option>
        <option value="F" selected="@(form.CabinClass == "F")">First</option>
        <option value="B" selected="@(form.CabinClass == "B")">Business</option>
        <option value="Y" selected="@(form.CabinClass == "Y")">Economy</option>
        <option value="S" selected="@(form.CabinClass == "S")">Premium Economy</option>
    </select>
</div>
                <div>
                    <label class="label">Journey Type</label>
                   <select name="FormRule.JourneyType" class="input">
    <option value="">Any</option>
    <option value="O" selected="@(form.JourneyType == "O")">OneWay</option>
    <option value="R" selected="@(form.JourneyType == "R")">RoundTrip</option>
</select>
                </div>

                <div>
                    <label class="label">Class OB</label>
                    <input name="FormRule.ClassOb" value="@form.ClassOb" class="input" />
                </div>

                <div>
                    <label class="label">Class IB</label>
                    <input name="FormRule.ClassIb" value="@form.ClassIb" class="input" />
                </div>

                <div>
                    <label class="label">Markup Type</label>
                    <select name="FormRule.MarkType" class="input">
