    <select name="FormRule.PaxType" class="input">
        <option value="Any" selected="@(string.IsNullOrEmpty(form.PaxType) || form.PaxType=="Any")">All</option>
        <option value="A" selected="@(form.PaxType=="A")">Adult</option>
        <option value="C" selected="@(form.PaxType=="C")">Child</option>
        <option value="I" selected="@(form.PaxType=="I")">Infant</option>
    </select>
</div>

                <div>
                    <label class="label">Travel Date From</label>
                    <input type="date" name="FormRule.TravelDateFrom"
                           value="@(form.TravelDateFrom?.ToString("yyyy-MM-dd"))"
