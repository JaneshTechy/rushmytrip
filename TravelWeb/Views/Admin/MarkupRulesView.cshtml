                    <label class="label">Pax Count</label>
                    <input name="FormRule.PaxCount" value="@form.PaxCount" class="input" />
                </div>

                @* <div>
                    <label class="label">Pax Type</label>
                    <input name="FormRule.PaxType" value="@form.PaxType" class="input" />
                </div> *@
                <div>
