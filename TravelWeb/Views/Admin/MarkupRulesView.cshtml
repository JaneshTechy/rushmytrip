                </div>

                <div>
                    <label class="label">Travel Date To</label>
                    <input type="date" name="FormRule.TravelDateTo"
                           value="@(form.TravelDateTo?.ToString("yyyy-MM-dd"))"
                           class="input" />
                </div>
                 <div>
                    <label class="label">Sale Date From</label>
                    <input type="date" name="FormRule.SaleDateFrom"
                           value="@(form.SaleDateFrom?.ToString("yyyy-MM-dd"))"
