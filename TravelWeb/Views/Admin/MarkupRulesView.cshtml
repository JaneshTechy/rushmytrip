                        <option value="F" selected="@(form.MarkType=="F")">Fixed</option>
                        <option value="A" selected="@(form.MarkType=="A")">Absolute</option>
                    </select>
                </div>

                <div>
                    <label class="label">Markup Amount</label>
                   @*  <input name="FormRule.MarkUp" value="@form.MarkUp" class="input" /> *@
                  <input name="FormRule.MarkUp"
       value="@form.MarkUp"
       class="input"
       type="text"
       oninput="limitDecimal(this)" />
                </div>

                <div>
                    <label class="label">Status</label>
                    <select name="FormRule.Status" class="input">
                        <option value="true" selected="@(form.Status)">Active</option>
                        <option value="false" selected="@(!form.Status)">Inactive</option>
                    </select>
                </div>

                <div>
                    <label class="label">Advance Days</label>
                    <input name="FormRule.AdvanceDays" value="@form.AdvanceDays" class="input" />
                </div>

                @* <div>
                    <label class="label">Stops</label>
                    <input name="FormRule.Stops" value="@form.Stops" class="input" />
                </div> *@
                <div>
    <label class="label">Stops</label>
    <select name="FormRule.Stops" class="input">
        <option value="-1" selected="@(form.Stops == null || form.Stops == -1)">All</option>
        <option value="0" selected="@(form.Stops == 0)">Direct</option>
        <option value="1" selected="@(form.Stops == 1)">One Stop</option>
    </select>
</div>

                <div>
                    <label class="label">Minimum Amount</label>
                    <input name="AmountText"
