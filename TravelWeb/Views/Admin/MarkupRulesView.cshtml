    <option value="Trabber"
            selected="@(company == "Trabber")">
        Trabber
    </option>

    <option value="FareCompare"
            selected="@(company == "FareCompare")">
        FareCompare
    </option>

    <option value="RushMyFlight Website"
            selected="@(company == "RushMyFlight Website")">
        RushMyFlight Website
    </option>

    <option value="Es.RushMyFlight"
            selected="@(company == "Es.RushMyFlight")">
        Es.RushMyFlight
    </option>

</select>
</div>

<div>
    <label class="label">Campaign ID</label>

   <select name="FormRule.CampId"
        id="campaignDropdown"
        class="input">

    <option value="">Select Campaign</option>

    <option value="Rush_FS" selected="@(form.CampId == "Rush_FS")">
