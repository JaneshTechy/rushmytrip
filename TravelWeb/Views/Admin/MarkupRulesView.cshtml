                </div>
                @* <div>
                    <label class="label">Company</label>
                    <input name="FormRule.Company" value="@form.Company" class="input" />
                </div> *@

                <div>
    <label class="label">Company</label>

    <select name="FormRule.Company"
        id="companyDropdown"
        class="input"
        onchange="setCampaignId(this.value)">

    <option value="">Select Company</option>

    <option value="FareScrapper"
