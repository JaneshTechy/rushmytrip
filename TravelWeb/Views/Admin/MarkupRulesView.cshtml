        <p class="text-sm text-slate-500">
            Everything must be comma separated where multiple values are allowed.
        </p>
    </div>

    <section class="bg-white rounded-3xl shadow-sm border border-slate-200">

        <form asp-action="SaveMarkupRule" method="post" enctype="multipart/form-data" class="p-8">

