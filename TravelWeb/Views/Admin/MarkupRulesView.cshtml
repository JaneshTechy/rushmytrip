    </option>

    <option value="Rush_Trabber" selected="@(form.CampId == "Rush_Trabber")">
        Rush_Trabber
    </option>

    <option value="Rush_FC" selected="@(form.CampId == "Rush_FC")">
        Rush_FC
    </option>

    <option value="Rush" selected="@(form.CampId == "Rush")">
        Rush
    </option>

    <option value="Rush_ES" selected="@(form.CampId == "Rush_ES")">
        Rush_ES
    </option>
</select>
</div>

                @* <div>
                    <label class="label">Campaign ID</label>
                    <input name="FormRule.CampId" value="@form.CampId" class="input" />
                </div> *@



                <div>
                    <label class="label">Updated By</label>
                    <input name="FormRule.UpdatedBy" value="@form.UpdatedBy" class="input" />
                </div>
                <div>
                    <label class="label">Replace Ailine</label>
                    <input name="FormRule.ReplaceAirline" value="@form.ReplaceAirline" class="input" />
                </div>
                <div>
    <label class="label">Outbound Time</label>
    <input name="FormRule.OutboundTime" value="@form.OutboundTime" class="input" type="text" />
</div>
               <div>
    <label class="label">Inbound Time</label>
    <input name="FormRule.InboundTime" value="@form.InboundTime" class="input" type="text" />
</div>



            </div>

            <div class="mt-6 flex justify-between">

                <div class="flex gap-3">
                    <input type="file" name="excelFile" class="input" />
                    <a asp-action="DownloadMarkupExcel" class="btn-dark">
                        Download Excel Format
                    </a>
                </div>
                <button type="submit"
        formaction="@Url.Action("MarkupRulesView")"
        formmethod="get"
        class="btn-dark">
    Search
</button>
                <button type="submit" class="btn-primary">
                    Save Rule
