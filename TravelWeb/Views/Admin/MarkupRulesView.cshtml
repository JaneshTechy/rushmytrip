                        <th class="px-6 py-4">Airline</th>
                        <th class="px-6 py-4">Cabin Class</th>
                        <th class="px-6 py-4">Class OB</th>
                        <th class="px-6 py-4">Journey Type</th>
                        <th class="px-6 py-4">Markup Type</th>
                        <th class="px-6 py-4">Markup Amount</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Advance Days</th>
                        <th class="px-6 py-4">Stops</th>
                        <th class="px-6 py-4">Minimum Amount</th>
                        <th class="px-6 py-4">Pax Count</th>
                        <th class="px-6 py-4">Travel Date From</th>
                        <th class="px-6 py-4">Travel Date To</th>
