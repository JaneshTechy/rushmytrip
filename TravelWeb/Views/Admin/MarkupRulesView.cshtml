@model MarkupRulesPageVM

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var form = Model?.FormRule ?? new MarkupRuleDto();
    var rules = Model?.Rules ?? new List<MarkupRuleDto>();
     var cabin = form.CabinClass?.Trim().ToUpper();
      string company = "";

    switch (form.CampId)
    {
        case "Rush_FS":
            company = "FareScrapper";
            break;

        case "Rush_Trabber":
            company = "Trabber";
            break;

        case "Rush_FC":
            company = "FareCompare";
            break;

        case "Rush":
            company = "RushMyFlight Website";
            break;

        case "Rush_ES":
            company = "Es.RushMyFlight";
            break;
