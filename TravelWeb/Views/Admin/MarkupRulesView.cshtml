                                        @(r.Status ? "Active" : "Inactive")
                                    </span>
                                </td>

                                <td class="px-6 py-3">@r.AdvanceDays</td>
                                <td class="px-6 py-3">@r.Stops</td>

                                <td class="px-6 py-3">
                                    @(r.MinimumAmountRange.min != null
