</style>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success',
            text: '@TempData["Success"]',
            confirmButtonColor: '#3085d6'
        });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: '@TempData["Error"]',
            confirmButtonColor: '#d33'
        });
    </script>
}
<script>
   function limitDecimal(input) {

    const markType = document.querySelector('[name="FormRule.MarkType"]').value;

    // For Fixed and Absolute, allow any numeric value
    if (markType !== "P") {
        return;
    }

    // Percentage: max 2 digits before decimal
    let value = input.value;

    let match = value.match(/^([+-]?)(\d{0,2})(?:\.(\d*))?/);

    if (match) {
        let sign = match[1] || "";
        let intPart = match[2] || "";
        let decPart = match[3];

        input.value = sign + intPart + (decPart !== undefined ? "." + decPart : "");
    } else {
        input.value = "";
    }
}
    function confirmCopy(ruleId) {debugger
    swal({
        title: "Are you sure?",
        text: "Do you want to copy this rule?",
        icon: "warning",
        buttons: ["No", "Yes"],
        dangerMode: true,
    })
    .then((willCopy) => {
        if (willCopy) {
            // Call backend (redirect or AJAX)
            window.location.href = '/Admin/MarkupRulesView?copyId=' + ruleId;
        }
    });
}


const campaignMap = {
        "FareScrapper": "Rush_FS",
        "Trabber": "Rush_Trabber",
        "FareCompare": "Rush_FC",
        "RushMyFlight Website": "Rush",
        "Es.RushMyFlight": "Rush_ES"
    };

    function setCampaignId(company) {

        const campaignId = campaignMap[company] || "";

        const campaignDropdown =
            document.getElementById("campaignDropdown");

        campaignDropdown.value = campaignId;
    }

    // Edit page par existing Company ke according Campaign ID set kare
    document.addEventListener("DOMContentLoaded", function () {

        const company =
            document.getElementById("companyDropdown").value;

        if (company) {
            setCampaignId(company);
        }
    });
</script>
<script>
    const campaignToCompanyMap = {
        "Rush_FS": "FareScrapper",
        "Rush_Trabber": "Trabber",
        "Rush_FC": "FareCompare",
        "Rush": "RushMyFlight Website",
        "Rush_ES": "Es.RushMyFlight"
    };

    document.addEventListener("DOMContentLoaded", function () {

        const campaignDropdown = document.getElementById("campaignDropdown");
        const companyDropdown = document.getElementById("companyDropdown");

        if (!campaignDropdown || !companyDropdown) return;

        const campaignId = campaignDropdown.value;

        const company = campaignToCompanyMap[campaignId];

        if (company) {
            companyDropdown.value = company;
        }
    });
</script>

