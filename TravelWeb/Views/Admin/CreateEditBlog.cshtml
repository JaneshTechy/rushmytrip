@model BlogVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var isEdit = Model.Blog.BlogPostId > 0;
}

<script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
<script src="https://cdn.tailwindcss.com?plugins=typography"></script>

<div class="space-y-10">

    <div>
        <h1 class="text-2xl font-black text-slate-800 uppercase">
            @(isEdit ? "Edit Blog" : "Create Blog")
        </h1>
        <p class="text-sm text-slate-500">
            Manage blog content and SEO settings.
        </p>
    </div>

    <form asp-action="@(isEdit ? "EditBlog" : "CreateBlog")"
          method="post"
          enctype="multipart/form-data"
          class="space-y-8">

        <input type="hidden" asp-for="Blog.BlogPostId" />
        <input type="hidden" asp-for="Blog.WebsiteId" />

        @* BLOG CONTENT *@
        <section class="bg-white rounded-3xl border border-slate-200 p-8 space-y-6">

            <h3 class="font-bold text-slate-700 text-sm uppercase">
                Blog Content
            </h3>

            <div>
                <label class="text-xs font-bold text-slate-500 uppercase">Title</label>
                <input asp-for="Blog.Title"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
            </div>

            <div>
                <label class="text-xs font-bold text-slate-500 uppercase">Sub Heading</label>
                <input asp-for="Blog.SubHeading"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
            </div>

            <div>
                <label class="text-xs font-bold text-slate-500 uppercase">Slug</label>
                <input asp-for="Blog.Slug"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
                <span asp-validation-for="Blog.Slug" class="text-red-500 text-xs"></span>
            </div>

            <div class="grid grid-cols-2 gap-8">

                @* ✅ Editor *@
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">Content</label>

                    <textarea asp-for="Blog.Content"
                              rows="12"
                              class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"></textarea>
                </div>

                @* ✅ Live Preview *@
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">Live Preview</label>

                    <div id="previewBox"
                         class="bg-white border border-slate-200 rounded-xl p-6
                                prose max-w-none min-h-[450px]">
                    </div>
                </div>

            </div>

        </section>

        @* SEO SECTION *@
        <section class="bg-white rounded-3xl border border-slate-200 p-8 space-y-6">

            <h3 class="font-bold text-slate-700 text-sm uppercase">
                SEO Settings
            </h3>

            <div>
                <label class="text-xs font-bold text-slate-500 uppercase">Meta Title</label>
                <input asp-for="Blog.MetaTitle"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
            </div>

            <div>
                <label class="text-xs font-bold text-slate-500 uppercase">Meta Description</label>
                <textarea asp-for="Blog.MetaDescription"
                          rows="3"
                          class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"></textarea>
            </div>

            <div>
                <label class="text-xs font-bold text-slate-500 uppercase">Meta Keywords</label>
                <input asp-for="Blog.MetaKeywords"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
            </div>

            <div>
                <label class="text-xs font-bold text-slate-500 uppercase">
                    Feature Image
                </label>

                <input type="file"
                       id="featureImageInput"
                       name="FeatureImageFile"
                       accept="image/*"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm mt-2" />

                @* ✅ Preview Box *@
                <div class="mt-4">
                    <img id="featureImagePreview"
                         src="@Model.Blog.FeatureImageUrl"
                         class="rounded-xl border border-slate-200 shadow-sm max-h-48 @(string.IsNullOrEmpty(Model.Blog.FeatureImageUrl) ? "hidden" : "")" />
                </div>
            </div>

            <div>
                <label class="text-xs font-bold text-slate-500 uppercase">Status</label>
                <select asp-for="Blog.Status"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm">
                    <option value="draft">Draft</option>
                    <option value="published">Published</option>
                </select>
            </div>

        </section>
          <section class="bg-white rounded-3xl border border-slate-200 p-8 space-y-6">

    <div class="flex items-center justify-between">
        <div>
            <h3 class="font-bold text-slate-700 text-sm uppercase">
                FAQ Section
            </h3>
            <p class="text-sm text-slate-500">
                Add frequently asked questions for this blog.
            </p>
        </div>

        <button type="button"
                onclick="addFaqRow()"
                class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700
                       text-white text-sm font-semibold shadow">
            + Add FAQ
        </button>
    </div>

    <div id="faqContainer" class="space-y-4">

        @for (int i = 0; i < Model.FAQs.Count; i++)
        {
            <div class="faq-row border border-slate-200 rounded-2xl p-5 bg-slate-50 space-y-4">

                <input type="hidden"
                       name="FAQs[@i].FaqId"
                       value="@Model.FAQs[i].FaqId" />

                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Question
                    </label>
                    <input type="text"
                           name="FAQs[@i].Question"
                           value="@Model.FAQs[i].Question"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"
                           placeholder="Enter FAQ Question" />
                </div>

                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">
                        Answer
                    </label>
                    <textarea name="FAQs[@i].Answer"
                              rows="4"
                              class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"
                              placeholder="Enter FAQ Answer">@Model.FAQs[i].Answer</textarea>
                </div>

                <div class="flex items-center justify-between">
                    <div class="w-32">
                        <label class="text-xs font-bold text-slate-500 uppercase">
                            Sort Order
                        </label>
                        <input type="number"
                               name="FAQs[@i].SortOrder"
                               value="@Model.FAQs[i].SortOrder"
                               class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
                    </div>

                    <button type="button"
                            onclick="removeFaq(this)"
                            class="px-4 py-2 rounded-xl bg-red-500 hover:bg-red-600
                                   text-white text-sm font-medium">
                        Remove
                    </button>
                </div>

            </div>
        }

    </div>

</section>
        <div class="flex justify-end">
            <button class="px-10 py-3 rounded-xl bg-orange-500 hover:bg-orange-600
                           text-white font-bold text-sm shadow-lg">
                @(isEdit ? "Update Blog" : "Create Blog")
            </button>
        </div>

    </form>

</div>

<script>
    ClassicEditor
        .create(document.querySelector('#Blog_Content'), {

            toolbar: [
                'heading',
                '|',
                'bold', 'italic', 'underline',
                '|',
                'link',
                'bulletedList',
                'numberedList',
                '|',
                'insertTable',
                'blockQuote',
                '|',
                'undo',
                'redo'
            ],

            heading: {
                options: [
                    { model: 'paragraph', title: 'Paragraph' },
                    { model: 'heading1', view: 'h1', title: 'H1' },
                    { model: 'heading2', view: 'h2', title: 'H2' },
                    { model: 'heading3', view: 'h3', title: 'H3' },
                    { model: 'heading4', view: 'h4', title: 'H4' },
                    { model: 'heading5', view: 'h5', title: 'H5' }
                ]
            }

        })
        .then(editor => {

            const previewBox = document.querySelector('#previewBox');

            previewBox.innerHTML = editor.getData();

            editor.model.document.on('change:data', () => {
                previewBox.innerHTML = editor.getData();
            });

        })
        .catch(error => {
            console.error(error);
        });
</script>
<script>
    document.getElementById("featureImageInput")
        .addEventListener("change", function (event) {

            const file = event.target.files[0];
            const preview = document.getElementById("featureImagePreview");

            if (!file) return;

            const reader = new FileReader();

            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.classList.remove("hidden");
            };

            reader.readAsDataURL(file);
        });

        
</script>
<script>
    let faqIndex = @Model.FAQs.Count;

    function addFaqRow() {
    let html = `
    <div class="faq-row border border-slate-200 rounded-2xl p-5 bg-slate-50 space-y-4">

        <div>
            <label class="text-xs font-bold text-slate-500 uppercase">Question</label>
            <input type="text"
                   name="FAQs[${faqIndex}].Question"
                   class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"
                   placeholder="Enter FAQ Question" />
        </div>

        <div>
            <label class="text-xs font-bold text-slate-500 uppercase">Answer</label>
            <textarea rows="4"
                      name="FAQs[${faqIndex}].Answer"
                      class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm"
                      placeholder="Enter FAQ Answer"></textarea>
        </div>

        <div class="flex items-center justify-between">
            <div class="w-32">
                <label class="text-xs font-bold text-slate-500 uppercase">Sort Order</label>
                <input type="number"
                       name="FAQs[${faqIndex}].SortOrder"
                       value="0"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm" />
            </div>

            <button type="button"
                    onclick="removeFaq(this)"
                    class="px-4 py-2 rounded-xl bg-red-500 hover:bg-red-600 text-white text-sm font-medium">
                Remove
            </button>
        </div>

    </div>`;

    document.getElementById('faqContainer')
        .insertAdjacentHTML('beforeend', html);

    faqIndex++;
}

    function removeFaq(btn) {
        btn.closest('.faq-row').remove();
    }
</script>