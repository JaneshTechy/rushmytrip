                           @*  <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    <button onclick="loadPassengers(@b.BookingId)" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-tight bg-white border border-slate-200 text-slate-600 hover:border-orange-500 hover:text-orange-600 transition shadow-sm">Pax</button>
<button onclick="loadSegments(@b.BookingId, '@b.FlightClass', '@b.FlightWay')" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-tight bg-white border border-slate-200 text-slate-600 hover:border-orange-500 hover:text-orange-600 transition shadow-sm">
