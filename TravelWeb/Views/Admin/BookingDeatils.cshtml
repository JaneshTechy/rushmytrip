</button>                                    <button onclick="loadPriceDetails(@b.BookingId)" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-tight bg-white border border-slate-200 text-slate-600 hover:border-green-600 hover:text-green-600 transition shadow-sm">Price</button>
                                    <button onclick="loadContactDetails(@b.BookingId)" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-tight bg-white border border-slate-200 text-slate-600 hover:border-green-600 hover:text-green-600 transition shadow-sm">Contact</button>
                                    <button onclick="loadCard(@b.BookingId)" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-tight bg-slate-900 text-white hover:bg-black transition shadow-md"><i class="fas fa-credit-card"></i></button>
                                    <button onclick="loadRemarks(@b.BookingId)"
                                            class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-tight
               bg-white border border-slate-200 text-slate-600
               hover:border-indigo-500 hover:text-indigo-600 transition shadow-sm">
                                        Remarks
                                    </button>
