            </button>
            <button onclick="sendCancellationEmail(@b.BookingId)"
        class="w-full text-left px-3 py-2 text-[11px] hover:bg-red-50 text-red-600">
    Cancellation Email
</button>
<button onclick="deleteBooking(@b.BookingId)"
