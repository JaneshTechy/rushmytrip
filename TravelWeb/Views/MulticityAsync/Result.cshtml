                        </svg>
                        <span data-i18n="result.pricesUpdating">Prices Updating Fast</span>
                    </span>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="wrap-cards row-col-static" id="sticky-parent" data-gutter="20" style="color:#0b1f66;">
                <button class="mobile-filter-btn" type="button" onclick="document.querySelector('.sidebar-search-results').classList.toggle('active')">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <line x1="4" y1="6" x2="20" y2="6" stroke-width="2" />
                        <line x1="7" y1="12" x2="17" y2="12" stroke-width="2" />
                        <line x1="10" y1="18" x2="14" y2="18" stroke-width="2" />
                    </svg>
                    <span data-i18n="result.filters">Filters</span>
                </button>

                <aside class="sidebar-search-results" id="divLeftPanel">
                    <div class="sidebar-in">
                        <div class="price-summary">
                            <h6 class="ps-route" id="mcSideRoute">Multi-city</h6>
                            <div class="ps-price">
                                <sup id="mcSideCurrency">@currencySymbol</sup><span id="mcSidePrice">—</span>
                            </div>
                            <div class="ps-meta"><span data-i18n="result.perPerson">per person</span> · Multi-city</div>
                            <div class="ps-badge" data-i18n="result.lowestPrice">Lowest Price Found</div>
                        </div>

                        <div class="sidebar-card">
                            <div class="sidebar-card-title">Flights</div>
                            <div id="mcSideLegs"></div>
                        </div>

                        <div class="sidebar-card card-booking">
                            <h3>Need help booking?</h3>
                            <p>Our travel experts are available 24/7 to find you the best deal.</p>
                            <a href="tel:+18555104060" class="btn-primary-results d-flex gap-5" style="justify-content:center;">
                                +1-855-510-4060
                            </a>
                        </div>
                    </div>
                </aside>

                <article class="cards-result" id="flightsBox">
                    <div id="loaderassss" class="loaderassssedeed" style="display:block;"></div>
                    <div class="all-results" id="dvResult"></div>
                </article>
            </div>
            <div class="sidebar-overlay" onclick="document.querySelector('.sidebar-search-results').classList.remove('active')"></div>
        </div>
    </div>
</div>

@* Same wait modal pattern as /result *@
<div id="myModal" class="modal fade modal-dialog-centered" style="display:block;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="row" style="width:100%;">
                    <div class="col-4"></div>
                    <div class="col-4">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 263.2 56" width="200" height="64" role="img" aria-label="RushMyTrip"><g transform="scale(0.8750)"><path d="M5 55C3 38 25 34 28 45C31 57 11 56 17 39C23 22 38 23 49 17" fill="none" stroke="#18213A" stroke-width="3.6" stroke-linecap="round" stroke-dasharray="7 6"></path><g transform="translate(52 14) scale(.62) translate(-32 -31.5)"><path d="M14 30 L50 14 L36 50 L29 36 Z" fill="#18213A" stroke="#18213A" stroke-width="2" stroke-linejoin="round"></path><path d="M29 36 L50 14 L34 43 Z" fill="#18213A"></path></g></g><path d="M72.45 41.3H77.38V31.11L84.36 41.3H90.45L83.25 31.47C88.04 30.29 90.2 27.37 90.2 23.23C90.2 20.53 89.22 18.23 87.39 16.68C85.66 15.2 83.75 14.7 80.12 14.7H72.45ZM77.38 27.41V19.41H79.58C84.26 19.41 85.23 21 85.23 23.37C85.23 26.18 83.61 27.41 79.79 27.41ZM92.82 32.05C92.82 39.07 95.78 41.77 100.42 41.77C102.83 41.77 104.34 41.16 106.14 39.39V41.3H110.57V21.36H105.78V30.75C105.78 33.42 105.57 34.64 105.03 35.54C104.31 36.69 103.01 37.38 101.39 37.38C99.09 37.38 97.61 36.41 97.61 31.11V21.36H92.82ZM113.16 34.97C113.67 39.61 116.51 41.77 120.47 41.77C124.47 41.77 127.6 38.78 127.6 34.97C127.6 32.01 126.23 30.43 122.06 29.13C118.78 28.09 118.67 28.02 118.67 26.97C118.67 26 119.46 25.28 120.51 25.28C121.52 25.28 122.16 25.82 122.38 26.87H127.06C126.88 23.12 123.89 20.89 120.51 20.89C116.8 20.89 113.88 23.55 113.88 26.97C113.88 29.89 115.47 31.55 119.43 32.88C122.63 33.96 122.81 34.28 122.81 35.43C122.81 36.55 121.88 37.38 120.65 37.38C119.25 37.38 118.46 36.66 117.99 34.97ZM130.26 41.3H135.05V31.19C135.05 26.79 136.53 25.28 139.26 25.28C142.07 25.28 143.15 26.94 143.15 31.11V41.3H147.94V30.03C147.94 23.48 144.92 20.85 140.13 20.85C138.08 20.85 136.49 21.43 135.05 22.73V14.7H130.26Z" fill="#18213A"></path><path d="M152.37 41.3H157.3V21.36L164.25 41.3H168.28L175.23 21.36V41.3H180.16V14.7H173.39L166.3 34.86L159.14 14.7H152.37ZM182.54 21.36 189.84 39.43 186.1 47.96H191.25L202.77 21.36H197.26L192.44 34.28L188.01 21.36Z" fill="#1c3f94"></path><path d="M203.45 19.41H208.38V41.3H213.32V19.41H218.25V14.7H203.45ZM220.26 41.3H225.05V30.21C225.05 27.12 226.46 25.57 229.34 25.5V20.89H228.98C226.92 20.89 225.92 21.47 224.66 23.3V21.36H220.26ZM231.78 41.3H236.57V21.36H231.78ZM231.82 18.48H236.61V13.69H231.82ZM240.42 47.96H245.21V39.43C247.01 41.05 248.88 41.77 251.33 41.77C257.09 41.77 261.3 37.31 261.3 31.26C261.3 25.25 257.13 20.89 251.37 20.89C248.67 20.89 246.36 21.9 244.82 23.7V21.36H240.42ZM244.92 31.29C244.92 27.87 247.44 25.28 250.76 25.28C254 25.28 256.48 27.91 256.48 31.37C256.48 34.75 254 37.38 250.83 37.38C247.44 37.38 244.92 34.79 244.92 31.29Z" fill="#18213A"></path></svg>
                    </div>
                    <div class="col-4"></div>
                </div>
            </div>
            <div class="modal-body" style="text-align:center">
                <div class="plsWaitCaption">
                    <p data-i18n="result.pleaseWait">Please Wait For Your Flights...</p>
                    <p data-i18n="result.searchingDeals">Let us search the best Flight Deals For You.</p>
                </div>
                <h2 id="mcModalRoute">Multi-city</h2>
            </div>
            <div class="modal-footer">
                <div class="diparCaptionBox">
                    <div class="row" id="mcModalLegs"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show" id="mcModalBackdrop"></div>

<script src="~/scripts/multicity-search.js?v=20260721c"></script>
<script>
(function () {
    function getQueryParam(name) {
        return new URLSearchParams(window.location.search).get(name);
    }

    function airportCode(val) {
        if (!val) return '';
        return String(val).split('-')[0].trim().toUpperCase();
    }

    function airportCity(val) {
        if (!val) return '';
        var parts = String(val).split('-');
        if (parts.length < 2) return airportCode(val);
        return parts[1].split(',')[0].trim();
    }

    function cabinLabel(code) {
        switch ((code || 'Y').toUpperCase()) {
            case 'F': case '1': return 'First';
            case 'B': case '2': return 'Business';
            case 'P': case '3': return 'Premium';
            default: return 'Economy';
        }
    }

    function hideWaitModal() {
        $('#myModal').hide();
        $('#mcModalBackdrop').remove();
        $('body').removeClass('modal-open');
    }

    function fillHeaderFromRequest(request) {
        if (!request || !request.legs || !request.legs.length) return;
        var legs = request.legs;

        var cities = [];
        legs.forEach(function (l, i) {
            cities.push(airportCity(l.from) || airportCode(l.from));
            if (i === legs.length - 1) {
                cities.push(airportCity(l.to) || airportCode(l.to));
            }
        });
        var flow = cities.filter(function (c, i, a) { return i === 0 || c !== a[i - 1]; });
        var arrow = ' <svg width="26" height="13" viewBox="0 0 26 13" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M23.283 5.80716L18.2373 0.95335L19.2315 0L26 6.5L19.2315 13L18.2013 12.0467L23.2556 7.19284H12.9863V5.80716H23.283ZM5.77169 5.80716H10.1005V7.19284H5.77169V5.80716ZM0 5.80716H2.88584V7.19284H0V5.80716Z" fill="#1B2A4A" /></svg> ';
        $('#mcRouteTitle').html(flow.join(arrow) + ' <span>&bull; Multi-city</span>');

        var codes = legs.map(function (l) { return airportCode(l.from) + ' → ' + airportCode(l.to); });
        $('#mcHeroRoute').val(codes.join('  ·  '));
        $('#mcSideRoute').text(codes.join(' · '));
        $('#mcModalRoute').text(codes.join(' · '));
        $('#mcSideLegs').html(codes.map(function (c, i) {
            return '<span class="mc-leg-chip">Flight ' + (i + 1) + ': ' + c + '</span>';
        }).join(''));

        $('#mcModalLegs').html(legs.map(function (l, i) {
            return '<div class="col-lg-4 col-md-4 col-sm-4 col-xs-12" id="diparBox">' +
                '<strong style="color:black">Flight ' + (i + 1) + '</strong>' +
                '<p style="color:black!important">' + airportCode(l.from) + ' → ' + airportCode(l.to) + '<br/>' + (l.depDate || '') + '</p>' +
                '</div>';
        }).join(''));

        var dates = legs.map(function (l) { return l.depDate; }).filter(Boolean);
        $('#mcDateChip').text(dates.join(' → '));
        $('#mcHeroDates').val(dates.join(' → '));

        var adult = request.adult || 1;
        var child = request.child || 0;
        var infant = request.infant || 0;
        var pax = adult + (adult === 1 ? ' Adult' : ' Adults');
        if (child > 0) pax += ' ' + child + (child === 1 ? ' Child' : ' Children');
        if (infant > 0) pax += ' ' + infant + (infant === 1 ? ' Infant' : ' Infants');
        $('#mcPaxChip').text(pax);

        var cabin = cabinLabel(request.cabin);
        $('#mcCabinChip').text(cabin);
        if ($('#flight_class_select').length) {
            var cabinVal = '4';
            switch ((request.cabin || 'Y').toString().toUpperCase()) {
                case 'F': case '1': cabinVal = '1'; break;
                case 'B': case '2': cabinVal = '2'; break;
                case 'P': case '3': cabinVal = '3'; break;
            }
            $('#flight_class_select').val(cabinVal);
        }
        $('#pass_info').val((adult + child + infant) + ' Pax, ' + cabin);
        if ($('#flight_adult').length) {
            $('#flight_adult').val(adult);
            $('#flight_child').val(child);
            $('#flight_infant').val(infant);
        }
    }

    function showError(msg) {
        hideWaitModal();
        $('#loaderassss').hide();
        $('#dvResult').html(
            '<div class="card-result" style="padding:28px;text-align:center;">' +
            '<h3>Sorry! No Result Found</h3><p>' + (msg || 'Something went wrong.') + '</p>' +
            '<a href="/" class="btn-primary-results" style="display:inline-block;width:auto;margin-top:12px;">Search Again</a></div>'
        );
    }

    function loadResults(searchId) {
        $.ajax({
            url: '@(Common.WebSitePath)MulticityAsync/Results',
            type: 'GET',
            data: { searchId: searchId },
            success: function (html) {
                hideWaitModal();
                $('#loaderassss').hide();
                $('#dvResult').html(html);
                var minPrice = $('#mcMinPrice').val();
                if (minPrice) $('#mcSidePrice').text(minPrice);
                if (window.refreshPageI18n) refreshPageI18n();
            },
            error: function () {
                showError('Failed to load combined results.');
            }
        });
    }

    function startSearchFromQuery() {
        var raw = sessionStorage.getItem('multicityAsyncRequest');
        if (!raw) {
            showError('No multicity search found. Please start a new search from home.');
            return;
        }

        var request;
        try { request = JSON.parse(raw); } catch (e) {
            showError('Invalid multicity search payload.');
            return;
        }

        fillHeaderFromRequest(request);

        $.ajax({
            url: '@(Common.WebSitePath)MulticityAsync/Search',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(request),
            success: function (res) {
                if (!res || !res.success) {
                    showError((res && res.error) || 'No multicity results found.');
                    return;
                }
                if (res.minPrice) $('#mcSidePrice').text(res.minPrice);
                var url = new URL(window.location.href);
                url.searchParams.set('searchID', res.searchId);
                window.history.replaceState({}, '', url.toString());
                loadResults(res.searchId);
            },
            error: function (xhr) {
                showError(xhr.responseText || 'Multicity search failed.');
            }
        });
    }

    $(function () {
        $('body').addClass('modal-open');

        function t(key, fallback) {
            return (window.SiteI18n && SiteI18n.t) ? SiteI18n.t(key, fallback) : fallback;
        }

        function setAmendBtnLabel(isOpen) {
            var $btn = $('#mcAmendSearchBtn');
            var label = isOpen ? t('result.hideSearch', 'Hide Search') : t('result.amendSearch', 'Amend Search');
            $btn.text(label);
            $btn.attr('data-i18n', isOpen ? 'result.hideSearch' : 'result.amendSearch');
        }

        // Collapsible amend search (own handler — avoids myjs #amendSearchBtn double-toggle)
        $('#mcAmendSearchBtn').off('click.mcToggle').on('click.mcToggle', function (e) {
            e.preventDefault();
            var $section = $('#Search-Section');
            $section.toggleClass('opened');
            setAmendBtnLabel($section.hasClass('opened'));
        });
        // Start collapsed
        $('#Search-Section').removeClass('opened');
        setAmendBtnLabel(false);

        // Prefill home-style Multicity amend search from session
        var raw = sessionStorage.getItem('multicityAsyncRequest');
        var request = null;
        if (raw) {
            try { request = JSON.parse(raw); } catch (e) { request = null; }
        }

        if (request) {
            fillHeaderFromRequest(request);
            if (window.MulticitySearch && typeof MulticitySearch.prefill === 'function') {
                MulticitySearch.prefill(request);
            } else if (window.MulticitySearch) {
                MulticitySearch.show(true);
            }
        } else if (window.MulticitySearch) {
            MulticitySearch.show(true);
        }

        // Search Again = same as home Multicity search
        $('#mc_search_btn').off('click.mcSearch').on('click.mcSearch', function (e) {
            e.preventDefault();
            if (window.MulticitySearch && typeof MulticitySearch.submit === 'function') {
                MulticitySearch.submit();
            }
        });

        // Passenger popup (same as home)
        $('#pass_info').off('click.mcAmend').on('click.mcAmend', function (e) {
            e.stopPropagation();
            $('#FlySearchPassengers').slideToggle();
        });
        $('#prsn_done').off('click.mcAmend').on('click.mcAmend', function () {
            if (window.MulticitySearch && MulticitySearch.updatePassengerSummary) {
                MulticitySearch.updatePassengerSummary();
            }
            $('#FlySearchPassengers').slideUp();
        });
        $(document).off('click.mcAmendDoc').on('click.mcAmendDoc', function (e) {
            if (!$(e.target).closest('#FlySearchPassengers, #pass_info, .passenger-box').length) {
                $('#FlySearchPassengers').slideUp();
            }
        });
        $(document).off('click.mcAmendInc', '.inc_der').on('click.mcAmendInc', '.inc_der', function () {
            setTimeout(function () {
                if (window.MulticitySearch && MulticitySearch.updatePassengerSummary) {
                    MulticitySearch.updatePassengerSummary();
                }
            }, 50);
        });
        $('#flight_class_select').off('change.mcAmend').on('change.mcAmend', function () {
            if (window.MulticitySearch && MulticitySearch.updatePassengerSummary) {
                MulticitySearch.updatePassengerSummary();
            }
        });

        var existing = getQueryParam('searchID');
        if (existing) {
            loadResults(existing);
        } else {
            startSearchFromQuery();
        }
    });
})();
</script>
