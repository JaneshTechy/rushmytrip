@{
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
}

@{
    var scheme = Context.Request.Scheme;
    var host = Context.Request.Host.Value;
    var path = Context.Request.Path.Value;
    var query = Context.Request.QueryString.Value;

    var fullUrl = $"{scheme}://{host}{path}{query}";

    // Use <title> if defined, otherwise fallback
    var ogTitle = !string.IsNullOrWhiteSpace(ViewData["Title"]?.ToString())
        ? ViewData["Title"]!.ToString()
        : "RushMyFlight - Fast, Secure, and guaranteed lowest prices!";

    var ogDescription = !string.IsNullOrWhiteSpace(ViewData["Description"]?.ToString())
        ? ViewData["Description"]!.ToString()
        : "RushMyFlight - Fast, Secure, and guaranteed lowest prices!";

    var ogImage = !string.IsNullOrWhiteSpace(ViewData["OgImageAlt"]?.ToString())
    ? ViewData["OgImageAlt"].ToString()
    : "";

    var ogImageAlt = !string.IsNullOrWhiteSpace(ViewData["OgImageAlt"]?.ToString())
        ? ViewData["OgImageAlt"].ToString()
        : ogTitle;

    // Detect page type automatically
    var ogType = path == "/" ? "website" : "article";
}

