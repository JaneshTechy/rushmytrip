    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentFlag = document.getElementById("current-flag");
            const hostname = window.location.hostname.toLowerCase();

            // Define flag image URLs
            const indiaFlag = "https://upload.wikimedia.org/wikipedia/commons/thumb/4/41/Flag_of_India.svg/800px-Flag_of_India.svg.png";
            const usFlag = "https://upload.wikimedia.org/wikipedia/commons/thumb/a/a4/Flag_of_the_United_States.svg/800px-Flag_of_the_United_States.svg.png";

            // Logic to decide which flag to show by default
            if (hostname.includes(".in")) {
                currentFlag.src = indiaFlag;
                currentFlag.alt = "India Flag";
            } else {
                currentFlag.src = usFlag;
                currentFlag.alt = "US Flag";
            }
        });
    </script>
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            // Non-critical session sync: run after first paint.
            setTimeout(function () {
                fetch("@(TravelWeb.Utilities.Common.WebSitePath)Common/SetSession", {
                    method: 'GET',
                    credentials: 'same-origin'
                }).catch(function () { });
            }, 1000);
        });
    </script>

