    <script>
        const mobileDrawer = document.getElementById('mobileDrawer');
        const hamburger = document.querySelector('.hamburger');

        function toggleDrawer() {
            mobileDrawer.classList.toggle('open');
        }

        // Close drawer when clicking outside
        document.addEventListener('click', function (event) {
            const isOpen = mobileDrawer.classList.contains('open');
            if (!isOpen) return;

            const clickInsideDrawer = mobileDrawer.contains(event.target);
            const clickOnHamburger = hamburger.contains(event.target);

            // If clicking outside drawer AND not clicking on hamburger → close drawer
            if (!clickInsideDrawer && !clickOnHamburger) {
                mobileDrawer.classList.remove('open');
            }
        });

    </script>

