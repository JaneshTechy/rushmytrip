    .header-main a {
        text-decoration: none;
    }

    .header-main nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: 80rem;
        margin: 0 auto;
        padding: 0 1.25rem;
    }

    .header-main nav > a:first-child {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        color: #fff;
        transition: color 0.3s ease;
    }

    .header-main nav > a:first-child > span:first-child {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        flex-shrink: 0;
        border-radius: 0.75rem;
        background: linear-gradient(135deg, #4f7fe0, #1c3f94);
        color: #fff;
        font-size: 1.125rem;
        box-shadow: 0 8px 20px -6px rgba(28, 63, 148, 0.4);
    }

    .header-main nav > a:first-child > span:last-child {
        color: rgba(7, 18, 43, 0.7);
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        white-space: nowrap;
    }

    .header-main nav > a:first-child > span:last-child > span {
        color: #4f7fe0;
        transition: color 0.3s ease;
    }

    .header-main.is-scrolled nav > a:first-child {
        color: #07122b;
    }

    .header-main.is-scrolled nav > a:first-child > span:last-child > span {
        color: #1c3f94;
    }

    .header-main nav > ul {
        display: none;
        align-items: center;
        gap: 0.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
        color: #334155;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .header-main nav > ul a {
        display: block;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        color: inherit;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .header-main nav > ul a:hover,
    .header-main #mobileMenu a:hover {
        background: #eef4ff;
        color: #16327a;
    }

    .header-main nav > div {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .header-main nav > div > span {
        display: none;
        align-items: center;
        gap: 0.5rem;
        color: #475569;
        font-size: 0.875rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .header-main nav > div > span > span {
        position: relative;
        display: flex;
        width: 0.5rem;
        height: 0.5rem;
        flex-shrink: 0;
    }

    .header-main nav > div > span > span > span:first-child {
        position: absolute;
        display: inline-flex;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: #34d399;
        opacity: 0.75;
        animation: header-main-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    .header-main nav > div > span > span > span:last-child {
        position: relative;
        display: inline-flex;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: #10b981;
    }

    @@keyframes header-main-ping {
        75%, 100% {
            transform: scale(2);
            opacity: 0;
        }
    }

    .header-main nav > div > label {
        display: none;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid #e2e8f0;
        border-radius: 9999px;
        color: #334155;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .header-main nav > div > label > i {
        color: #94a3b8;
    }

    .header-main nav > div > label > select {
        max-width: 5rem;
        border: 0;
        outline: none;
        background: transparent;
        color: inherit;
        font: inherit;
        cursor: pointer;
    }

    .header-main nav > div > a {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        border-radius: 9999px;
        background: #1c3f94;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 8px 20px -6px rgba(28, 63, 148, 0.4);
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .header-main nav > div > a:hover {
        transform: translateY(-2px);
        background: #16327a;
    }

    .header-main nav > div > button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        flex-shrink: 0;
        border: 0;
        border-radius: 50%;
        background: #07122b;
        color: #fff;
        font-size: 1.125rem;
        cursor: pointer;
    }

    .header-main #mobileMenu {
        margin: 0 1rem 1rem;
        padding: 0.75rem;
        overflow: hidden;
        border-radius: 1.5rem;
        background: #fff;
        box-shadow: 0 10px 25px -5px rgba(7, 18, 43, 0.12);
        border: 1px solid #e2e8f0;
    }

    .header-main #mobileMenu[hidden] {
        display: none;
    }

    .header-main #mobileMenu a {
        display: block;
        padding: 0.75rem 1rem;
        border-radius: 1rem;
        color: #07122b;
        font-weight: 600;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .header-main #mobileMenu p {
        padding: 0.5rem 1rem 0;
        color: #64748b;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .header-main #mobileMenu a:last-child {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        padding: 0.75rem 1rem;
        border-radius: 1rem;
        background: #1c3f94;
        color: #fff;
        font-weight: 700;
    }

    .header-main #mobileMenu a:last-child:hover {
        background: #16327a;
        color: #fff;
    }

    @@media (min-width: 640px) {
        .header-main nav > div > a {
            display: inline-flex;
        }
    }

    @@media (min-width: 768px) {
        .header-main nav > div > label {
            display: inline-flex;
        }
    }

    @@media (min-width: 1024px) {
        .header-main nav > ul {
            display: flex !important;
        }

        .header-main nav > div > button,
        .header-main #mobileMenu {
            display: none;
        }
    }

    @@media (min-width: 1280px) {
        .header-main nav > div > span {
            display: inline-flex;
        }
    }

    @@media (max-width: 639px) {
        .header-main nav {
            gap: 0.5rem;
            padding: 0.75rem 1rem;
        }

        .header-main nav > div {
            gap: 0.5rem;
        }

        .header-main nav > a:first-child {
            gap: 0.5rem;
        }

        .header-main nav > a:first-child > span:last-child {
            font-size: 1.1rem;
        }
    }
    .bg-ink-900 {
        --tw-bg-opacity: 1;
        background-color: rgb(7 18 43 / var(--tw-bg-opacity, 1));
    }
    </style>
</head>
