    <script>
        (function () {
            function loadScript(src, attrs) {
                var s = document.createElement('script');
                s.src = src;
                s.async = true;
                if (attrs) {
                    Object.keys(attrs).forEach(function (k) { s.setAttribute(k, attrs[k]); });
                }
                document.body.appendChild(s);
            }

            function loadThirdParty() {
                // Delay analytics and chat so homepage can render first.
                window.dataLayer = window.dataLayer || [];
                window.gtag = window.gtag || function () { dataLayer.push(arguments); };
                gtag('js', new Date());
                gtag('config', 'UA-73456368-1');
                gtag('config', 'UA-226542344-1');
                gtag('config', 'G-PZQEDD4HKJ');
                loadScript('https://www.googletagmanager.com/gtag/js?id=G-PZQEDD4HKJ');

                window.Tawk_API = window.Tawk_API || {};
                window.Tawk_LoadStart = new Date();
                loadScript('https://embed.tawk.to/664d97d99a809f19fb33925c/1hufhib3c', { crossorigin: '*' });

                // Optional libraries loaded on demand after main content.
                loadScript('//cdn.jsdelivr.net/npm/sweetalert2@11');
                loadScript('https://cdnjs.cloudflare.com/ajax/libs/card/2.5.4/card.js', {
