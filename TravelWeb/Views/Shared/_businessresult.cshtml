                    @{
                        var inSegments = items.Inbound ?? new List<FlightsSegment>();


                        var inFirst = inSegments.FirstOrDefault();

                        var inLast = inSegments.LastOrDefault();


                        TimeSpan inTotal = TimeSpan.Zero;


                        foreach (var seg in inSegments)
                        {
                            if (!string.IsNullOrEmpty(seg?.ElapsedTime))
                            {
                                inTotal += XmlConvert.ToTimeSpan(seg.ElapsedTime);

                            }
                        }//Total time
                        string inTotalTime = $"{(int)inTotal.TotalHours}h {inTotal.Minutes}m";


                        // Departure time
                        string indepDate = DateTime.TryParse(inFirst?.DepDate, out var data) ? data.ToString("HH:mm") : "";


                        // Arrival time
                        string inArrTime = DateTime.TryParse(inLast?.ArrDate, out var daat) ? daat.ToString("HH:mm") : "";


                        // Number of stops
                        int inStop = Math.Max(inSegments.Count - 1, 0);


                        // Stop codes
                        List<string> instopCodes = inSegments

                        .Skip(1).Select(x => x?.FromAirport?.Code).Where(x => !string.IsNullOrEmpty(x)).ToList();


                        // Cabin class
                        string INcabinFullName = inFirst?.CabinClass switch
                        {
                            "F" => "First",

                            "B" => "Business",

                            "Y" => "Economy",

                            "P" => "Premium",

                            null => "",

                            _ => "Unknown"
                        }
                        ;
                    }
                        @if (items.Inbound.Count > 0)
                        {
                            <div class="row-flight d-flex space-between">
                                <div class="title-flight d-flex">
                                    <div class="short-name d-flex" style="background-color: #AF663E;">@inFirst.OperatingAirline.Code</div>
                                    <div>
                                        <h5>@inFirst.Airline.Name</h5>
                                        <h6>@INcabinFullName</h6>
                                    </div>
                                </div>
                                <div class="detailed-flight d-flex space-between">
                                    <div class="flight">
                                        <div class="time">@indepDate</div>
                                        <div class="country-block">@inFirst.FromAirport.Code</div>
                                        <div class="date">@(Convert.ToDateTime(inFirst.DepDate).ToString("ddd, MMM dd"))</div>
                                    </div>
                                    <div class="range">
                                        <div class="time-total">@inTotalTime</div>
                                        <div class="bar-flight">
                                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M4.66665 12.8332H5.83331L8.74998 7.87484H11.9583C12.4425 7.87484 12.8333 7.484 12.8333 6.99984C12.8333 6.51567 12.4425 6.12484 11.9583 6.12484H8.74998L5.83331 1.1665H4.66665L6.12498 6.12484H2.91665L2.04165 4.6665H1.16665L1.74998 6.99984L1.16665 9.33317H2.04165L2.91665 7.87484H6.12498L4.66665 12.8332Z" fill="#D05E2B" />
                                            </svg>
                                        </div>
                                        <div class="badge-stops">
                                            @if (inStop == 0)
                                            {
                                                <span>Non-stop</span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @inStop stop@(inStop > 1 ? "s" : "") :
                                                    @string.Join("·", instopCodes)
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flight">
                                        <div class="time">@inArrTime</div>
                                        <div class="country-block">@inLast.ToAirport.Code</div>
                                        <div class="date">@(Convert.ToDateTime(inFirst.ArrDate).ToString("ddd, MMM dd"))</div>
                                    </div>
                                </div>
                                <div class="total-timing d-flex gap-5">
                                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M6 10.8C8.64 10.8 10.8 8.64 10.8 6C10.8 3.36 8.64 1.2 6 1.2C3.36 1.2 1.2 3.36 1.2 6C1.2 8.64 3.36 10.8 6 10.8ZM6 0C9.3 0 12 2.7 12 6C12 9.3 9.3 12 6 12C2.7 12 0 9.3 0 6C0 2.7 2.7 0 6 0ZM9 7.14L8.58 7.92L5.4 6.18V3H6.3V5.64L9 7.14Z" fill="#4B4E52" />
                                    </svg>
                                    <span>@inTotalTime</span>
                                </div>
                            </div>
                        }
