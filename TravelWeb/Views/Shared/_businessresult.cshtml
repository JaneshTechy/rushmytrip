@using System.Xml
@using TravelWeb.Models;
@model FlightsResult;
@{
    double InfantTaxAmt = ((Model.FlightsList.Select(x => x.FlightFare.InfantFare).FirstOrDefault())/*+ Model.FlightFare.InfantMarkup*/) /** 0.40*/;


    var TotalAmountWithPreference = ViewBag.TotalAmountWithPreference;
    var TotalFareAmount = Convert.ToDecimal(TotalAmountWithPreference + ((InfantTaxAmt * Convert.ToInt32(Model.FlightsList.Select(x => x.FlightFare.Infant).FirstOrDefault()))));
    Layout = null;

}

@{
    int k = 0; int summurycount = 0;
}
@foreach (var items in @Model.FlightsList)
