                    <!-- Price Breakdown Tab -->
                    <div class="tab-content" id="price1">
                        @{
                            var adultCount = Model.FlightsSearch.Adult;
                            var childCount = Model.FlightsSearch.Child;
                            var infantCount = Model.FlightsSearch.Infant;

                            var adultFare = items.FlightFare.AdultFare;
                            var childFare = items.FlightFare.ChildFare;
                            var infantFare = items.FlightFare.InfantFare;

                            var currency = items.Currency;

                            // Totals
                            var totalAdult = adultFare * adultCount;
                            var totalChild = childFare * childCount;
                            var totalInfant = infantFare * infantCount;

                            var grandTotal = totalAdult + totalChild + totalInfant;
                        }
                        <div class="price-breakdown">

                            <!-- Adult -->
                            <div class="pb-row">
                                <span>Base Fare (@adultCount Adult@(adultCount > 1 ? "s" : ""))</span>
                                <span class="pb-val">@* @currency *@$ @totalAdult</span>
                            </div>

                            <!-- Child (ONLY IF EXISTS) -->
                            @if (childCount > 0)
                            {
                                <div class="pb-row">
                                    <span>Base Fare (@childCount Child@(childCount > 1 ? "ren" : ""))</span>
                                    <span class="pb-val">@* @currency *@$ @totalChild</span>
                                </div>
                            }

                            <!-- Infant (ONLY IF EXISTS) -->
                            @if (infantCount > 0)
                            {
                                <div class="pb-row">
                                    <span>Base Fare (@infantCount Infant@(infantCount > 1 ? "s" : ""))</span>
                                    <span class="pb-val">@* @currency *@$ @totalInfant</span>
                                </div>
                            }

                            <!-- Static (if you want later you can bind from API) -->
                            <div class="pb-row">
                                <span>Carrier Surcharge</span>
                                <span class="pb-val">@* @currency *@$ 0</span>
                            </div>

                            <div class="pb-row">
                                <span>Booking Fee</span>
                                <span class="pb-val">@* @currency *@$ 0</span>
                            </div>

                            <!-- FINAL TOTAL -->
                            <div class="pb-row total">
                                <span>Total (@(adultCount + childCount + infantCount) Passenger@( (adultCount + childCount + infantCount) > 1 ? "s" : ""))</span>
                                <span class="pb-val">@* @currency *@$ @grandTotal</span>
                            </div>

                        </div>
                        <div style="margin-top:10px;font-size:.72rem;color:var(--text-muted);">Prices in USD, inclusive of all taxes. No hidden charges.</div>
                    </div>
                </div>
            </div>


