    /* =====================================================
       TAB SWITCHING (FIXED WITHOUT UNIQUE IDS)
    ===================================================== */
    function switchTab(tabEl, contentId) {
        try {
            const detailsPanel = tabEl.closest('.details-panel');
            if (!detailsPanel) return;

            // Remove active from all tabs
            const tabs = detailsPanel.querySelectorAll('.tab-link');
            const contents = detailsPanel.querySelectorAll('.tab-content');

            tabs.forEach(t => t.classList.remove('active'));
            contents.forEach(c => c.classList.remove('active'));

            // Activate clicked tab
            tabEl.classList.add('active');

            // Find index of clicked tab
            const tabArray = Array.from(tabs);
            const index = tabArray.indexOf(tabEl);

            // Activate matching content
            if (contents[index]) {
                contents[index].classList.add('active');
            }
        } catch (e) {
            console.error('switchTab error:', e);
        }
    }


    /* =====================================================
       OPTIONAL: ENSURE INITIAL STATE (HIDE ALL DETAILS)
    ===================================================== */
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.details-panel').forEach(p => {
            p.style.display = 'none';
            p.classList.remove('open');
        });
    });
</script>


