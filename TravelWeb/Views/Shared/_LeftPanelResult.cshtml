    <script>
                function toggleStop(el, val) {

            var checkbox = $('#stop_' + val);

            if (checkbox.prop('disabled')) return;

            checkbox.prop('checked', !checkbox.prop('checked'));

            $(el).toggleClass('active');

            $('#hdnPageIndex').val("0");

            filterResult();
        }

        $(document).on('change', '.stopscheckbox', function () {

            var val = $(this).val();

            if ($(this).is(':checked')) {
                $('[onclick="toggleStop(this,' + val + ')"]').addClass('active');
            } else {
                $('[onclick="toggleStop(this,' + val + ')"]').removeClass('active');
            }
        });
                $(document).ready(function () {

            $(".sidebar-select-btn").click(function (e) {
                e.preventDefault();

                var flight_id = $(this).data("id");

                var chkAdultmore = parseInt(localStorage.getItem("moreadultcount")) || 0;
                var chkChildmore = parseInt(localStorage.getItem("morechildcount")) || 0;

                var qsval = window.location.search.replace(/\?/g, '');
                var searchId = $("#SearchId").val();

                var url = "@(TravelWeb.Utilities.Common.WebSitePath + "details?")"
                    + qsval
                    + "&flightId=" + flight_id
                    + "&moreadultcount=" + chkAdultmore
                    + "&morechildcount=" + chkChildmore
                    + "&searchID=" + searchId;

                $("#loading").show();

                window.location.href = url;
            });

        });
    </script>


