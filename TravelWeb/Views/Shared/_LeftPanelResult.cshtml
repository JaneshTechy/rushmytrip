                function ClearAllFilters() {

            // ===== STOPS =====
            $('.stopscheckbox').prop('checked', false);
            $('.stop-option').removeClass('active');

            // ===== AIRLINES =====
            $('.chkAirlinelist').prop('checked', false);
            $('.airline-option').removeClass('checked');

            // ===== DEPARTURE TILES =====
            $('.time-tile').removeClass('on');
            $('#hdnDepartureSlots').val("");

            // ===== PRICE (RESET SLIDER DIRECTLY - NO FUNCTION CALL) =====
            var minprice = parseInt('@(Model.MinPrice)');
            var maxprice = parseInt('@(Model.MaxPrice)');
            var slider = document.getElementById('slider-range');

            if (slider && slider.noUiSlider) {
                slider.noUiSlider.set([minprice, maxprice]);
            }

            $("#hdnMinPrice").val(minprice);
            $("#hdnMaxPrice").val(maxprice);

            // ===== TIME SLIDERS =====
            if (document.getElementById('outboundDepature-slider-range')?.noUiSlider)
                document.getElementById('outboundDepature-slider-range').noUiSlider.set([0, 1440]);

            if (document.getElementById('outboundArrival-slider-range')?.noUiSlider)
                document.getElementById('outboundArrival-slider-range').noUiSlider.set([0, 1440]);

            if (document.getElementById('inboundDeparture-slider-range')?.noUiSlider)
                document.getElementById('inboundDeparture-slider-range').noUiSlider.set([0, 1440]);

            if (document.getElementById('inboundArrival-slider-range')?.noUiSlider)
                document.getElementById('inboundArrival-slider-range').noUiSlider.set([0, 1440]);

            // ===== HIDDEN FIELDS RESET =====
            $("#hdnoutboundDep").val("");
            $("#hdnoutboundArr").val("");
            $("#hdninboundDep").val("");
            $("#hdninboundArr").val("");

            // ===== SORT RESET =====
            $('#hdnSortResult').val("price");
            $('#hdnSorPrice').val("0");
            $('#hdnSortDuration').val("0");
            $('#hdnSorByAirlineName').val("0");

            // ===== PAGE RESET =====
            $('#hdnPageIndex').val("0");

            // ===== FINAL CALL =====
            filterResult();
        }
    </script>
