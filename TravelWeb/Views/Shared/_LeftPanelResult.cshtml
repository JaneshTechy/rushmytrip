            filterResult();
        }

                function SetPriceRange() {

            var min = parseInt($("#hdnMinPrice").val());
            var max = parseInt($("#hdnMaxPrice").val());

            var slider = document.getElementById('slider-range');

            noUiSlider.create(slider, {
                start: [min, max],
                connect: true,
                step: 1,
                behaviour: 'drag',
                range: {
                    'min': min,
                    'max': max
                }
            });

            // 🔥 LIVE UI UPDATE (while dragging)
            slider.noUiSlider.on('update', function (values) {

                var minVal = parseInt(values[0]);
                var maxVal = parseInt(values[1]);

                $("#minPriceLabel").text("$" + minVal.toLocaleString());
                $("#maxPriceLabel").text("$" + maxVal.toLocaleString());
                $("#priceDisplay").text("$" + minVal.toLocaleString() + " - $" + maxVal.toLocaleString());

            });

            // 🔥 APPLY FILTER (after release)
            slider.noUiSlider.on('change', function (values) {

                var minVal = parseInt(values[0]);
                var maxVal = parseInt(values[1]);

