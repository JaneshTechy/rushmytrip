        function toggleTile(el) {

            $(el).toggleClass("on");

            var selectedRanges = [];

            $(".time-tile.on").each(function () {

                var start = $(this).data("start");
                var end = $(this).data("end");

                selectedRanges.push(start + "-" + end); // ✅ FIXED
            });

            $("#hdnDepartureSlots").val(selectedRanges.join('|'));

            filterResult();
        }
                 function toggleAirline(el, code) {

            // Toggle UI class
            $(el).toggleClass('checked');

            // Toggle hidden checkbox (THIS IS KEY)
            var chk = $('#airline_' + code);
            chk.prop('checked', !chk.prop('checked'));

            // Trigger your existing filter
            filterResult();
        }

        function setSliderTime(jurtime) {
            var jurval = jurtime.split(":")
            var hours1 = Math.floor(jurval[0] / 60);
            var minutes1 = jurval[0] - (hours1 * 60);

            if (hours1 < 10) hours1 = '0' + hours1;
            if (minutes1 < 10) minutes1 = '0' + minutes1;

            if (minutes1 == 0) minutes1 = '00';

            var hours2 = Math.floor(jurval[1] / 60);
            var minutes2 = jurval[1] - (hours2 * 60);

            if (hours2 < 10) hours2 = '0' + hours2;
            if (minutes2 < 10) minutes2 = '0' + minutes2;

            if (minutes2 == 0) minutes2 = '00';
            var rvalue = hours1 + ':' + minutes1 + '-' + hours2 + ':' + minutes2;
            return rvalue;
        }
        function ResetPriceSlider() {
            var minprice = parseInt('@(Model.MinPrice)');
            var maxprice = parseInt('@(Model.MaxPrice)');

            var slider = document.getElementById('slider-range');

            slider.noUiSlider.set([minprice, maxprice]);

            $("#hdnMinPrice").val(minprice);
            $("#hdnMaxPrice").val(maxprice);

            filterResult();
        }

        function ResetOutDep() {
            var outboundDepature_slider_range = document.getElementById('outboundDepature-slider-range');
            var outDepVal = '@(Model.OutBoundDep)';
            outboundDepature_slider_range.noUiSlider.set([parseInt(outDepVal.split(':')[0]), parseInt(outDepVal.split(':')[1])]);
            filterResult();
        }
        function ResetOutArr() {
            var outboundArrival_slider_range = document.getElementById('outboundArrival-slider-range');
            var outArrVal = '@(Model.OutBoundArr)';
            outboundArrival_slider_range.noUiSlider.set([parseInt(outArrVal.split(':')[0]), parseInt(outArrVal.split(':')[1])]);
